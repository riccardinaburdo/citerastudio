---
export const prerender = false;

import { getProject, listProjects } from '../../lib/store';

const role = Astro.locals.role;
const allProjects = await listProjects();
const clientProjects = (allProjects as any[]).filter((p: any) => !p.template);

// If no ?p= param, redirect to the first non-template project
const rawId = Astro.url.searchParams.get('p');
if (!rawId) {
  const first = clientProjects[0] ?? allProjects[0];
  if (first) return Astro.redirect(`/area-riservata/portal?p=${first.id}`);
}

const projectId = rawId ?? 'default';
const projectData = await getProject(projectId);

// Block clients from accessing template projects
if (role === 'client' && (projectData.info as any).template) {
  const first = clientProjects[0];
  return Astro.redirect(first ? `/area-riservata/portal?p=${first.id}` : '/area-riservata/portal');
}
const { info: project, contractors, technicians: rawTechnicians, categories: rawCategories } = projectData;
const technicians = rawTechnicians ?? [];
const updates = (projectData.updates ?? []).slice().sort((a, b) => b.num - a.num);

const enrich = (item: any) => {
  const qty           = item.extra ? 0 : (item.qty ?? 0);
  const price         = item.price ?? 0;
  const variationQty  = item.variation ?? 0;
  const budget        = item.extra ? 0 : qty * price;
  const variationAmt  = variationQty * price;
  const revisedBudget = item.extra ? variationAmt : (qty + variationQty) * price;
  const rawDone       = (item.done ?? 0) * price;
  const agreedQty     = item.extra ? variationQty : (qty + variationQty);
  const overrun       = revisedBudget > 0 && (item.done ?? 0) > agreedQty;
  const forceComplete = !!item.complete && !overrun;
  const valueDone     = forceComplete ? revisedBudget : rawDone;
  const perc          = revisedBudget > 0 ? (rawDone / revisedBudget) * 100 : null;
  return { ...item, qty, budget, variationQty, variationAmt, revisedBudget, valueDone, perc, overrun, forceComplete };
};
const enrichedCats = rawCategories.map((cat: any) => {
  const items        = cat.items.map(enrich);
  const catBudget    = items.filter((i: any) => !i.extra).reduce((s: number, i: any) => s + i.budget, 0);
  const catRevised   = items.reduce((s: number, i: any) => s + i.revisedBudget, 0);
  const catVariation = catRevised - catBudget;
  const catDone      = items.reduce((s: number, i: any) => s + i.valueDone, 0);
  const catPerc      = catRevised > 0 ? (catDone / catRevised) * 100 : 0;
  return { ...cat, items, catBudget, catRevised, catVariation, catDone, catPerc };
});
const totalOriginal  = enrichedCats.reduce((s: number, c: any) => s + c.catBudget,   0);
const totalRevised   = enrichedCats.reduce((s: number, c: any) => s + c.catRevised,  0);
const totalVariation = totalRevised - totalOriginal;
const totalDone      = enrichedCats.reduce((s: number, c: any) => s + c.catDone,     0);
const totalPerc      = totalRevised > 0 ? (totalDone / totalRevised) * 100 : 0;
const totalLeft      = totalRevised - totalDone;


// Per-contractor payment schedules (uses each contractor's sal milestones and their own budget)
const contractorSchedules = contractors.flatMap(c => {
  const allItems = enrichedCats.flatMap(cat => cat.items).filter(i => i.contractor === c.id && !i.extra);
  const cBudget  = allItems.reduce((s, i) => s + i.revisedBudget, 0);
  if (cBudget === 0 || !c.sal || c.sal.length === 0) return [];
  const cDone    = allItems.reduce((s, i) => s + i.valueDone, 0);
  const cPerc    = (cDone / cBudget) * 100;
  let nextFoundC = false;
  let cumPct = 0;
  let cumTriggerPct = 0; // separate accumulator for work-progress trigger axis

  // Separate milestones into quantified (have an amount) and unquantified date ones
  const quantified   = c.sal.filter(m => m.pct > 0 || ((m as any).fixedAmt ?? 0) > 0);
  const unquantified = c.sal.filter(m => m.pct === 0 && !((m as any).fixedAmt) && m.triggerType === 'date');

  const milestones = quantified.map(m => {
    cumPct += m.pct;
    const tickPos  = Math.min(cumPct, 100);
    const amount   = cBudget > 0 ? (m.pct / 100) * cBudget : ((m as any).fixedAmt ?? 0);
    // triggerAt (bar position) = tickPos for pct milestones
    // workTriggerAt (isDue check) uses cumTriggerPct so pct ≠ triggerPct doesn't cause false dues
    let triggerAt: number;
    let workTriggerAt: number;
    if      (m.triggerType === 'signing') { triggerAt = 0;       workTriggerAt = 0; }
    else if (m.triggerType === 'start')   { triggerAt = 0;       workTriggerAt = 0; }
    else if (m.triggerType === 'final')   { triggerAt = 100;     workTriggerAt = 100; }
    else if (m.triggerType === 'date')    { triggerAt = -1;      workTriggerAt = -1; }
    else { triggerAt = tickPos; cumTriggerPct += (m.triggerPct ?? 0); workTriggerAt = cumTriggerPct; }
    const triggerNote = m.triggerType === 'signing' ? 'On contract signing'
                      : m.triggerType === 'start'   ? 'At start of works'
                      : m.triggerType === 'final'   ? 'On practical completion'
                      : m.triggerType === 'date'    ? `On ${m.triggerDate ?? '—'}`
                      : `At ${workTriggerAt}% completion`;
    const dateDue     = m.triggerType === 'date' && m.triggerDate ? new Date(m.triggerDate) : null;
    const dateExpired = dateDue ? dateDue <= new Date() : false;
    let status: 'paid' | 'next' | 'pending';
    let isDue = false;
    if (m.paid === true) {
      status = 'paid';
    } else if (m.triggerType === 'date') {
      if (dateExpired)        { status = 'paid'; }
      else if (!nextFoundC)   { status = 'next'; nextFoundC = true; isDue = false; }
      else                    { status = 'pending'; }
    } else {
      // pct / signing / final: never auto-paid — only m.paid===true certifies payment
      if (!nextFoundC) {
        status = 'next'; nextFoundC = true;
        isDue = m.triggerType === 'signing' || (m.triggerType === 'start' && cPerc > 0) || (workTriggerAt > 0 && cPerc >= workTriggerAt);
      } else { status = 'pending'; }
    }
    return { ...m, amount, triggerAt, workTriggerAt, triggerNote, status, isDue, tickPos };
  });

  // Collapsed "Remaining" block for unquantified date milestones
  const remainingPct = Math.max(0, 100 - cumPct);
  if (unquantified.length > 0 && remainingPct > 0.01) {
    const remStatus = nextFoundC ? 'pending' : 'next';
    if (!nextFoundC && remStatus === 'next') nextFoundC = true;
    milestones.push({
      id: '…', label: `Remaining (${unquantified.length} milestone${unquantified.length > 1 ? 's' : ''})`,
      triggerType: 'date', triggerPct: null, triggerDate: null,
      pct: remainingPct, amount: (remainingPct / 100) * cBudget,
      triggerAt: -1, triggerNote: 'To be quantified', status: remStatus as any, tickPos: 100,
    } as any);
  }

  const paidC      = milestones.filter(m => m.status === 'paid').reduce((s, m) => s + m.amount, 0);
  const paidPct    = milestones.filter(m => m.status === 'paid').reduce((s, m) => s + m.pct,    0);
  const nextC      = milestones.find(m => m.status === 'next') ?? null;
  const remainingC = cBudget - paidC - (nextC?.amount ?? 0);
  const pendingC   = remainingC; // kept for template compatibility

  // Last paid milestone → replaces "now" on the bar
  const lastPaid     = [...milestones].filter(m => m.status === 'paid').slice(-1)[0] ?? null;
  const lastPaidDate = lastPaid ? ((lastPaid as any).paidDate ?? (lastPaid as any).triggerDate ?? null) : null;
  const lastPaidPos  = lastPaid?.tickPos ?? 0;
  return [{ c, cBudget, cPerc, milestones, paidC, paidPct, nextC, pendingC, lastPaidDate, lastPaidPos }];
});

// Per-technician payment schedules — triggered by OVERALL project progress (totalPerc)
const technicianSchedules = technicians.flatMap((t: any) => {
  if (!t.fee || !t.sal || t.sal.length === 0) return [];
  let nextFoundT = false;
  let cumPctT = 0;

  const quantified = t.sal.filter((m: any) => m.pct > 0 || ((m as any).fixedAmt ?? 0) > 0);

  const milestones = quantified.map((m: any) => {
    cumPctT += m.pct;
    const tickPos = cumPctT;
    const amount  = t.fee > 0 ? t.fee * m.pct / 100 : ((m.fixedAmt ?? 0) as number);

    let triggerAt: number;
    if      (m.triggerType === 'signing') { triggerAt = 0; }
    else if (m.triggerType === 'start')   { triggerAt = 0; }
    else if (m.triggerType === 'final')   { triggerAt = 100; }
    else if (m.triggerType === 'date')    { triggerAt = -1; }
    else { triggerAt = tickPos; }

    const triggerNote = m.triggerType === 'signing' ? 'On contract signing'
                      : m.triggerType === 'start'   ? 'At start of works'
                      : m.triggerType === 'final'   ? 'On practical completion'
                      : m.triggerType === 'date'    ? `On ${m.triggerDate ?? '—'}`
                      : `At ${triggerAt}% overall works`;

    const dateDue     = m.triggerType === 'date' && m.triggerDate ? new Date(m.triggerDate) : null;
    const dateExpired = dateDue ? dateDue <= new Date() : false;
    let status: 'paid' | 'next' | 'pending';
    let isDue = false;

    if (m.paid === true) {
      status = 'paid';
    } else if (m.triggerType === 'date') {
      if (dateExpired)      { status = 'paid'; }
      else if (!nextFoundT) { status = 'next'; nextFoundT = true; isDue = false; }
      else                  { status = 'pending'; }
    } else {
      if (!nextFoundT) {
        status = 'next'; nextFoundT = true;
        isDue = m.triggerType === 'signing'
             || m.triggerType === 'start'
             || (m.triggerType === 'final' && totalPerc >= 100)
             || (m.triggerType === 'percent' && totalPerc >= (m.triggerPct ?? 0));
      } else { status = 'pending'; }
    }
    return { ...m, amount, triggerAt, triggerNote, status, isDue, tickPos };
  });

  const paidT    = milestones.filter((m: any) => m.status === 'paid').reduce((s: number, m: any) => s + m.amount, 0);
  const paidPctT = milestones.filter((m: any) => m.status === 'paid').reduce((s: number, m: any) => s + m.pct,    0);
  const nextT    = milestones.find((m: any) => m.status === 'next') ?? null;
  const pendingT = milestones.filter((m: any) => m.status !== 'paid').slice(1).reduce((s: number, m: any) => s + m.amount, 0);
  const lastPaidT     = [...milestones].filter((m: any) => m.status === 'paid').slice(-1)[0] ?? null;
  const lastPaidDateT = lastPaidT ? (lastPaidT.paidDate ?? lastPaidT.triggerDate ?? null) : null;
  return [{ t, tFee: t.fee, milestones, paidT, paidPctT, nextT, pendingT, lastPaidDateT }];
});

const fmt = (n: number) => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtQ    = (n: number, unit: string) => unit === 'lump' ? (n === 0 ? '–' : '✓') : n.toLocaleString('en-GB');
const fmtQty  = (n: number, unit: string) => unit === 'lump' ? '1' : n.toLocaleString('en-GB');
// True when variation has zeroed out the contracted budget
const isNotExecuted = (item: any) => !item.extra && item.budget > 0 && !(item.revisedBudget > 0);

const statusLabel = (itemOrPerc: any) => {
  if (typeof itemOrPerc === 'number' || itemOrPerc === null) {
    const p = itemOrPerc as number | null;
    return p === null ? '–' : p > 99.9 ? 'Complete' : p > 0 ? 'In Progress' : 'Not Started';
  }
  const item = itemOrPerc;
  if (item.overrun) return 'Overrun';
  if (isNotExecuted(item)) return 'Not Executed';
  if (item.perc === null) return '–';
  if (item.forceComplete || item.perc > 99.9) return 'Complete';
  if (item.perc > 0) return 'In Progress';
  return 'Not Started';
};
const statusClass = (p: number | null, item?: any) => {
  if (item && item.overrun) return 'overrun';
  if (item && isNotExecuted(item)) return 'not-executed';
  if (item && item.forceComplete) return 'complete';
  if (item && item.perc === null) return 'pending';
  return p === null ? 'pending' : p > 99.9 ? 'complete' : p > 0 ? 'progress' : 'pending';
};
const catColor = (p: number) => p > 99.9 ? '#22c55e' : p > 74.9 ? '#FB8503' : p > 0 ? '#f59e0b' : '#cbd5e1';
// Done-qty cell colour: neutral for not-executed items, normal otherwise
const doneColor   = (item: any) => {
  if (item.overrun) return '#dc2626';
  if (isNotExecuted(item)) return 'var(--navy)';
  return catColor(item.perc);
};

const fmtDate = (d: string) => {
  try {
    return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch { return d; }
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Project Portal — {project.name} | CiteraStudio</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:   #1a3a5c; --orange: #FB8503; --green: #22c55e;
      --amber:  #f59e0b; --slate:  #64748b;
      --grey-1: #f8fafc; --grey-2: #e2e8f0; --grey-3: #94a3b8;
      --text:   #1e293b; --sans:   'Inter', sans-serif; --brand: 'Quicksand', sans-serif;
      --radius: 10px;
    }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); color: var(--text); background: var(--grey-1); font-size: 14px; }
    .topbar { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; gap: 1rem; background: var(--navy); color: #fff; padding: .6rem 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,.25); }
    .topbar-brand   { font-family: var(--brand); font-weight: 700; font-size: 1rem; color: var(--orange); flex-shrink: 0; }
    .topbar-sep     { color: rgba(255,255,255,.25); }
    .topbar-project { font-size: 0.82rem; color: rgba(255,255,255,.8); flex: 1; }
    .topbar-project-select { background: transparent; border: 1px solid rgba(255,255,255,.25); border-radius: 6px; color: rgba(255,255,255,.9); font-size: 0.82rem; font-family: inherit; padding: .2rem .5rem; cursor: pointer; flex: 1; max-width: 320px; }
    .topbar-project-select option { background: #1a3a5c; color: #fff; }
    .topbar-lock { display: flex; align-items: center; gap: .4rem; font-size: 0.72rem; color: rgba(255,255,255,.5); border: 1px solid rgba(255,255,255,.2); border-radius: 20px; padding: .25rem .7rem; flex-shrink: 0; }
    .topbar-lock .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); flex-shrink: 0; }
    .role-badge { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; padding: .2rem .6rem; border-radius: 20px; flex-shrink: 0; }
    .role-badge.client { background: rgba(255,255,255,.12); color: rgba(255,255,255,.7); }
    .role-badge.admin  { background: var(--orange); color: #fff; }
    .btn-top { padding: .3rem .9rem; border: 1px solid rgba(255,255,255,.3); background: transparent; color: #fff; border-radius: 5px; font-size: 0.75rem; cursor: pointer; transition: background .2s; flex-shrink: 0; text-decoration: none; }
    .btn-top:hover { background: rgba(255,255,255,.12); }
    .btn-logout { padding: .3rem .9rem; border: 1px solid rgba(255,80,80,.4); background: transparent; color: rgba(255,150,150,.9); border-radius: 5px; font-size: 0.75rem; cursor: pointer; transition: background .2s; flex-shrink: 0; }
    .btn-logout:hover { background: rgba(255,80,80,.15); }
    .hero { background: linear-gradient(135deg, var(--navy) 0%, #2d5a8e 100%); color: #fff; padding: 2.5rem 2rem 2rem; }
    .hero-inner { max-width: 1400px; margin: 0 auto; }
    .hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .hero-title { font-family: var(--brand); font-size: 1.8rem; font-weight: 700; color: #fff; line-height: 1.2; }
    .hero-sub   { font-size: 0.85rem; color: rgba(255,255,255,.6); margin-top: .3rem; }
    .hero-meta  { display: grid; grid-template-columns: repeat(2,1fr); gap: .4rem .8rem; font-size: 0.75rem; }
    .hero-meta dt { color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .06em; font-size: 0.62rem; }
    .hero-meta dd { color: rgba(255,255,255,.85); font-weight: 500; }
    .update-badge { margin-top: 1.5rem; display: inline-flex; align-items: center; gap: .5rem; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 20px; padding: .35rem 1rem; font-size: 0.75rem; color: rgba(255,255,255,.8); }
    .update-badge .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:.3; } }
    .main { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .metrics { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-bottom: 2rem; }
    .metric-card { background: #fff; border-radius: var(--radius); padding: 1.2rem 1.5rem; border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); }
    .metric-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: .08em; color: var(--grey-3); font-weight: 600; margin-bottom: .5rem; }
    .metric-value { font-size: 1.6rem; font-weight: 700; color: var(--navy); line-height: 1; }
    .metric-sub   { font-size: 0.75rem; color: var(--slate); margin-top: .3rem; }
    .metric-card.highlight .metric-value { color: var(--orange); }
    .payment-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: 1.5rem; margin-bottom: 1.5rem; overflow: hidden; }
    .pay-contractor-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; padding-bottom: .75rem; border-bottom: 1px solid var(--grey-2); }
    .pay-contractor-name  { font-family: var(--brand); font-size: 1rem; font-weight: 700; color: var(--navy); margin-right: .6rem; }
    .pay-contractor-trade { font-size: 0.72rem; color: var(--slate); text-transform: uppercase; letter-spacing: .06em; }
    .pay-contractor-stats { font-size: 0.75rem; color: var(--slate); }
    .pay-summary { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: 0; margin-bottom: 1.6rem; }
    .pay-sum-item { padding: 1.1rem 1.4rem; border-radius: var(--radius); }
    .pay-sum-item.paid     { background: #f0fdf4; border: 1px solid #bbf7d0; }
    .pay-sum-item.next     { background: #fff7ed; border: 2px solid var(--orange); box-shadow: 0 4px 20px rgba(251,133,3,.18); }
    .pay-sum-item.upcoming { background: #f8fafc; border: 1px solid var(--grey-2); }
    .pay-sum-item.pending  { background: #f8fafc; border: 1px solid var(--grey-2); }
    .pay-sum-arrow { display: flex; align-items: center; padding: 0 .5rem; color: var(--grey-3); font-size: 1.1rem; }
    .pay-sum-label { font-size: 0.63rem; text-transform: uppercase; letter-spacing: .08em; color: var(--grey-3); font-weight: 700; margin-bottom: .5rem; }
    .pay-sum-item.next .pay-sum-label { color: var(--orange); }
    .pay-sum-amount { font-size: 1.55rem; font-weight: 700; line-height: 1; margin-bottom: .3rem; }
    .pay-sum-item.paid     .pay-sum-amount { color: #16a34a; }
    .pay-sum-item.next     .pay-sum-amount { color: var(--orange); }
    .pay-sum-item.upcoming .pay-sum-amount { color: var(--slate); }
    .pay-sum-item.pending  .pay-sum-amount { color: var(--slate); }
    .pay-sum-sub { font-size: 0.72rem; color: var(--slate); line-height: 1.5; }
    .pay-sum-trigger { display: inline-block; margin-top: .6rem; font-size: 0.72rem; font-weight: 600; color: var(--orange); background: rgba(251,133,3,.1); border-radius: 4px; padding: .2rem .5rem; }
    .pay-sum-item.upcoming .pay-sum-trigger { color: var(--slate); background: var(--grey-2); }
    .pay-sum-paid-note { display: inline-block; margin-top: .4rem; font-size: 0.68rem; color: #16a34a; font-weight: 600; }
    .pay-timeline-wrap { position: relative; margin: 0 .5rem 1.5rem; overflow: visible; }
    .pay-bars-legend { display: flex; gap: 1.4rem; margin: 0 1rem .6rem; }
    .pay-bars-legend-item { display: flex; align-items: center; gap: .4rem; font-size: 0.62rem; color: var(--slate); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
    .pay-bars-legend-swatch { width: 22px; height: 6px; border-radius: 3px; }
    .pay-bars-legend-swatch.work { background: linear-gradient(to right, #4f46e5, #818cf8); }
    .pay-bars-legend-swatch.pay  { background: linear-gradient(to right, #16a34a, #22c55e); }
    .pay-work-track { position: relative; height: 8px; background: var(--grey-2); border-radius: 4px; margin: 0 1rem .55rem; overflow: hidden; }
    .pay-work-fill { position: absolute; left: 0; top: 0; height: 100%; background: linear-gradient(to right, #4f46e5, #818cf8); border-radius: 4px; }
    .pay-track-spacer { height: 44px; }
    .pay-track { position: relative; height: 8px; background: var(--grey-2); border-radius: 4px; margin: 0 1rem; overflow: visible; }
    .pay-track-fill { position: absolute; left: 0; top: 0; height: 100%; background: linear-gradient(to right, #16a34a, #22c55e); border-radius: 4px; }
    .pay-tick { position: absolute; top: 50%; transform: translate(-50%,-50%); z-index: 4; }
    .pay-tick-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #fff; }
    .pay-tick.paid .pay-tick-dot  { background: #22c55e; box-shadow: 0 0 0 1.5px #16a34a; }
    .pay-tick.next .pay-tick-dot  { background: var(--orange); border-color: var(--orange); box-shadow: 0 0 0 3px rgba(251,133,3,.25); width: 16px; height: 16px; animation: pulse-tick 2s infinite; }
    .pay-tick.pending .pay-tick-dot { background: var(--grey-2); box-shadow: 0 0 0 1.5px var(--grey-3); }
    @keyframes pulse-tick { 0%,100% { box-shadow: 0 0 0 3px rgba(251,133,3,.25); } 50% { box-shadow: 0 0 0 6px rgba(251,133,3,.12); } }
    .pay-tick-lbl { position: absolute; top: 13px; left: 50%; transform: translateX(-50%); font-size: 0.58rem; text-align: center; white-space: nowrap; line-height: 1.4; color: var(--slate); }
    .pay-tick.paid .pay-tick-lbl  { color: #16a34a; font-weight: 600; }
    .pay-tick.next .pay-tick-lbl  { color: var(--orange); font-weight: 700; }
    .pay-tick-id { position: absolute; bottom: 13px; left: 50%; transform: translateX(-50%); font-size: 0.6rem; font-weight: 700; white-space: nowrap; color: var(--slate); font-family: monospace; }
    .pay-tick.paid .pay-tick-id   { color: #16a34a; }
    .pay-tick.next .pay-tick-id   { color: var(--orange); }
    .pay-now { position: absolute; top: 50%; transform: translate(-50%,-50%); z-index: 3; }
    .pay-now-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--navy); border: 2px solid #fff; box-shadow: 0 0 0 2px var(--navy); }
    .pay-now-lbl { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); font-size: 0.6rem; font-weight: 700; white-space: nowrap; background: var(--navy); color: #fff; padding: .15rem .4rem; border-radius: 3px; }
    .pay-now-lbl::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); border: 3px solid transparent; border-top-color: var(--navy); }
    .pay-now-line { position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%); width: 1.5px; height: 12px; background: var(--navy); opacity: .4; }
    .pay-track-labels { margin: 0 1rem; padding-top: 2.5rem; display: flex; justify-content: space-between; }
    .pay-track-edge { font-size: 0.6rem; color: var(--grey-3); }
    .pay-table-wrap { border-top: 1px solid var(--grey-2); padding-top: 1rem; overflow-x: auto; }
    table.pay-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; min-width: 500px; }
    table.pay-table th { font-size: 0.62rem; text-transform: uppercase; letter-spacing: .06em; color: var(--grey-3); font-weight: 600; padding: .4rem .75rem; border-bottom: 1px solid var(--grey-2); text-align: left; }
    table.pay-table th.right { text-align: right; }
    table.pay-table td { padding: .55rem .75rem; border-bottom: 1px solid var(--grey-2); vertical-align: middle; }
    table.pay-table tr:last-child td { border-bottom: none; }
    table.pay-table tr.pay-row-paid td { background: #f0fdf4; }
    table.pay-table tr.pay-row-next td { background: #fff7ed; }
    .pay-col-id { font-size: 0.68rem; font-weight: 700; font-family: monospace; color: var(--navy); white-space: nowrap; }
    .pay-col-label { font-weight: 500; }
    .pay-col-trigger { font-size: 0.72rem; color: var(--slate); }
    .pay-col-money { text-align: right; font-family: monospace; font-size: 0.75rem; white-space: nowrap; }
    .pay-col-gross { text-align: right; font-family: monospace; font-size: 0.78rem; font-weight: 700; color: var(--navy); white-space: nowrap; }
    .pay-badge { display: inline-block; font-size: 0.62rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: .2rem .65rem; border-radius: 20px; white-space: nowrap; }
    .pay-badge.paid    { background: #dcfce7; color: #15803d; }
    .pay-badge.next    { background: #fff7ed; color: #c2410c; border: 1px solid #fb923c; }
    .pay-badge.pending { background: #f1f5f9; color: #94a3b8; }
    tr.pay-row-next .pay-col-label { font-weight: 700; color: var(--orange); }
    tr.pay-row-next .pay-col-gross { color: var(--orange); }
    .overview { display: none; }
    .progress-overview { display: grid; grid-template-columns: 260px 1fr; gap: 2rem; align-items: start; margin-bottom: 2rem; }
    .progress-overview > .donut-card { width: 260px; flex-shrink: 0; }
    .donut-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1.5rem; text-align: center; }
    .donut-wrap { position: relative; width: 160px; height: 160px; margin-bottom: 1.2rem; }
    .donut-ring { width: 160px; height: 160px; border-radius: 50%; background: conic-gradient(var(--orange) 0% var(--p,0%), var(--grey-2) var(--p,0%) 100%); }
    .donut-inner { position: absolute; inset: 20px; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .donut-pct  { font-size: 1.8rem; font-weight: 700; color: var(--navy); line-height: 1; }
    .donut-lbl  { font-size: 0.65rem; text-transform: uppercase; letter-spacing: .06em; color: var(--grey-3); margin-top: .15rem; }
    .donut-title{ font-size: 0.8rem; font-weight: 600; color: var(--navy); }
    .donut-sub  { font-size: 0.72rem; color: var(--slate); margin-top: .3rem; }
    .cat-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: 1.5rem; }
    .cat-card-title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--grey-3); font-weight: 600; margin-bottom: 1.2rem; }
    .cat-bar-row { display: flex; align-items: center; gap: 1rem; margin-bottom: .85rem; }
    .cat-bar-row:last-child { margin-bottom: 0; }
    .cat-bar-id    { font-size: 0.7rem; font-weight: 700; color: var(--navy); width: 20px; flex-shrink: 0; }
    .cat-bar-label { font-size: 0.78rem; color: var(--text); flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cat-bar-track { width: 160px; height: 8px; background: var(--grey-2); border-radius: 4px; flex-shrink: 0; overflow: hidden; }
    .cat-bar-fill  { height: 100%; border-radius: 4px; }
    .cat-bar-pct   { font-size: 0.72rem; font-weight: 600; width: 38px; text-align: right; flex-shrink: 0; }
    .cat-status    { font-size: 0.62rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: .15rem .5rem; border-radius: 10px; flex-shrink: 0; width: 80px; text-align: center; }
    .cat-status.complete { background: #dcfce7; color: #16a34a; }
    .cat-status.progress { background: #fff7ed; color: #c2410c; }
    .cat-status.pending  { background: #f1f5f9; color: var(--grey-3); }
    .section-title { font-size: 1rem; text-transform: uppercase; letter-spacing: .12em; color: #fff; font-weight: 700; margin-bottom: 1.5rem; margin-top: .5rem; padding: .75rem 1.25rem; background: var(--orange); border-radius: 6px; }
    .works-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 2rem; }
    .works-scroll { overflow-x: auto; }
    table.works { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
    table.works thead th,
    tr.works-thead-repeat th { background: var(--navy); color: rgba(255,255,255,.85); padding: .55rem .75rem; text-align: left; font-size: 0.65rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; overflow: hidden; }
    table.works thead th.right,
    tr.works-thead-repeat th.right { text-align: right; }
    tr.works-cat td { background: #f0f6ff; color: var(--navy); padding: .4rem .75rem; font-weight: 700; font-size: 0.72rem; border-top: 2px solid var(--grey-2); border-bottom: 1px solid #c7d9f0; cursor: pointer; user-select: none; }
    tr.works-cat td:hover { background: #e4eeff; }
    tr.works-cat .cat-letter { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 0.65rem; font-weight: 700; margin-right: .5rem; }
    tr.works-cat .cat-chevron { display: inline-block; margin-left: .4rem; font-size: .7rem; transition: transform .2s; vertical-align: middle; }
    tr.works-cat.collapsed .cat-chevron { transform: rotate(-90deg); }
    tr.works-cat.collapsed + * { /* handled by JS */ }
    [data-cat-member].cat-hidden { display: none; }
    table.works tbody tr.item td { padding: .45rem .75rem; border-bottom: 1px solid var(--grey-2); vertical-align: middle; font-weight: 400; }
    table.works tbody tr.item:last-child td { border-bottom: none; }
    table.works tbody tr.item:hover td { background: #f8fafc; }
    .item-id    { color: var(--grey-3); font-size: 0.68rem; font-family: monospace; white-space: nowrap; }
    .item-desc  { min-width: 160px; line-height: 1.4; }
    .item-num   { text-align: right; white-space: nowrap; }
    .item-money { text-align: right; font-family: monospace; font-size: 0.75rem; white-space: nowrap; }
    .item-done-qty { text-align: right; font-size: 0.78rem; }
    .brief-trigger { cursor: pointer; text-decoration: underline dotted; text-underline-offset: 3px; color: inherit; }
    .brief-trigger:hover { color: var(--navy); }
    #desc-dialog { border: none; border-radius: 12px; padding: 0; max-width: 560px; width: 90vw; box-shadow: 0 8px 40px rgba(0,0,0,.18); }
    #desc-dialog::backdrop { background: rgba(15,23,42,.35); backdrop-filter: blur(2px); }
    .desc-dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.4rem .8rem; border-bottom: 1px solid var(--grey-2); }
    .desc-dialog-id { font-size: .65rem; font-family: monospace; font-weight: 700; color: var(--navy); background: #e8eef8; border-radius: 4px; padding: .15rem .45rem; flex-shrink: 0; }
    .desc-dialog-brief { font-size: .88rem; font-weight: 600; color: var(--navy); flex: 1; line-height: 1.35; }
    .desc-dialog-close { background: none; border: none; cursor: pointer; color: var(--grey-3); font-size: 1.1rem; line-height: 1; padding: .1rem; flex-shrink: 0; }
    .desc-dialog-close:hover { color: var(--navy); }
    .desc-dialog-body { padding: 1.2rem 1.4rem 1.4rem; font-size: .84rem; color: var(--text); line-height: 1.65; white-space: pre-wrap; max-height: 60vh; overflow-y: auto; }
    .desc-dialog-empty { color: var(--grey-3); font-style: italic; font-size: .8rem; }
    .perc-cell { min-width: 90px; }
    .perc-wrap { display: flex; align-items: center; gap: .4rem; }
    .perc-mini { flex: 1; height: 5px; background: var(--grey-2); border-radius: 3px; overflow: hidden; }
    .perc-mini-fill { height: 100%; border-radius: 3px; }
    .perc-num  { font-size: 0.72rem; font-weight: 400; width: 35px; text-align: right; white-space: nowrap; }
    .badge { display: inline-block; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: .2rem .6rem; border-radius: 20px; white-space: nowrap; }
    .badge.complete     { background: #dcfce7; color: #15803d; }
    .badge.progress     { background: #fff7ed; color: #c2410c; }
    .badge.pending      { background: #f1f5f9; color: #94a3b8; }
    .badge.overrun      { background: transparent; color: #dc2626; }
    .badge.extra        { background: #fef3c7; color: #92400e; }
    .badge.not-executed { background: #f1f5f9; color: #475569; }
    tr.item.extra-item td { background: #fffdf5; }
    tr.item.extra-item:hover td { background: #fef9e7; }
    .extra-badge { display: inline-block; font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; padding: .12rem .4rem; border-radius: 3px; background: #f59e0b; color: #fff; margin-right: .35rem; vertical-align: middle; line-height: 1.6; }
    .overrun-num { color: #dc2626; font-weight: 700; }
    tr.subtotal td { background: #e2e8f0; padding: .4rem .75rem; font-size: 0.72rem; font-weight: 600; color: var(--navy); border-top: 2px solid #c7d9f0; border-bottom: 2px solid #c7d9f0; }
    tr.subtotal .sub-label { color: var(--slate); font-weight: 400; }
    tr.grand-total td { background: var(--navy); color: #fff; padding: .6rem .75rem; font-weight: 700; font-size: 0.8rem; }
    .updates-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-bottom: 2rem; }
    .update-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--grey-2); box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: 1.2rem; border-left: 4px solid var(--orange); }
    .update-card.latest { border-left-color: var(--green); }
    .update-num  { font-size: 0.65rem; text-transform: uppercase; letter-spacing: .07em; color: var(--grey-3); font-weight: 600; }
    .update-date { font-size: 0.88rem; font-weight: 700; color: var(--navy); margin: .25rem 0; }
    .update-pct  { font-size: 1.4rem; font-weight: 700; color: var(--orange); line-height: 1; }
    .update-pct span { font-size: 0.72rem; color: var(--grey-3); font-weight: 400; }
    .update-note { font-size: 0.75rem; color: var(--slate); margin-top: .6rem; line-height: 1.5; }
    .update-card.latest .update-pct { color: var(--green); }
    .page-footer { background: var(--navy); color: rgba(255,255,255,.6); text-align: center; padding: 1.2rem; font-size: 0.72rem; margin-top: 2rem; }
    .page-footer strong { color: var(--orange); }
    @media print { .topbar, .btn-top, .btn-logout { display: none; } body { background: #fff; } .main { padding: .5rem; } }
    @media (max-width: 900px) { .cat-bar-track { width: 100px; } }
    @media (max-width: 900px) { .metrics { grid-template-columns: repeat(2,1fr); } .updates-grid { grid-template-columns: 1fr; } .hero-top { flex-direction: column; } .pay-summary { grid-template-columns: 1fr; } .pay-sum-arrow { display: none; } .pay-timeline-wrap { display: none; } }
    @media (max-width: 600px) { .metrics { grid-template-columns: 1fr; } .topbar-project { display: none; } .main { padding: .75rem; } }
    @media (max-width: 768px) {
      /* Topbar */
      .topbar { padding: .45rem .75rem; gap: .4rem; flex-wrap: wrap; }
      .topbar-lock, .btn-top, .btn-logout { font-size: .62rem; padding: .2rem .5rem; }
      .role-badge { font-size: .58rem; }
      .topbar-project-select { max-width: 160px; font-size: .72rem; }
      .topbar-sep { display: none; }

      /* Hero */
      .hero { padding: 1.2rem .85rem 1rem; }
      .hero-title { font-size: 1.2rem !important; }
      .hero-sub { font-size: .8rem !important; }
      .hero-meta { font-size: .75rem !important; gap: .25rem .75rem !important; }
      .update-badge { font-size: .65rem !important; }

      /* Metrics */
      .metric-card { padding: .85rem 1rem; }
      .metric-value { font-size: 1.55rem !important; }
      .metric-label { font-size: .6rem !important; }

      /* Progress overview */
      .progress-overview { grid-template-columns: 1fr !important; }
      .progress-overview > .donut-card { width: 100% !important; }
      .donut-wrap { width: 130px !important; height: 130px !important; }
      .donut-ring { width: 130px !important; height: 130px !important; }
      .donut-pct { font-size: 1.5rem !important; }
      .cat-bar-label { font-size: .72rem; }
      .cat-status { width: 70px; font-size: .58rem; }

      /* Section titles */
      .section-title { font-size: .78rem; padding: .5rem .85rem; letter-spacing: .08em; }

      /* Works table */
      table.works { font-size: .68rem; }
      table.works thead th, tr.works-thead-repeat th { padding: .4rem .45rem; font-size: .58rem; }
      table.works tbody tr.item td { padding: .38rem .45rem; }
      tr.subtotal td { padding: .35rem .45rem; font-size: .65rem; }
      tr.grand-total td { padding: .45rem .45rem; font-size: .72rem; }
      tr.works-cat td { padding: .38rem .45rem; font-size: .65rem; }
      .item-money { font-size: .67rem; }
      .badge { font-size: .56rem; padding: .15rem .45rem; }
      .perc-num { font-size: .65rem; }
      .perc-cell { min-width: 70px; }
      .extra-badge { font-size: .52rem; }

      /* Payment */
      .payment-card { padding: .85rem; }
      .pay-contractor-header { flex-direction: column; gap: .35rem; }
      table.pay-table { font-size: .72rem; }
      table.pay-table th { font-size: .58rem; padding: .35rem .55rem; }
      table.pay-table td { padding: .45rem .55rem; }
      .pay-sum-amount { font-size: 1.3rem !important; }

      /* Update cards */
      .update-card { padding: .9rem 1rem; }
      .update-date { font-size: .8rem; }
      .update-pct { font-size: 1.2rem !important; }
    }
    @media (max-width: 480px) {
      /* Topbar compact — hide print button */
      .btn-top:not(.btn-logout) { display: none; }
      .topbar-brand { font-size: .82rem; }

      /* Hero */
      .hero { padding: 1rem .75rem .85rem; }
      .hero-meta { display: none; }

      /* Works table — very compact */
      table.works { font-size: .62rem; }
      table.works thead th, tr.works-thead-repeat th { padding: .35rem .35rem; font-size: .54rem; }
      table.works tbody tr.item td { padding: .32rem .35rem; }
      tr.subtotal td { padding: .3rem .35rem; font-size: .6rem; }
      tr.grand-total td { padding: .4rem .35rem; font-size: .68rem; }
      tr.works-cat td { padding: .32rem .35rem; }
      .item-money { font-size: .62rem; }
      .badge { font-size: .52rem; padding: .12rem .38rem; }
      .perc-mini { display: none; }
      .perc-num { width: auto; }

      /* Metric cards */
      .metric-value { font-size: 1.35rem !important; }
      .metric-sub { font-size: .68rem !important; }

      /* Payment table — hide less critical columns */
      table.pay-table th:nth-child(3),
      table.pay-table td:nth-child(3) { display: none; }
      .pay-sum-sub { font-size: .65rem; }
      .pay-sum-trigger { font-size: .65rem; }

      /* Footer */
      .page-footer { font-size: .65rem; padding: .9rem; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <a href="/" class="topbar-brand" style="text-decoration:none">citerastudio</a>
  <span class="topbar-sep">|</span>
  {(role === 'admin' ? allProjects : clientProjects).length > 1 ? (
    <select class="topbar-project-select" onchange="location.href='/area-riservata/portal?p='+this.value">
      {(role === 'admin' ? allProjects : clientProjects).map((p: any) => (
        <option value={p.id} selected={p.id === projectId}>
          {p.name}{(p as any).template ? ' [template]' : ''}
        </option>
      ))}
    </select>
  ) : (
    <span class="topbar-project">{project.name}</span>
  )}
  <div class="topbar-lock">
    <span class="dot"></span>
    Private Access
  </div>
  <span class={`role-badge ${role}`}>{role === 'admin' ? '⚙ Admin' : 'Client'}</span>
  {role === 'admin' && <a href="/area-riservata/admin" class="btn-top">Admin Dashboard</a>}
  <button class="btn-top" onclick="window.print()">⎙ Print</button>
  <form method="POST" action="/api/area-riservata/logout" style="display:inline">
    <button type="submit" class="btn-logout">Sign out</button>
  </form>
</div>

<div class="hero">
  <div class="hero-inner">
    <div class="hero-top">
      <div>
        <div class="hero-title">{project.name}</div>
        <div class="hero-sub">{project.location}</div>
        <div class="update-badge">
          <span class="pulse"></span>
          Progress Update #{project.updateNum} — Last updated {fmtDate(project.updated)}
        </div>
      </div>
      <dl class="hero-meta">
        <dt>Client</dt>            <dd>{project.clientName}</dd>
        <dt>Architect / D.L.</dt> <dd>{project.architect}</dd>
        <dt>Contract period</dt>  <dd>{fmtDate(project.start)} → {fmtDate(project.end)}</dd>
        <dt>Location</dt>         <dd>{project.location.split(',')[0]}</dd>
      </dl>
    </div>
  </div>
</div>

<div class="main">

  <div class="metrics">
    <div class="metric-card">
      <div class="metric-label">Revised Budget <span style="font-weight:400;text-transform:none;letter-spacing:0">(net ex. VAT)</span></div>
      <div class="metric-value">{fmt(totalRevised)}</div>
      <div class="metric-sub">
        inc. VAT 10%: {fmt(totalRevised * 1.10)}
        {totalVariation !== 0 && (
          <div style={`margin-top:.5rem;padding:.5rem .65rem;border-radius:6px;background:${totalVariation < 0 ? '#f0fdf4' : '#fff7ed'};border:1px solid ${totalVariation < 0 ? '#bbf7d0' : '#fed7aa'}`}>
            <div style={`font-size:.68rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:${totalVariation < 0 ? '#15803d' : '#c2410c'};margin-bottom:.2rem`}>
              {totalVariation < 0 ? '▼ Savings' : '▲ Cost increase'}
            </div>
            <div style={`font-size:1rem;font-weight:700;color:${totalVariation < 0 ? '#16a34a' : '#dc2626'}`}>
              {totalVariation > 0 ? '+' : ''}{fmt(totalVariation)}
            </div>
            <div style="font-size:.65rem;color:var(--slate);margin-top:.2rem">
              Original budget: <strong style="color:var(--navy)">{fmt(totalOriginal)}</strong>
            </div>
          </div>
        )}
      </div>
    </div>
    <div class="metric-card highlight">
      <div class="metric-label">Works Completed <span style="font-weight:400;text-transform:none;letter-spacing:0">(net ex. VAT)</span></div>
      <div class="metric-value">{fmt(totalDone)}</div>
      <div class="metric-sub">{totalPerc.toFixed(1)}% of revised budget</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Remaining Works <span style="font-weight:400;text-transform:none;letter-spacing:0">(net ex. VAT)</span></div>
      <div class="metric-value">{fmt(totalLeft)}</div>
      <div class="metric-sub">works to execute</div>
    </div>
  </div>

  <div class="progress-overview">
    <div class="donut-card">
      <div class="donut-wrap">
        <div class="donut-ring" style={`--p:${totalPerc.toFixed(1)}%`}></div>
        <div class="donut-inner">
          <div class="donut-pct">{totalPerc.toFixed(1)}%</div>
          <div class="donut-lbl">Complete</div>
        </div>
      </div>
      <div class="donut-title">Overall Progress</div>
      <div class="donut-sub">Progress Update #{project.updateNum}<br/>{fmtDate(project.updated)}</div>
    </div>
    <div class="cat-card">
      <div class="cat-card-title">Progress by work category</div>
      {enrichedCats.map(cat => (
        <div class="cat-bar-row">
          <span class="cat-bar-id">{cat.id}</span>
          <span class="cat-bar-label" title={cat.label}>{cat.label}</span>
          <div class="cat-bar-track">
            <div class="cat-bar-fill" style={`width:${Math.min(cat.catPerc,100).toFixed(1)}%; background:${catColor(cat.catPerc)}`}></div>
          </div>
          <span class="cat-bar-pct" style={`color:${catColor(cat.catPerc)}`}>{cat.catPerc.toFixed(0)}%</span>
          <span class={`cat-status ${cat.catPerc > 99.9 ? 'complete' : cat.catPerc > 0 ? 'progress' : 'pending'}`}>{cat.catPerc > 99.9 ? 'Complete' : cat.catPerc > 0 ? 'In Progress' : 'Not Started'}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="section-title">Works Breakdown</div>
  <div class="works-card">
    <div class="works-scroll">
      {enrichedCats.map(cat => (
      <table class="works" style="margin-bottom:1.5rem">
        <tbody>
              <tr class="works-cat" data-cat-toggle={cat.id}>
                <td colspan="12">
                  <span class="cat-letter">{cat.id}</span>
                  {cat.label}
                  <span style="margin-left:.5rem; font-weight:400; color:var(--slate); font-size:0.68rem">
                    Revised: {fmt(cat.catRevised)} &nbsp;|&nbsp; Done: {fmt(cat.catDone)} ({cat.catPerc.toFixed(0)}%)
                  </span>
                  <span class="cat-chevron">▾</span>
                </td>
              </tr>
              <tr class="works-thead-repeat" data-cat-member={cat.id}>
                <th style="width:50px">#</th>
                <th>Description</th>
                <th style="width:55px">Unit</th>
                <th class="right" style="width:75px">Contracted<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">Qty</span></th>
                <th class="right" style="width:120px">Unit Price<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">net ex. VAT</span></th>
                <th class="right" style="width:120px">Budget<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">net ex. VAT</span></th>
                <th class="right" style="width:75px">Variation<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">Qty</span></th>
                <th class="right" style="width:120px">Revised Budget<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">net ex. VAT</span></th>
                <th class="right" style="width:80px">Done<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">Qty</span></th>
                <th class="right" style="width:120px">Value Done<br/><span style="font-size:0.55rem;opacity:.65;font-weight:400">net ex. VAT</span></th>
                <th style="width:110px">Progress</th>
                <th style="width:90px">Status</th>
              </tr>
              {cat.items.map((item: any) => {
                const notExec      = isNotExecuted(item);
                const percVal      = item.perc ?? 0;
                const dispPerc     = item.forceComplete ? 100 : percVal;
                const barColor     = item.overrun ? '#dc2626' : item.forceComplete ? '#22c55e' : percVal > 99.9 ? '#22c55e' : percVal > 0 ? '#f59e0b' : '#cbd5e1';
                const percIsNull   = item.perc === null;
                const variationPos  = item.variationQty > 0;
                const variationNeg  = item.variationQty < 0;
                const revisedPos    = item.revisedBudget > 0;
                const notExecuted   = !item.extra && item.budget > 0 && !(item.revisedBudget > 0);
                const revisedColor  = variationNeg ? '#16a34a' : variationPos ? '#dc2626' : '';
                return (
                <tr class={`item${item.extra ? ' extra-item' : ''}`} data-cat-member={cat.id}>
                  <td class="item-id">{item.id}</td>
                  <td class="item-desc">
                    {item.extra && <span class="extra-badge">Extra</span>}
                    <span
                      class="brief-trigger"
                      data-id={item.id}
                      data-brief={item.brief ?? ''}
                      data-fulldesc={item.fullDesc ?? ''}
                      title={item.fullDesc ? 'Click for full description' : undefined}
                    >{item.brief}</span>
                  </td>
                  <td style="color:var(--slate); font-size:0.72rem">{item.unit}</td>
                  <td class="item-num" style={item.extra ? 'color:var(--grey-3)' : ''}>
                    {item.extra ? '–' : fmtQty(item.qty, item.unit)}
                  </td>
                  <td class="item-money">{fmt(item.price)}</td>
                  <td class="item-money" style={item.extra ? 'color:var(--grey-3)' : ''}>
                    {item.extra ? '–' : fmt(item.budget)}
                  </td>
                  <td class="item-money" style={`color:${variationNeg ? '#16a34a' : variationPos ? '#dc2626' : 'var(--grey-3)'}`}>
                    {item.variationQty !== 0 ? item.variationQty : '–'}
                  </td>
                  <td class="item-money" style={`color:${notExecuted ? '#16a34a' : revisedColor}`}>
                    {(revisedPos || notExecuted) ? fmt(item.revisedBudget) : <span style="color:var(--grey-3)">–</span>}
                  </td>
                  <td class="item-done-qty" style={`color:${item.overrun ? '#dc2626' : 'var(--text)'}`}>
                    {fmtQ(item.done, item.unit)}
                    {item.overrun && <span style="font-size:0.6rem; margin-left:.2rem; opacity:.8">↑</span>}
                  </td>
                  <td class="item-money">
                    {item.valueDone > 0 ? fmt(item.valueDone) : '–'}
                  </td>
                  <td class="perc-cell">
                    {percIsNull ? (
                      <span style="color:var(--grey-3); font-size:0.72rem">–</span>
                    ) : notExec ? (
                      <span style="color:var(--grey-3); font-size:0.72rem">–</span>
                    ) : (
                      <div class="perc-wrap">
                        <div class="perc-mini">
                          <div class="perc-mini-fill" style={`width:${Math.min(dispPerc, 100).toFixed(0)}%; background:${barColor}`}></div>
                        </div>
                        <span class={item.overrun ? 'perc-num overrun-num' : 'perc-num'} style={`color:${barColor}`}>
                          {Math.min(Math.round(dispPerc), 100)}%
                        </span>
                      </div>
                    )}
                  </td>
                  <td>
                    <span class={`badge ${statusClass(item.perc, item)}`}>{statusLabel(item)}</span>
                  </td>
                </tr>
              );})}
              <tr class="subtotal" data-cat-member={cat.id}>
                <td></td>
                <td class="sub-label">
                  {cat.catVariation !== 0 && (
                    <span style={`font-style:italic; font-weight:600; color:${cat.catVariation < 0 ? '#16a34a' : '#dc2626'}`}>
                      {cat.catVariation < 0 ? 'Savings' : 'Additional cost'}: {cat.catVariation > 0 ? '+' : ''}{fmt(cat.catVariation)}
                    </span>
                  )}
                </td>
                <td colspan="3" class="sub-label" style="text-align:right; padding-right:1rem">Category {cat.id} subtotal</td>
                <td class="item-money">{fmt(cat.catBudget)}</td>
                <td class="item-money" style="color:var(--grey-3)">–</td>
                <td class="item-money">{fmt(cat.catRevised)}</td>
                <td></td>
                <td class="item-money" style="color:var(--navy)">{fmt(cat.catDone)}</td>
                <td class="perc-cell">
                  <div class="perc-wrap">
                    <div class="perc-mini"><div class="perc-mini-fill" style={`width:${Math.min(cat.catPerc,100).toFixed(0)}%; background:${catColor(cat.catPerc)}`}></div></div>
                    <span class="perc-num">{cat.catPerc.toFixed(0)}%</span>
                  </div>
                </td>
                <td><span class={`badge ${cat.catPerc > 99.9 ? 'complete' : cat.catPerc > 0 ? 'progress' : 'pending'}`}>{cat.catPerc > 99.9 ? 'Complete' : cat.catPerc > 0 ? 'In Progress' : 'Not Started'}</span></td>
              </tr>
        </tbody>
      </table>
      ))}
      <table class="works">
        <tbody>
          <tr class="grand-total">
            <td colspan="5" style="text-align:right; padding-right:1rem; letter-spacing:.04em">TOTAL <span style="font-size:0.65rem; opacity:.65; font-weight:400">(net ex. VAT)</span></td>
            <td class="item-money">{fmt(totalOriginal)}</td>
            <td class="item-money" style="opacity:.65">–</td>
            <td class="item-money">{fmt(totalRevised)}</td>
            <td></td>
            <td class="item-money">{fmt(totalDone)}</td>
            <td colspan="2" style="padding-left:.75rem; font-size:0.88rem">
              {totalPerc.toFixed(2)}% complete
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="section-title">Payment Schedule — by Contractor</div>
  {contractorSchedules.length === 0 && (
    <div class="payment-card" style="text-align:center; padding:2rem; color:var(--slate); font-size:0.85rem">
      No payment schedules defined. Assign SAL milestones to contractors in the admin panel.
    </div>
  )}
  {contractorSchedules.map(({ c, cBudget, cPerc, milestones, paidC, paidPct, nextC, pendingC, lastPaidDate, lastPaidPos }) => {
    const nextNetC   = nextC?.amount ?? 0;
    const nextVatC   = nextNetC * 0.10;
    const nextGrossC = nextNetC + nextVatC;
    const progNdC    = nextC ? Math.max(0, (nextC.workTriggerAt ?? nextC.triggerAt) - cPerc) : 0;
    return (
      <div class="payment-card">
        <div class="pay-contractor-header">
          <div>
            <span class="pay-contractor-name">{c.name}</span>
            <span class="pay-contractor-trade">{c.trade}</span>
          </div>
          <div class="pay-contractor-stats">
            Budget: <strong>{fmt(cBudget)}</strong>
            &nbsp;|&nbsp; Progress: <strong style={`color:${cPerc >= 100 ? 'var(--green)' : cPerc > 0 ? 'var(--orange)' : 'var(--slate)'}`}>{cPerc.toFixed(1)}%</strong>
          </div>
        </div>
        <div class="pay-summary">
          <div class="pay-sum-item paid">
            <div class="pay-sum-label">Paid to Date</div>
            <div class="pay-sum-amount">{fmt(paidC)}</div>
            <div class="pay-sum-sub">ex. VAT &nbsp;|&nbsp; inc. VAT: {fmt(paidC * 1.10)}</div>
            {paidC > 0 && <div class="pay-sum-paid-note">&#10003; payments certified</div>}
          </div>
          <div class="pay-sum-arrow">&#8594;</div>
          <div class={`pay-sum-item ${nextC ? (nextC.isDue ? 'next' : 'upcoming') : 'pending'}`}>
            <div class="pay-sum-label">{nextC ? (nextC.isDue ? '▶ Payment Due' : 'Upcoming Payment') : 'All payments due'}</div>
            <div class="pay-sum-amount">{nextC ? fmt(nextNetC) : '–'}</div>
            {nextC && <div class="pay-sum-sub">ex. VAT &nbsp;|&nbsp; inc. VAT: {fmt(nextGrossC)}</div>}
            {nextC && nextC.triggerType === 'date'    && <div class="pay-sum-trigger">On {nextC.triggerDate ?? '—'}</div>}
            {nextC && nextC.triggerType !== 'date' && nextC.isDue  && nextC.triggerType === 'signing' && <div class="pay-sum-trigger">On contract signing</div>}
            {nextC && nextC.triggerType !== 'date' && nextC.isDue  && nextC.triggerType === 'start'   && <div class="pay-sum-trigger">At start of works</div>}
            {nextC && nextC.triggerType !== 'date' && nextC.isDue  && nextC.triggerType === 'final'   && <div class="pay-sum-trigger">On practical completion</div>}
            {nextC && nextC.triggerType !== 'date' && nextC.isDue  && nextC.triggerType === 'percent'  && <div class="pay-sum-trigger">Trigger reached &nbsp;&mdash;&nbsp; {cPerc.toFixed(1)}% work done</div>}
            {nextC && nextC.triggerType !== 'date' && !nextC.isDue && nextC.triggerType === 'final'    && <div class="pay-sum-trigger">Triggers on practical completion</div>}
            {nextC && nextC.triggerType !== 'date' && !nextC.isDue && nextC.triggerType === 'percent'  && <div class="pay-sum-trigger">Triggers at {nextC.workTriggerAt}% &nbsp;&mdash;&nbsp; {progNdC.toFixed(1)}% to go</div>}
          </div>
          <div class="pay-sum-arrow">&#8594;</div>
          <div class="pay-sum-item pending">
            <div class="pay-sum-label">Remaining After</div>
            <div class="pay-sum-amount">{fmt(pendingC)}</div>
            <div class="pay-sum-sub">ex. VAT &nbsp;|&nbsp; inc. VAT: {fmt(pendingC * 1.10)}</div>
          </div>
        </div>
        <div class="pay-timeline-wrap">
          <div class="pay-bars-legend">
            <div class="pay-bars-legend-item"><div class="pay-bars-legend-swatch work"></div>Work progress ({cPerc.toFixed(1)}%)</div>
            <div class="pay-bars-legend-item"><div class="pay-bars-legend-swatch pay"></div>Payments certified ({paidPct.toFixed(1)}%)</div>
          </div>
          <div class="pay-work-track">
            <div class="pay-work-fill" style={`width:${Math.min(cPerc, 100).toFixed(1)}%`}></div>
          </div>
          <div class="pay-track-spacer"></div>
          <div class="pay-track">
            <div class="pay-track-fill" style={`width:${Math.min(paidPct, 100).toFixed(1)}%`}></div>
            {milestones.map(m => (
              <div class={`pay-tick ${m.status}`} style={`left:${m.tickPos}%`}>
                <div class="pay-tick-id">{m.id}</div>
                <div class="pay-tick-dot"></div>
                <div class="pay-tick-lbl">{m.triggerType === 'signing' ? 'Signing' : m.triggerType === 'start' ? 'Start' : m.triggerType === 'final' ? 'Final' : m.triggerType === 'date' ? (m.triggerDate ?? '—') : m.triggerAt + '%'}</div>
              </div>
            ))}
            {lastPaidDate && (
              <div class="pay-now" style={`left:${lastPaidPos}%`}>
                <div class="pay-now-lbl">{lastPaidDate}</div>
                <div class="pay-now-line"></div>
                <div class="pay-now-dot"></div>
              </div>
            )}
          </div>
          <div class="pay-track-labels">
            <span class="pay-track-edge">0% — Contract signed</span>
            <span class="pay-track-edge">100% — Practical completion</span>
          </div>
        </div>
        <div class="pay-table-wrap">
          <table class="pay-table">
            <thead>
              <tr>
                <th style="width:55px">Ref.</th>
                <th>Milestone</th>
                <th>Trigger</th>
                <th class="right">Net (ex. VAT)</th>
                <th class="right">VAT 10%</th>
                <th class="right">Total inc. VAT</th>
                <th style="width:100px">Status</th>
              </tr>
            </thead>
            <tbody>
              {milestones.map(m => (
                <tr class={`pay-row-${m.status}`}>
                  <td class="pay-col-id">{m.id}</td>
                  <td class="pay-col-label">{m.label}</td>
                  <td class="pay-col-trigger">{m.triggerNote}</td>
                  <td class="pay-col-money">{fmt(m.amount)}</td>
                  <td class="pay-col-money" style="color:var(--slate)">{fmt(m.amount * 0.10)}</td>
                  <td class="pay-col-gross">{fmt(m.amount * 1.10)}</td>
                  <td><span class={`pay-badge ${m.status}`}>{m.status === 'next' ? (m.isDue ? 'Due' : 'Upcoming') : m.status === 'paid' ? 'Paid' : 'Pending'}</span></td>
                </tr>
              ))}
              <tr style="background:var(--grey-1)">
                <td colspan="3" style="text-align:right; padding-right:1rem; font-size:0.72rem; font-weight:600; color:var(--slate); letter-spacing:.04em">CONTRACTOR TOTAL</td>
                <td class="pay-col-money" style="font-weight:700; color:var(--navy)">{fmt(cBudget)}</td>
                <td class="pay-col-money" style="font-weight:700; color:var(--slate)">{fmt(cBudget * 0.10)}</td>
                <td class="pay-col-gross">{fmt(cBudget * 1.10)}</td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    );
  })}

  {technicianSchedules.length > 0 && (
    <>
      <div class="section-title">Technical Fees — by Technician</div>
      {technicianSchedules.map(({ t, tFee, milestones, paidT, paidPctT, nextT, pendingT, lastPaidDateT }: any) => {
        const nextNetT = nextT?.amount ?? 0;
        return (
          <div class="payment-card">
            <div class="pay-contractor-header">
              <div>
                <span class="pay-contractor-name">{t.name}</span>
                <span class="pay-contractor-trade">{t.role}</span>
              </div>
              <div class="pay-contractor-stats">
                Total Fee: <strong>{fmt(tFee)}</strong>
                &nbsp;|&nbsp; Overall Works: <strong style={`color:${totalPerc >= 100 ? 'var(--green)' : totalPerc > 0 ? 'var(--orange)' : 'var(--slate)'}`}>{totalPerc.toFixed(1)}%</strong>
              </div>
            </div>
            <div class="pay-summary">
              <div class="pay-sum-item paid">
                <div class="pay-sum-label">Paid to Date</div>
                <div class="pay-sum-amount">{fmt(paidT)}</div>
                <div class="pay-sum-sub">net ex. VAT</div>
                {paidT > 0 && <div class="pay-sum-paid-note">&#10003; payments certified</div>}
              </div>
              <div class="pay-sum-arrow">&#8594;</div>
              <div class={`pay-sum-item ${nextT ? (nextT.isDue ? 'next' : 'upcoming') : 'pending'}`}>
                <div class="pay-sum-label">{nextT ? (nextT.isDue ? '▶ Payment Due' : 'Upcoming Payment') : 'All payments due'}</div>
                <div class="pay-sum-amount">{nextT ? fmt(nextNetT) : '–'}</div>
                {nextT && <div class="pay-sum-sub">net ex. VAT</div>}
                {nextT && nextT.triggerType === 'date'    && <div class="pay-sum-trigger">On {nextT.triggerDate ?? '—'}</div>}
                {nextT && nextT.triggerType !== 'date' && nextT.isDue  && nextT.triggerType === 'signing'  && <div class="pay-sum-trigger">On contract signing</div>}
                {nextT && nextT.triggerType !== 'date' && nextT.isDue  && nextT.triggerType === 'start'    && <div class="pay-sum-trigger">At start of works</div>}
                {nextT && nextT.triggerType !== 'date' && nextT.isDue  && nextT.triggerType === 'final'    && <div class="pay-sum-trigger">On practical completion</div>}
                {nextT && nextT.triggerType !== 'date' && nextT.isDue  && nextT.triggerType === 'percent'  && <div class="pay-sum-trigger">Trigger reached &nbsp;&mdash;&nbsp; {totalPerc.toFixed(1)}% overall</div>}
                {nextT && nextT.triggerType !== 'date' && !nextT.isDue && nextT.triggerType === 'final'    && <div class="pay-sum-trigger">Triggers on practical completion</div>}
                {nextT && nextT.triggerType !== 'date' && !nextT.isDue && nextT.triggerType === 'percent'  && <div class="pay-sum-trigger">Triggers at {nextT.triggerAt}% overall works</div>}
              </div>
              <div class="pay-sum-arrow">&#8594;</div>
              <div class="pay-sum-item pending">
                <div class="pay-sum-label">Remaining After</div>
                <div class="pay-sum-amount">{fmt(pendingT)}</div>
                <div class="pay-sum-sub">net ex. VAT</div>
              </div>
            </div>
            <div class="pay-timeline-wrap">
              <div class="pay-bars-legend">
                <div class="pay-bars-legend-item"><div class="pay-bars-legend-swatch work"></div>Overall works progress ({totalPerc.toFixed(1)}%)</div>
                <div class="pay-bars-legend-item"><div class="pay-bars-legend-swatch pay"></div>Fees certified ({paidPctT.toFixed(1)}%)</div>
              </div>
              <div class="pay-work-track">
                <div class="pay-work-fill" style={`width:${Math.min(totalPerc, 100).toFixed(1)}%`}></div>
              </div>
              <div class="pay-track-spacer"></div>
              <div class="pay-track">
                <div class="pay-track-fill" style={`width:${Math.min(paidPctT, 100).toFixed(1)}%`}></div>
                {milestones.map((m: any) => (
                  <div class={`pay-tick ${m.status}`} style={`left:${m.tickPos}%`}>
                    <div class="pay-tick-id">{m.id}</div>
                    <div class="pay-tick-dot"></div>
                    <div class="pay-tick-lbl">{m.triggerType === 'signing' ? 'Signing' : m.triggerType === 'start' ? 'Start' : m.triggerType === 'final' ? 'Final' : m.triggerType === 'date' ? (m.triggerDate ?? '—') : m.triggerAt + '%'}</div>
                  </div>
                ))}
                {lastPaidDateT && (
                  <div class="pay-now" style="left:0%">
                    <div class="pay-now-lbl">{lastPaidDateT}</div>
                    <div class="pay-now-line"></div>
                    <div class="pay-now-dot"></div>
                  </div>
                )}
              </div>
              <div class="pay-track-labels">
                <span class="pay-track-edge">0% — Contract signed</span>
                <span class="pay-track-edge">100% — Practical completion</span>
              </div>
            </div>
            <div class="pay-table-wrap">
              <table class="pay-table">
                <thead>
                  <tr>
                    <th style="width:55px">Ref.</th>
                    <th>Milestone</th>
                    <th>Trigger</th>
                    <th class="right">Amount <span style="font-size:.6em;font-weight:400;opacity:.7">(net ex. VAT)</span></th>
                    <th style="width:100px">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {milestones.map((m: any) => (
                    <tr class={`pay-row-${m.status}`}>
                      <td class="pay-col-id">{m.id}</td>
                      <td class="pay-col-label">{m.label}</td>
                      <td class="pay-col-trigger">{m.triggerNote}</td>
                      <td class="pay-col-money">{fmt(m.amount)}</td>
                      <td><span class={`pay-badge ${m.status}`}>{m.status === 'next' ? (m.isDue ? 'Due' : 'Upcoming') : m.status === 'paid' ? 'Paid' : 'Pending'}</span></td>
                    </tr>
                  ))}
                  <tr style="background:var(--grey-1)">
                    <td colspan="3" style="text-align:right; padding-right:1rem; font-size:0.72rem; font-weight:600; color:var(--slate); letter-spacing:.04em">TOTAL FEE (net ex. VAT)</td>
                    <td class="pay-col-money" style="font-weight:700; color:var(--navy)">{fmt(tFee)}</td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        );
      })}
    </>
  )}

  {updates.length > 0 && (
    <>
      <div class="section-title">Progress Updates</div>
      <div class="updates-grid">
        {updates.map((u, i) => (
          <div class={`update-card${i === 0 ? ' latest' : ''}`}>
            <div class="update-num">Progress Update #{u.num}{i === 0 ? ' — Latest' : ''}</div>
            <div class="update-date">{fmtDate(u.date)}</div>
            {i === 0 && <div class="update-pct">{totalPerc.toFixed(1)}% <span>overall complete</span></div>}
            {u.note && <div class="update-note">{u.note}</div>}
          </div>
        ))}
      </div>
    </>
  )}

</div>

<dialog id="desc-dialog">
  <div class="desc-dialog-head">
    <div style="display:flex;flex-direction:column;gap:.35rem;flex:1;min-width:0">
      <span id="desc-dialog-id" class="desc-dialog-id"></span>
      <span id="desc-dialog-brief" class="desc-dialog-brief"></span>
    </div>
    <button class="desc-dialog-close" id="desc-dialog-close" aria-label="Close">✕</button>
  </div>
  <div class="desc-dialog-body" id="desc-dialog-body"></div>
</dialog>

<div class="page-footer">
  <strong>CiteraStudio</strong> — Landscape Architecture &amp; Project Management &nbsp;|&nbsp;
  Arch. Vito Depalo &nbsp;|&nbsp; {project.location} &nbsp;|&nbsp;
  This document is confidential and intended solely for {project.clientName}.
</div>

<script is:inline>
  (function () {
    // Description dialog
    var dialog  = document.getElementById('desc-dialog');
    var dId     = document.getElementById('desc-dialog-id');
    var dBrief  = document.getElementById('desc-dialog-brief');
    var dBody   = document.getElementById('desc-dialog-body');
    var dClose  = document.getElementById('desc-dialog-close');

    document.querySelectorAll('.brief-trigger').forEach(function (el) {
      var fullDesc = el.getAttribute('data-fulldesc');
      if (!fullDesc) return; // no full desc → plain text, no click
      el.addEventListener('click', function () {
        dId.textContent    = el.getAttribute('data-id');
        dBrief.textContent = el.getAttribute('data-brief');
        dBody.textContent  = fullDesc;
        dialog.showModal();
      });
    });

    dClose.addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) {
      // close on backdrop click
      if (e.target === dialog) dialog.close();
    });

    // Collapsible category rows
    var headers = document.querySelectorAll('tr[data-cat-toggle]');
    headers.forEach(function (header) {
      header.style.cursor = 'pointer';
      header.addEventListener('click', function () {
        var catId = header.getAttribute('data-cat-toggle');
        var collapsed = header.classList.toggle('collapsed');
        var members = document.querySelectorAll('[data-cat-member="' + catId + '"]');
        members.forEach(function (row) {
          row.style.display = collapsed ? 'none' : '';
        });
      });
    });
  })();
</script>
</body>
</html>

