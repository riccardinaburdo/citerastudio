---
export const prerender = false;

import { getProject } from '../../lib/store';

const role = Astro.locals.role;
const projectId = Astro.url.searchParams.get('p') ?? 'default';

const projectData = await getProject(projectId);
const { info: project, contractors, categories: rawCategories } = projectData;
const updates = (projectData.updates ?? []).slice().sort((a, b) => b.num - a.num);

const enrich = (item: typeof rawCategories[0]['items'][0]) => {
  const budget  = item.extra ? 0 : item.qty * item.price;
  const done    = item.done * item.price;
  const perc    = (!item.extra && budget > 0) ? (done / budget) * 100 : null;
  const overrun = !item.extra && item.done > item.qty;
  return { ...item, budget, done, perc, overrun };
};
const enrichedCats = rawCategories.map(cat => {
  const items        = cat.items.map(enrich);
  const catBudget    = items.filter(i => !i.extra).reduce((s, i) => s + i.budget, 0);
  const catDoneContr = items.filter(i => !i.extra).reduce((s, i) => s + i.done,   0);
  const catDoneExtra = items.filter(i =>  i.extra).reduce((s, i) => s + i.done,   0);
  const catDone      = catDoneContr + catDoneExtra;
  const catPerc      = catBudget > 0 ? (catDoneContr / catBudget) * 100 : 0;
  return { ...cat, items, catBudget, catDoneContr, catDoneExtra, catDone, catPerc };
});
const totalBudget    = enrichedCats.reduce((s, c) => s + c.catBudget,    0);
const totalDoneContr = enrichedCats.reduce((s, c) => s + c.catDoneContr, 0);
const totalDoneExtra = enrichedCats.reduce((s, c) => s + c.catDoneExtra, 0);
const totalDone      = totalDoneContr + totalDoneExtra;
const totalPerc      = totalBudget > 0 ? (totalDoneContr / totalBudget) * 100 : 0;
const totalLeft      = totalBudget - totalDoneContr;


// Per-contractor payment schedules (uses each contractor's sal milestones and their own budget)
const contractorSchedules = contractors.flatMap(c => {
  const allItems = enrichedCats.flatMap(cat => cat.items).filter(i => i.contractor === c.id && !i.extra);
  const cBudget  = allItems.reduce((s, i) => s + i.budget, 0);
  if (cBudget === 0 || !c.sal || c.sal.length === 0) return [];
  const cDone    = allItems.reduce((s, i) => s + i.done,   0);
  const cPerc    = (cDone / cBudget) * 100;
  let nextFoundC = false;
  let cumPct = 0;

  // Separate milestones into quantified (have an amount) and unquantified date ones
  const quantified   = c.sal.filter(m => m.pct > 0 || ((m as any).fixedAmt ?? 0) > 0);
  const unquantified = c.sal.filter(m => m.pct === 0 && !((m as any).fixedAmt) && m.triggerType === 'date');

  const milestones = quantified.map(m => {
    cumPct += m.pct;
    const tickPos     = Math.min(cumPct, 100);
    const amount      = cBudget > 0 ? (m.pct / 100) * cBudget : ((m as any).fixedAmt ?? 0);
    const triggerAt   = m.triggerType === 'signing' ? 0 : m.triggerType === 'final' ? 100 : m.triggerType === 'date' ? -1 : (m.triggerPct ?? 100);
    const triggerNote = m.triggerType === 'signing' ? 'On contract signing'
                      : m.triggerType === 'final'   ? 'On practical completion'
                      : m.triggerType === 'date'    ? `On ${m.triggerDate ?? '—'}`
                      : `At ${m.triggerPct}% completion`;
    const dateDue     = m.triggerType === 'date' && m.triggerDate ? new Date(m.triggerDate) : null;
    const dateExpired = dateDue ? dateDue <= new Date() : false;
    let status: 'paid' | 'next' | 'pending';
    if (m.paid === true) {
      status = 'paid';
    } else if (m.triggerType === 'date') {
      if (dateExpired)        { status = 'paid'; }
      else if (!nextFoundC)   { status = 'next'; nextFoundC = true; }
      else                    { status = 'pending'; }
    } else if (cPerc >= triggerAt) { status = 'paid'; }
    else if (!nextFoundC)    { status = 'next'; nextFoundC = true; }
    else                     { status = 'pending'; }
    return { ...m, amount, triggerAt, triggerNote, status, tickPos };
  });

  // Collapsed "Remaining" block for unquantified date milestones
  const remainingPct = Math.max(0, 100 - cumPct);
  if (unquantified.length > 0 && remainingPct > 0.01) {
    const remStatus = nextFoundC ? 'pending' : 'next';
    if (!nextFoundC && remStatus === 'next') nextFoundC = true;
    milestones.push({
      id: '…', label: `Remaining (${unquantified.length} milestone${unquantified.length > 1 ? 's' : ''})`,
      triggerType: 'date', triggerPct: null, triggerDate: null,
      pct: remainingPct, amount: (remainingPct / 100) * cBudget,
      triggerAt: -1, triggerNote: 'To be quantified', status: remStatus as any, tickPos: 100,
    } as any);
  }

  const paidC      = milestones.filter(m => m.status === 'paid').reduce((s, m) => s + m.amount, 0);
  const paidPct    = milestones.filter(m => m.status === 'paid').reduce((s, m) => s + m.pct,    0);
  const nextC      = milestones.find(m => m.status === 'next') ?? null;
  const remainingC = cBudget - paidC - (nextC?.amount ?? 0);
  const pendingC   = remainingC; // kept for template compatibility

  // Last paid milestone → replaces "now" on the bar
  const lastPaid     = [...milestones].filter(m => m.status === 'paid').slice(-1)[0] ?? null;
  const lastPaidDate = lastPaid ? ((lastPaid as any).paidDate ?? (lastPaid as any).triggerDate ?? null) : null;
  const lastPaidPos  = lastPaid?.tickPos ?? 0;
  return [{ c, cBudget, cPerc, milestones, paidC, paidPct, nextC, pendingC, lastPaidDate, lastPaidPos }];
});

const fmt = (n: number) => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtQ = (n: number, unit: string) => unit === 'lump' ? (n === 0 ? '–' : '✓') : n.toLocaleString('en-GB');
const statusLabel = (p: number | null) => p === null ? 'Extra' : p >= 100 ? 'Complete' : p > 0 ? 'In Progress' : 'Not Started';
const statusClass = (p: number | null) => p === null ? 'extra' : p >= 100 ? 'complete' : p > 0 ? 'progress' : 'pending';
const catColor    = (p: number | null) => p === null ? '#f59e0b' : p >= 100 ? '#22c55e' : p >= 75 ? '#FB8503' : p > 0 ? '#f59e0b' : '#cbd5e1';

const fmtDate = (d: string) => {
  try {
    return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch { return d; }
};
