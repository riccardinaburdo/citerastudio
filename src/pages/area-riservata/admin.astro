<script define:vars={{ projectJson }}>
  let state = JSON.parse(projectJson);
  const fmtAmt = n => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits:2, maximumFractionDigits:2 });

  function findItem(catId, itemId) {
    const cat = state.categories.find(c => c.id === catId);
    return cat ? cat.items.find(i => i.id === itemId) : null;
  }

  const saveAllBtn = document.getElementById('save-all-btn');
  const saveStatus = document.getElementById('save-status');

  async function saveAll() {
    saveAllBtn.disabled = true;
    saveStatus.textContent = 'Saving…';
    saveStatus.style.color = 'rgba(255,255,255,.7)';
    try {
      const res = await fetch('/api/area-riservata/project', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(state)
      });
      const json = await res.json();
      if (!json.ok) throw new Error(json.error ?? 'Unknown error');
      saveStatus.textContent = 'Saved ✓';
      saveStatus.style.color = '#22c55e';
      setTimeout(() => { saveStatus.textContent = ''; }, 3000);
    } catch (err) {
      saveStatus.textContent = 'Error: ' + err.message;
      saveStatus.style.color = '#fca5a5';
    } finally {
      saveAllBtn.disabled = false;
    }
  }

  saveAllBtn.addEventListener('click', saveAll);
  document.querySelectorAll('.save-trigger').forEach(btn => btn.addEventListener('click', saveAll));

  // ── Project switcher dropdown ─────────────────────────────────────────────
  const switcherDrop = document.getElementById('proj-switcher-drop');
  document.getElementById('proj-switcher-btn').addEventListener('click', e => {
    e.stopPropagation();
    switcherDrop.classList.toggle('is-open');
  });
  document.addEventListener('click', () => switcherDrop.classList.remove('is-open'));
  switcherDrop.addEventListener('click', e => e.stopPropagation());

  // Delete project
  document.addEventListener('click', async e => {
    const btn = e.target.closest('.btn-del-project');
    if (!btn) return;
    const id   = btn.dataset.projId;
    const name = btn.dataset.projName;
    if (!confirm(`Delete project "${name}"?\n\nThis cannot be undone.`)) return;
    btn.disabled = true; btn.textContent = 'Deleting…';
    const res  = await fetch(`/api/area-riservata/projects?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    const json = await res.json();
    if (json.ok) { btn.closest('.proj-card').remove(); }
    else { alert('Error: ' + json.error); btn.disabled = false; btn.textContent = 'Delete'; }
  });

  document.getElementById('proj-drop-new').addEventListener('click', async () => {
    switcherDrop.classList.remove('is-open');
    const name = prompt('Project name:')?.trim();
    if (!name) return;
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else alert('Error: ' + json.error);
  });

  const tabs = document.querySelectorAll('.tab-btn');
  const panels = {
    projects:    document.getElementById('tab-projects'),
    project:     document.getElementById('tab-project'),
    contractors: document.getElementById('tab-contractors'),
    works:       document.getElementById('tab-works'),
  };
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      Object.entries(panels).forEach(([k, el]) => { if (el) el.hidden = (k !== btn.dataset.tab); });
    });
  });

  // New Project button (in Projects tab) — delegates to the same handler
  document.getElementById('btn-new-project').addEventListener('click', () =>
    document.getElementById('proj-drop-new').click());

  // From template button
  document.getElementById('btn-from-template').addEventListener('click', async () => {
    const name = prompt('Project name (will be pre-filled with example data):')?.trim();
    if (!name) return;
    const btn = document.getElementById('btn-from-template');
    btn.disabled = true; btn.textContent = 'Creating…';
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, template: true })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else { alert('Error: ' + json.error); btn.disabled = false; btn.textContent = '↺ From template'; }
  });

  document.querySelectorAll('[data-info]').forEach(el => {
    el.addEventListener('input', () => {
      const field = el.dataset.info;
      state.info[field] = el.type === 'number' ? parseFloat(el.value) || 0 : el.value;
    });
  });

  document.addEventListener('input', e => {
    const el = e.target;
    const { catId, itemId, field } = el.dataset;
    if (!catId || !itemId || !field) return;
    const item = findItem(catId, itemId);
    if (!item) return;
    const newVal = el.type === 'number' ? (parseFloat(el.value) || 0) : el.type === 'checkbox' ? el.checked : el.value;
    item[field] = newVal;
    const row = el.closest('tr');
    if (!row || !(field === 'qty' || field === 'price' || field === 'done')) return;

    const budget   = item.extra ? 0 : (item.qty || 0) * (item.price || 0);
    const valDone  = (item.done || 0) * (item.price || 0);
    const overrun  = !item.extra && (item.done || 0) > (item.qty || 0);
    const percActual = (!item.extra && budget > 0) ? (valDone / budget) * 100 : 0;
    const barW     = Math.min(percActual, 100);
    const pColor   = overrun ? '#dc2626' : item.extra ? '#f59e0b' : percActual >= 100 ? '#22c55e' : percActual > 0 ? '#f59e0b' : '#cbd5e1';

    // Auto cells
    const bCell = row.querySelector('.auto-cell-budget');
    const dCell = row.querySelector('.auto-cell-done');
    if (bCell) bCell.textContent = item.extra ? '–' : fmtAmt(budget);
    if (dCell) dCell.textContent = fmtAmt(valDone);

    // Done cell — overrun color + badge
    const doneTd  = row.querySelector('[data-field="done"]')?.closest('td');
    if (doneTd) {
      const inp = doneTd.querySelector('input');
      if (inp) inp.style.color = overrun ? 'var(--red)' : '';
      let badge = doneTd.querySelector('.overrun-badge');
      if (overrun && !badge) {
        const s = document.createElement('span'); s.className = 'overrun-badge'; s.textContent = '↑';
        doneTd.appendChild(s);
      } else if (!overrun && badge) { badge.remove(); }
    }

    // Progress bar
    const percWrap = row.querySelector('.perc-wrap');
    if (percWrap) {
      const fill = percWrap.querySelector('.perc-fill');
      const num  = percWrap.querySelector('.perc-num');
      if (fill) { fill.style.width = `${barW}%`; fill.style.background = pColor; }
      if (num)  { num.textContent = `${Math.round(percActual)}%`; num.style.color = pColor; }
    }

    // Status badge
    const statusSpan = row.querySelector('.status-badge');
    if (statusSpan) {
      if (item.extra) {
        if ((item.done || 0) > 0) { statusSpan.className = 'status-badge status-complete'; statusSpan.textContent = 'Complete'; }
        else                      { statusSpan.className = 'status-badge status-pending';  statusSpan.textContent = 'Not Started'; }
      } else if (overrun)              { statusSpan.className = 'status-badge status-overrun';  statusSpan.textContent = 'Overrun'; }
      else if (percActual >= 100) { statusSpan.className = 'status-badge status-complete'; statusSpan.textContent = 'Complete'; }
      else if (percActual > 0)    { statusSpan.className = 'status-badge status-progress'; statusSpan.textContent = 'In Progress'; }
      else                        { statusSpan.className = 'status-badge status-pending';  statusSpan.textContent = 'Not Started'; }
    }
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-item');
    if (!btn) return;
    const { catId, itemId } = btn.dataset;
    const item = state.categories.find(c => c.id === catId)?.items.find(i => i.id === itemId);
    const label = item?.brief ? `"${item.brief}"` : `item ${itemId}`;
    if (!confirm(`Delete ${label}?\n\nThis cannot be undone.`)) return;
    const cat = state.categories.find(c => c.id === catId);
    if (cat) cat.items = cat.items.filter(i => i.id !== itemId);
    btn.closest('tr')?.remove();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-cat');
    if (!btn) return;
    const { catId } = btn.dataset;
    state.categories = state.categories.filter(c => c.id !== catId);
    document.querySelectorAll(`[data-cat-id="${catId}"]`).forEach(row => row.remove());
  });

  function recalcCard(card) {
    const budget = parseFloat(card.dataset.budget ?? '0');
    let totalPct = 0;
    card.querySelectorAll('tbody tr:not(.sal-total)').forEach(row => {
      const pct = parseFloat(row.dataset.pct ?? '0') || 0;
      totalPct += pct;
      const amtCell = row.querySelector('.sal-amt');
      if (amtCell) amtCell.textContent = fmtAmt(budget * pct / 100);
    });
    const totalAmtCell = card.querySelector('.sal-total-amt');
    if (totalAmtCell) {
      totalAmtCell.textContent = fmtAmt(budget) + ' ' + (totalPct === 100 ? '✓' : `⚠ ${totalPct}%`);
      totalAmtCell.style.color = totalPct === 100 ? 'var(--green)' : 'var(--red)';
    }
  }

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-milestone');
    if (!btn) return;
    const row = btn.closest('tr');
    const card = btn.closest('.ctr-card');
    const ctrId = card?.dataset.ctrId;
    const salId = row?.dataset.salId;
    if (ctrId && salId) {
      const ctr = state.contractors.find(c => c.id === ctrId);
      if (ctr) ctr.sal = ctr.sal.filter(m => m.id !== salId);
    }
    row?.remove();
    if (card) recalcCard(card);
  });

  const msModal       = document.getElementById('milestone-modal');
  const msCtrName     = document.getElementById('ms-ctr-name');
  const msRef         = document.getElementById('ms-ref');
  const msLabel       = document.getElementById('ms-label');
  const msTriggerType = document.getElementById('ms-trigger-type');
  const msTriggerPct  = document.getElementById('ms-trigger-pct');
  const msPct         = document.getElementById('ms-pct');
  const msPctRow      = document.getElementById('ms-pct-row');
  let msTargetCard    = null;

  msTriggerType.addEventListener('change', () => { msPctRow.style.display = msTriggerType.value === 'percent' ? '' : 'none'; });
  msPctRow.style.display = 'none';

  function openMsModal(card) {
    msTargetCard = card;
    msCtrName.textContent = card.querySelector('.ctr-name')?.textContent ?? '';
    msRef.value = ''; msLabel.value = ''; msPct.value = ''; msTriggerPct.value = '';
    msTriggerType.value = 'signing'; msPctRow.style.display = 'none';
    msModal.classList.add('is-open'); msRef.focus();
  }
  function closeMsModal() { msModal.classList.remove('is-open'); msTargetCard = null; }

  document.getElementById('ms-close-btn').addEventListener('click', closeMsModal);
  document.getElementById('ms-cancel-btn').addEventListener('click', closeMsModal);
  msModal.addEventListener('click', e => { if (e.target === msModal) closeMsModal(); });

  document.getElementById('ms-save-btn').addEventListener('click', () => {
    if (!msTargetCard) return;
    const ref = msRef.value.trim() || '—';
    const label = msLabel.value.trim() || 'New Milestone';
    const pct = parseFloat(msPct.value) || 0;
    const ttype = msTriggerType.value;
    const tpct = parseFloat(msTriggerPct.value) || null;
    const triggerTxt = ttype === 'signing' ? 'On signing' : ttype === 'final' ? 'Final works' : `at ${tpct}%`;
    const budget = parseFloat(msTargetCard.dataset.budget ?? '0');
    const ctrId = msTargetCard.dataset.ctrId;
    const ctr = state.contractors.find(c => c.id === ctrId);
    if (ctr) ctr.sal.push({ id: ref, label, triggerType: ttype, triggerPct: tpct, pct });
    const tbody = msTargetCard.querySelector('tbody');
    const totalRow = tbody.querySelector('.sal-total');
    const tr = document.createElement('tr');
    tr.dataset.pct = String(pct);
    tr.dataset.salId = ref;
    tr.innerHTML = `<td class="sal-id">${ref}</td><td>${label}</td><td class="sal-trigger">${triggerTxt}</td><td class="sal-amt">${fmtAmt(budget * pct / 100)}</td><td><button class="btn-icon btn-del-milestone" style="padding:.15rem .4rem;font-size:.7rem;color:var(--red);border-color:#fca5a5">🗑</button></td>`;
    tbody.insertBefore(tr, totalRow);
    recalcCard(msTargetCard);
    closeMsModal();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-milestone');
    if (!btn) return;
    const card = btn.closest('.ctr-card');
    if (card) openMsModal(card);
  });

  const descModal     = document.getElementById('desc-modal');
  const modalIdEl     = document.getElementById('modal-item-id');
  const modalBriefInp = document.getElementById('modal-brief');
  const modalText     = document.getElementById('modal-fulldesc');
  let   descActiveCatId  = null;
  let   descActiveLinkEl = null;

  function openDescModal(catId, id, brief, fullDesc, linkEl) {
    descActiveCatId  = catId;
    descActiveLinkEl = linkEl ?? null;
    modalIdEl.textContent = id;
    modalBriefInp.value   = brief;
    modalText.value       = fullDesc;
    descModal.classList.add('is-open');
    modalBriefInp.focus();
  }
  function closeDescModal() { descModal.classList.remove('is-open'); descActiveCatId = null; descActiveLinkEl = null; }

  document.getElementById('modal-close-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-cancel-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-save-btn').addEventListener('click', () => {
    const itemId  = modalIdEl.textContent;
    const brief   = modalBriefInp.value.trim();
    const fullDesc = modalText.value;
    const item = findItem(descActiveCatId, itemId);
    if (item) { item.brief = brief; item.fullDesc = fullDesc; }
    if (descActiveLinkEl) {
      descActiveLinkEl.dataset.brief    = brief;
      descActiveLinkEl.dataset.fulldesc = fullDesc;
      descActiveLinkEl.innerHTML = brief
        ? brief
        : '<em class="brief-empty">+ add description</em>';
    }
    closeDescModal();
  });
  descModal.addEventListener('click', e => { if (e.target === descModal) closeDescModal(); });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (msModal.classList.contains('is-open'))   { closeMsModal();   return; }
    if (descModal.classList.contains('is-open')) { closeDescModal(); return; }
    if (ctrModal.classList.contains('is-open'))  { closeCtrModal();  return; }
  });

  // ── Contractor modal ──────────────────────────────────────────────────────
  const ctrModal     = document.getElementById('ctr-modal');
  const ctrModalTitle= document.getElementById('ctr-modal-title');
  const ctrIdInp     = document.getElementById('ctr-id-inp');
  const ctrNameInp   = document.getElementById('ctr-name-inp');
  const ctrTradeInp  = document.getElementById('ctr-trade-inp');
  const ctrContactInp= document.getElementById('ctr-contact-inp');
  let   ctrEditId    = null;

  function openCtrModal(ctr) {
    ctrEditId = ctr?.id ?? null;
    ctrModalTitle.textContent = ctr ? 'Edit Contractor' : 'Add Contractor';
    ctrIdInp.value      = ctr?.id      ?? '';
    ctrNameInp.value    = ctr?.name    ?? '';
    ctrTradeInp.value   = ctr?.trade   ?? '';
    ctrContactInp.value = ctr?.contact ?? '';
    ctrIdInp.disabled   = !!ctr;
    ctrModal.classList.add('is-open');
    ctrNameInp.focus();
  }
  function closeCtrModal() { ctrModal.classList.remove('is-open'); ctrEditId = null; }

  document.getElementById('ctr-modal-close').addEventListener('click', closeCtrModal);
  document.getElementById('ctr-cancel-btn').addEventListener('click', closeCtrModal);
  ctrModal.addEventListener('click', e => { if (e.target === ctrModal) closeCtrModal(); });

  document.getElementById('ctr-save-btn').addEventListener('click', () => {
    const id      = ctrIdInp.value.trim();
    const name    = ctrNameInp.value.trim();
    const trade   = ctrTradeInp.value.trim();
    const contact = ctrContactInp.value.trim();
    if (!id || !name) { alert('ID and Name are required.'); return; }

    if (ctrEditId) {
      const ctr = state.contractors.find(c => c.id === ctrEditId);
      if (ctr) { ctr.name = name; ctr.trade = trade; ctr.contact = contact; }
      const card = document.querySelector(`.ctr-card[data-ctr-id="${ctrEditId}"]`);
      if (card) {
        card.querySelector('.ctr-name').textContent    = name;
        card.querySelector('.ctr-trade').textContent   = trade;
        card.querySelector('.ctr-contact').textContent = contact;
      }
    } else {
      if (state.contractors.find(c => c.id === id)) { alert('Contractor ID already exists.'); return; }
      const newCtr = { id, name, trade, contact, sal: [] };
      state.contractors.push(newCtr);
      const grid = document.querySelector('.contractor-grid');
      const div = document.createElement('div');
      div.className = 'card ctr-card';
      div.dataset.budget = '0';
      div.dataset.ctrId  = id;
      div.innerHTML = `
        <div class="ctr-header">
          <div>
            <div class="ctr-name">${name}</div>
            <div class="ctr-trade">${trade}</div>
            <div class="ctr-contact">${contact}</div>
            <div class="ctr-budget">Budget: <strong class="ctr-budget-val">€ 0.00</strong> <span class="auto-tag">auto</span></div>
          </div>
          <div class="ctr-actions">
            <button class="btn-icon btn-edit-ctr" title="Edit">✎</button>
            <button class="btn-icon btn-del-ctr" title="Delete">🗑</button>
          </div>
        </div>
        <table class="sal-table"><thead><tr><th style="width:50px">Ref.</th><th>Milestone</th><th style="width:90px">Trigger</th><th class="right" style="width:115px">Amount (net) <span class="auto-tag">auto</span></th><th style="width:60px"></th></tr></thead>
        <tbody><tr class="sal-total"><td colspan="3" style="text-align:right;color:var(--slate);font-size:.68rem;letter-spacing:.04em">TOTAL</td><td class="sal-amt sal-total-amt" style="color:var(--red);font-weight:700">€ 0.00 ⚠ 0%</td><td></td></tr></tbody></table>
        <div class="sal-add-row"><button class="btn btn-add btn-add-milestone" style="font-size:.7rem;padding:.3rem .7rem">+ Add milestone</button></div>`;
      grid.appendChild(div);
    }
    closeCtrModal();
  });

  // Add contractor button
  document.querySelector('.contractor-grid')?.closest('#tab-contractors')
    ?.querySelector('.btn-add')
    ?.addEventListener('click', () => openCtrModal(null));

  // Edit contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-edit-ctr');
    if (!btn) return;
    const ctrId = btn.closest('.ctr-card')?.dataset.ctrId;
    const ctr   = state.contractors.find(c => c.id === ctrId);
    if (ctr) openCtrModal(ctr);
  });

  // Delete contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-ctr');
    if (!btn) return;
    const card  = btn.closest('.ctr-card');
    const ctrId = card?.dataset.ctrId;
    if (!ctrId || !confirm(`Delete contractor "${ctrId}"?`)) return;
    state.contractors = state.contractors.filter(c => c.id !== ctrId);
    card.remove();
  });

  // ── Brief description click ───────────────────────────────────────────────
  document.addEventListener('click', e => {
    const el = e.target.closest('.brief-link');
    if (!el) return;
    openDescModal(el.dataset.catId, el.dataset.id, el.dataset.brief ?? '', el.dataset.fulldesc ?? '', el);
  });

  // ── Add item / Add extra item ─────────────────────────────────────────────
  function buildItemRow(catId, item) {
    const opts = state.contractors.map(c =>
      `<option value="${c.id}"${item.contractor===c.id?' selected':''}>${c.name}</option>`).join('');
    const qtyAttrs = item.extra
      ? 'disabled placeholder="–" style="color:var(--g3)"'
      : 'placeholder=""';
    return `<tr class="item${item.extra?' extra-row':''}" data-cat-id="${catId}" data-item-id="${item.id}">
      <td class="item-id">${item.id}</td>
      <td style="max-width:220px">
        ${item.extra?'<span class="extra-badge">Extra</span>':''}
        <span class="brief-link" data-id="${item.id}" data-cat-id="${catId}" data-brief="" data-fulldesc="" title="Click to view / edit full description"><em class="brief-empty">+ add description</em></span>
      </td>
      <td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="unit" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.72rem;width:60px">${['m²','m³','lm','unit','lump','kg'].map(u=>`<option${item.unit===u?' selected':''}>${u}</option>`).join('')}</select></td>
      <td class="editable-cell"><input type="number" value="" ${qtyAttrs} data-cat-id="${catId}" data-item-id="${item.id}" data-field="qty" /></td>
      <td class="editable-cell"><input type="number" value="0" step="0.01" data-cat-id="${catId}" data-item-id="${item.id}" data-field="price" /></td>
      <td class="auto-cell auto-cell-budget">${item.extra?'–':'€ 0.00'}</td>
      <td class="editable-cell"><input type="number" value="${item.done||0}" data-cat-id="${catId}" data-item-id="${item.id}" data-field="done" /></td>
      <td class="auto-cell auto-cell-done">€ 0.00</td>
      <td class="auto-bg" style="min-width:90px">${item.extra
        ? '–'
        : '<div class="perc-wrap"><div class="perc-mini"><div class="perc-fill" style="width:0%;background:#cbd5e1"></div></div><span class="perc-num" style="color:#cbd5e1">0%</span></div>'}</td>
      <td class="auto-bg">${item.extra
        ? (item.done > 0 ? '<span class="status-badge status-complete">Complete</span>' : '<span class="status-badge status-pending">Not Started</span>')
        : '<span class="status-badge status-pending">Not Started</span>'}</td>
      <td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="contractor" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.68rem;max-width:120px;width:100%"><option value="">— none —</option>${opts}</select></td>
      <td style="white-space:nowrap"><button class="btn-icon btn-del-item" data-cat-id="${catId}" data-item-id="${item.id}" title="Delete" style="margin-left:.2rem">🗑</button></td>
    </tr>`;
  }

  // ── New Item Modal ────────────────────────────────────────────────────────
  const newItemModal     = document.getElementById('new-item-modal');
  const newItemCatLabel  = document.getElementById('new-item-cat-label');
  const newItemExtra     = document.getElementById('new-item-extra');
  const newItemStatusRow = document.getElementById('new-item-status-row');
  const newItemConfirm   = document.getElementById('new-item-confirm');
  let _newItemCatId = null;

  function itemIdNum(id) { const m = id.match(/\.(\d+)$/); return m ? parseInt(m[1]) : 0; }

  function openNewItemModal(catId, isExtra) {
    _newItemCatId = catId;
    const cat = state.categories.find(c => c.id === catId);
    newItemCatLabel.textContent = cat ? `${cat.id} — ${cat.label}` : catId;
    newItemExtra.checked = isExtra;
    newItemStatusRow.style.display = isExtra ? 'block' : 'none';
    const pending = document.querySelector('input[name="new-item-status"][value="pending"]');
    if (pending) pending.checked = true;
    newItemModal.classList.add('is-open');
  }

  newItemExtra.addEventListener('change', () => {
    newItemStatusRow.style.display = newItemExtra.checked ? 'block' : 'none';
  });

  document.getElementById('new-item-close').addEventListener('click', () => newItemModal.classList.remove('is-open'));
  document.getElementById('new-item-cancel').addEventListener('click', () => newItemModal.classList.remove('is-open'));

  newItemConfirm.addEventListener('click', () => {
    const catId = _newItemCatId;
    const cat   = state.categories.find(c => c.id === catId);
    if (!cat) return;
    const isExtra   = newItemExtra.checked;
    const statusVal = document.querySelector('input[name="new-item-status"]:checked')?.value;
    const done      = (isExtra && statusVal === 'complete') ? 1 : 0;
    const nums      = cat.items.map(i => itemIdNum(i.id));
    const next      = (nums.length ? Math.max(...nums) : 0) + 1;
    const id        = `${catId}.${String(next).padStart(2, '0')}`;
    const item      = { id, brief: '', fullDesc: '', unit: 'm²', qty: 0, price: 0, done, contractor: '', extra: isExtra };
    cat.items.push(item);
    const allItemRows = [...document.querySelectorAll(`tr.item[data-cat-id="${catId}"]`)];
    const rowHtml = buildItemRow(catId, item);
    if (allItemRows.length > 0) allItemRows[allItemRows.length - 1].insertAdjacentHTML('afterend', rowHtml);
    else document.querySelector(`tr.cat-row[data-cat-id="${catId}"]`).insertAdjacentHTML('afterend', rowHtml);
    newItemModal.classList.remove('is-open');
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-item');
    if (!btn) return;
    openNewItemModal(btn.dataset.catId, btn.dataset.extra === 'true');
  });

  // ── Add Category ──────────────────────────────────────────────────────────
  document.querySelector('#tab-works .section-head .btn-add')?.addEventListener('click', () => {
    const id = prompt('Category ID (e.g. I):')?.trim().toUpperCase();
    if (!id) return;
    if (state.categories.find(c => c.id === id)) { alert('Category ID already exists.'); return; }
    const label = prompt('Category label (e.g. Flooring):')?.trim();
    if (!label) return;
    state.categories.push({ id, label, items: [] });
    const grandTotal = document.querySelector('table.works tbody tr.grand-total');
    grandTotal.insertAdjacentHTML('beforebegin', `<tr class="cat-row" data-cat-id="${id}">
      <td colspan="12">
        <span class="cat-badge">${id}</span> ${label}
        <span style="margin-left:.75rem;font-size:.65rem;font-weight:400;color:var(--slate)">Budget: € 0.00 &nbsp;|&nbsp; Done: € 0.00 &nbsp;|&nbsp; 0%</span>
        <span style="float:right;display:flex;gap:.3rem;margin-top:-.1rem">
          <button class="btn btn-add btn-add-item" data-cat-id="${id}" style="font-size:.62rem;padding:.2rem .55rem">+ Add item</button>
          <button class="btn btn-extra btn-add-item" data-cat-id="${id}" data-extra="true" style="font-size:.62rem;padding:.2rem .55rem">+ Add extra item</button>
          <button class="btn-icon btn-del-cat" data-cat-id="${id}" title="Delete category" style="font-size:.72rem;padding:.2rem .45rem;color:var(--red);border-color:#fca5a5">🗑 Delete</button>
        </span>
      </td>
    </tr>
    <tr class="subtotal">
      <td colspan="5" style="text-align:right;padding-right:.75rem;color:var(--slate);font-weight:400;font-size:.68rem">Category ${id} subtotal</td>
      <td style="text-align:right;font-family:monospace">€ 0.00</td><td></td>
      <td style="text-align:right;font-family:monospace;color:var(--navy)">€ 0.00</td>
      <td colspan="4"></td>
    </tr>`);
  });

</script>
</body>
</html>
