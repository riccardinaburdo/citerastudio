              <th style="width:55px">Unit</th>
              <th class="right" style="width:90px">Contracted Qty</th>
              <th class="right" style="width:120px">Unit Price<br/><span style="font-size:.5rem;opacity:.65">net ex. VAT</span></th>
              <th class="right" style="width:120px">Budget<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th class="right" style="width:90px">Variation<br/><span style="font-size:.5rem;opacity:.65">+/– qty</span></th>
              <th class="right" style="width:120px">Revised Budget<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th class="right" style="width:80px">Done Qty</th>
              <th class="right" style="width:150px">Value Done<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:105px">Progress<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:72px">Status<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:130px">Contractor</th>
              <th style="width:62px"></th>
            </tr>
          </thead>
          <tbody>
            {enrichedCats.map(cat => {
              const catBudget   = cat.items.filter((i:any) => !i.extra).reduce((s:number,i:any) => s+i.budget,0);
              const catRevised  = cat.items.reduce((s:number,i:any) => s+i.revisedBudget,0); // direct sum of Revised Budget column
              const catVariation= catRevised - catBudget;                                     // savings/extra = difference
              const catDone     = cat.items.reduce((s:number,i:any) => s+i.valueDone,0);     // direct sum of Value Done column
              const catPerc     = catRevised > 0 ? catDone/catRevised*100 : 0;
              return (<>
                <tr class="cat-row" data-cat-id={cat.id}>
                  <td colspan="14">
                    <span class="cat-badge">{cat.id}</span>
                    <span class="cat-chevron" style="display:inline-block;margin-right:.3rem;font-size:.65rem;transition:transform .2s;vertical-align:middle">▾</span>
                    {cat.label}
                    <span style="margin-left:.75rem;font-size:.65rem;font-weight:400;color:var(--slate)">
                      Budget: {fmt(catBudget)}
                      {catVariation !== 0 && <span style={catVariation < 0 ? 'color:#16a34a' : 'color:var(--red)'}> {catVariation > 0 ? '+' : ''}{fmt(catVariation)}</span>}
                      {catVariation !== 0 && <> → <strong>{fmt(catRevised)}</strong></>}
                      &nbsp;|&nbsp; Done: {fmt(catDone)} &nbsp;|&nbsp; {catPerc.toFixed(0)}%
                    </span>
                    <span style="float:right;display:flex;gap:.3rem;margin-top:-.1rem">
                      <button class="btn btn-add btn-add-item" data-cat-id={cat.id} style="font-size:.62rem;padding:.2rem .55rem">+ Add item</button>
                      <button class="btn btn-extra btn-add-item" data-cat-id={cat.id} data-extra="true" style="font-size:.62rem;padding:.2rem .55rem">+ Add extra item</button>
                      <button class="btn-icon btn-del-cat" data-cat-id={cat.id} title="Delete category" style="font-size:.72rem;padding:.2rem .45rem;color:var(--red);border-color:#fca5a5">🗑 Delete</button>
                    </span>
                  </td>
                </tr>
                {cat.items.map((item:any) => {
                  const overrun        = item.overrun ?? false;
                  const forceComplete  = item.forceComplete ?? (!!item.complete && !overrun);
                  const revisedIsZero  = !(item.revisedBudget > 0);
                  const isNotExecuted  = revisedIsZero && (item.budget > 0);
                  const hasNoRevised   = revisedIsZero && !(item.budget > 0);
                  const extraShowDash  = item.extra && revisedIsZero;
                  const percNull       = item.perc === null;
                  const percVal        = item.perc ?? 0;
                  const isComplete     = forceComplete || percVal > 99.9;
                  const isInProgress   = !isComplete && percVal > 0;
                  const pColor  = overrun ? '#dc2626' : forceComplete ? '#22c55e' : percVal > 99.9 ? '#22c55e' : percVal > 0 ? '#f59e0b' : '#cbd5e1';
                  const dispPerc = forceComplete ? 100 : percVal;
                  const barW    = Math.min(dispPerc, 100);
                  return (
                    <tr class={`item${item.extra ? ' extra-row' : ''}`} data-cat-id={cat.id} data-item-id={item.id}>
                      <td class="item-id">{item.id}</td>
                      <td style="max-width:220px">
                        {item.extra && <span class="extra-badge">Extra</span>}
                        <span class="brief-link" data-id={item.id} data-cat-id={cat.id} data-brief={item.brief} data-fulldesc={item.fullDesc ?? ''} title="Click to view / edit full description">{item.brief || <em class="brief-empty">+ add description</em>}</span>
                      </td>
                      <td class="edit-col">
                        <select data-cat-id={cat.id} data-item-id={item.id} data-field="unit" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.72rem;width:60px">
                          {['m²','m³','lm','unit','lump','kg'].map((u:string) => <option selected={item.unit===u}>{u}</option>)}
                        </select>
                      </td>
                      <td class={item.extra ? 'auto-cell' : 'editable-cell'}>
                        {item.extra
                          ? <span style="color:var(--g3)">–</span>
                          : <input type="number" value={item.qty ?? ''} placeholder="0" data-cat-id={cat.id} data-item-id={item.id} data-field="qty" />}
                      </td>
                      <td class="editable-cell">
                        <input type="number" value={item.price} step="0.01" data-cat-id={cat.id} data-item-id={item.id} data-field="price" />
                      </td>
                      <td class="auto-cell auto-cell-budget">{item.extra ? <span style="color:var(--g3)">–</span> : fmt(item.budget)}</td>
                      <td class="editable-cell">
                        <input type="number" step="any" value={item.variation || ''} placeholder="0"
                          data-cat-id={cat.id} data-item-id={item.id} data-field="variation"
                          style={`text-align:right;width:80px;${(item.variation ?? 0) < 0 ? 'color:#16a34a;font-weight:600' : (item.variation ?? 0) > 0 ? 'color:var(--red);font-weight:600' : 'color:var(--g3)'}`} />
                      </td>
                      <td class="auto-cell auto-cell-revised" style={(item.variationAmt ?? 0) < 0 ? 'color:#16a34a' : (item.variationAmt ?? 0) > 0 ? 'color:var(--red)' : ''}>{extraShowDash ? <span style="color:var(--g3)">–</span> : fmt(item.revisedBudget)}</td>
                      <td class="editable-cell" style={overrun ? 'color:var(--red)' : ''}>
                        <input type="number" value={item.done} style={overrun ? 'color:var(--red);font-weight:700' : ''} data-cat-id={cat.id} data-item-id={item.id} data-field="done" />
                        {overrun && <span class="overrun-badge">↑</span>}
                      </td>
                      <td class="auto-cell auto-cell-done">{fmt(item.valueDone)}</td>
                      <td class="auto-bg" style="min-width:90px">
                        <div class="perc-wrap" style={percNull ? 'display:none' : ''}>
                          <div class="perc-mini"><div class="perc-fill" style={`width:${barW}%;background:${pColor}`}></div></div>
                          <span class="perc-num" style={`color:${pColor}`}>{Math.round(dispPerc)}%</span>
                        </div>
                        {percNull && <span class="perc-null" style="color:var(--g3)">–</span>}
                      </td>
                      <td class="auto-bg">
                        {overrun
                          ? <span class="status-badge status-overrun">Overrun</span>
                          : isNotExecuted
                            ? <span class="status-badge status-not-executed">Not Executed</span>
                            : hasNoRevised
                              ? <span style="color:var(--g3)">–</span>
                              : isComplete
                                ? <span class="status-badge status-complete is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to unmark completion">Complete</span>
                                : isInProgress
                                  ? <span class="status-badge status-progress is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to mark as complete">In Progress</span>
                                  : <span class="status-badge status-pending is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to mark as complete">Not Started</span>
                        }
                      </td>
                      <td class="edit-col">
                        <select data-cat-id={cat.id} data-item-id={item.id} data-field="contractor" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.68rem;max-width:120px;width:100%">
                          <option value="">— none —</option>
                          {contractors.map(c => <option value={c.id} selected={item.contractor===c.id}>{c.name}</option>)}
                        </select>
                      </td>
                      <td style="white-space:nowrap">
                        <button class="btn-icon btn-del-item" data-cat-id={cat.id} data-item-id={item.id} title="Delete" style="margin-left:.2rem">🗑</button>
                      </td>
                    </tr>
                  );
                })}
                <tr class="subtotal" data-cat-id={cat.id}>
                  <td colspan="5" style="text-align:right;padding-right:.75rem;color:var(--slate);font-weight:400;font-size:.68rem">Category {cat.id} subtotal</td>
                  <td style="text-align:right;font-family:monospace">{fmt(catBudget)}</td>
                  <td style="text-align:right;font-family:monospace;color:var(--g3)">–</td>
                  <td style="text-align:right;font-family:monospace;font-weight:700">{fmt(catRevised)}</td>
                  <td></td>
                  <td style="text-align:right;font-family:monospace;color:var(--navy)">{fmt(catDone)}</td>
                  <td colspan="4"></td>
                </tr>
                {catVariation !== 0 && (
                  <tr class="cat-var-row" data-cat-id={cat.id}>
                    <td colspan="7" style="text-align:right;padding-right:.4rem;font-size:.65rem;color:var(--slate);font-style:italic">{catVariation < 0 ? 'Savings' : 'Additional cost'}</td>
                    <td class="cat-var-amt" style={`text-align:right;font-family:monospace;font-weight:700;${catVariation < 0 ? 'color:#16a34a' : 'color:var(--red)'}`}>
                      {catVariation > 0 ? '+' : ''}{fmt(catVariation)}
                    </td>
                    <td colspan="6"></td>
                  </tr>
                )}
              </>);
            })}
            {(() => {
              const allItems     = enrichedCats.flatMap((c:any)=>c.items);
              const gtOriginal   = allItems.filter((i:any)=>!i.extra).reduce((s:number,i:any)=>s+i.budget,0);
              const gtRevised    = allItems.reduce((s:number,i:any)=>s+i.revisedBudget,0);
              const gtVariation  = gtRevised - gtOriginal;
              const gtDone       = allItems.reduce((s:number,i:any)=>s+i.valueDone,0);
              return (
                <tr class="grand-total">
                  <td colspan="5" style="text-align:right;padding-right:.75rem;letter-spacing:.04em;font-size:.72rem">TOTAL <span style="opacity:.55;font-weight:400">(net ex. VAT)</span></td>
                  <td style="text-align:right;font-family:monospace">{fmt(gtOriginal)}</td>
                  <td style="text-align:right;font-family:monospace;opacity:.5">–</td>
                  <td style="text-align:right;font-family:monospace;font-weight:700">{fmt(gtRevised)}</td>
                  <td></td>
                  <td style="text-align:right;font-family:monospace">{fmt(gtDone)}</td>
                  <td colspan="4"></td>
                </tr>
              );
            })()}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

