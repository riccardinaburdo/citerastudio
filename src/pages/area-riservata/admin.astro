                      <input class="sal-trigger-date-input" type="date" value={m.triggerDate ?? ''} style={`padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType !== 'date' ? 'display:none' : ''}`} />
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                      <span style="font-size:.68rem;color:var(--g3);margin-right:.2rem">€</span>
                      <input class="sal-amt-input" type="number" min="0" step="0.01" value={(budget > 0 ? budget * m.pct / 100 : (m.fixedAmt ?? 0)).toFixed(2)} style="width:88px;padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.75rem;font-family:monospace;text-align:right" />
