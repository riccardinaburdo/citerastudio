          const items = cat.items.filter((i: any) => !i.extra && i.contractor === c.id);
          if (items.length === 0) return null;
          const catTotal = items.reduce((s: number, i: any) => {
            const q = parseFloat(i.qty) || 0;
            const v = parseFloat((i as any).variation) || 0;
            const p = parseFloat(i.price) || 0;
            return s + (q + v) * p;
          }, 0);
          return { id: cat.id, label: cat.label, total: catTotal, count: items.length };
