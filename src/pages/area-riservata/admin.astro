<script define:vars={{ projectJson, projectId }}>
  let state = JSON.parse(projectJson);
  const fmtAmt = n => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits:2, maximumFractionDigits:2 });

  // Collapsible category rows
  document.querySelectorAll('tr.cat-row').forEach(catRow => {
    catRow.addEventListener('click', e => {
      // Don't collapse when clicking buttons inside the row
      if (e.target.closest('button')) return;
      const catId = catRow.getAttribute('data-cat-id');
      const chevron = catRow.querySelector('.cat-chevron');
      const collapsed = catRow.dataset.collapsed === 'true';
      const newState = !collapsed;
      catRow.dataset.collapsed = newState;
      if (chevron) chevron.style.transform = newState ? 'rotate(-90deg)' : '';
      document.querySelectorAll(`tr.item[data-cat-id="${catId}"], tr.subtotal[data-cat-id="${catId}"]`).forEach(row => {
        row.style.display = newState ? 'none' : '';
      });
    });
  });

  // Remember last project across sessions
  if (projectId && projectId !== 'default') {
    localStorage.setItem('lastProjectId', projectId);
  } else if (!new URLSearchParams(location.search).has('p')) {
    const last = localStorage.getItem('lastProjectId');
    if (last) { location.replace(`?p=${encodeURIComponent(last)}`); }
  }

  function findItem(catId, itemId) {
    const cat = state.categories.find(c => c.id === catId);
    return cat ? cat.items.find(i => i.id === itemId) : null;
  }

  const saveAllBtn = document.getElementById('save-all-btn');
  const saveStatus = document.getElementById('save-status');

  async function saveAll() {
    // Stamp updated date to today
    const today = new Date().toISOString().slice(0, 10);
    state.info.updated = today;
    const updatedField = document.querySelector('[data-info="updated"]');
    if (updatedField) updatedField.value = today;
    // Flush any in-progress DOM edits into state before serialising
    document.querySelectorAll('.ctr-card, .tec-card').forEach(card => syncSalFromCard(card));
    saveAllBtn.disabled = true;
    saveStatus.textContent = 'Saving…';
    saveStatus.style.color = 'rgba(255,255,255,.7)';
    try {
      const res = await fetch('/api/area-riservata/project', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(state)
      });
      const json = await res.json();
      if (!json.ok) throw new Error(json.error ?? 'Unknown error');
      saveStatus.textContent = 'Saved ✓';
      saveStatus.style.color = '#22c55e';
      setTimeout(() => { saveStatus.textContent = ''; }, 3000);
    } catch (err) {
      saveStatus.textContent = 'Error: ' + err.message;
      saveStatus.style.color = '#fca5a5';
    } finally {
      saveAllBtn.disabled = false;
    }
  }

  saveAllBtn.addEventListener('click', saveAll);
  document.querySelectorAll('.save-trigger').forEach(btn => btn.addEventListener('click', saveAll));

  // ── Project switcher dropdown ─────────────────────────────────────────────
  const switcherDrop = document.getElementById('proj-switcher-drop');
  document.getElementById('proj-switcher-btn').addEventListener('click', e => {
    e.stopPropagation();
    switcherDrop.classList.toggle('is-open');
  });
  document.addEventListener('click', e => {
    // Close switcher if clicking outside
    if (!switcherDrop.contains(e.target)) switcherDrop.classList.remove('is-open');
    // Navigate on any [data-goto] button
    const btn = e.target.closest('[data-goto]');
    if (btn) { window.location.href = btn.dataset.goto; }
  });

  // Delete project
  document.addEventListener('click', async e => {
    const btn = e.target.closest('.btn-del-project');
    if (!btn) return;
    const id          = btn.dataset.projId;
    const name        = btn.dataset.projName;
    const isCurrent   = btn.dataset.isCurrent === 'true';
    const totalProjects = parseInt(btn.dataset.totalProjects ?? '1', 10);
    let warning = `Delete project "${name}"?\n\nThis cannot be undone.`;
    if (totalProjects === 1) {
      warning = `⚠️ WARNING: "${name}" is the only project.\n\nDeleting it will leave the dashboard empty.\n\nThis cannot be undone. Are you sure?`;
    } else if (isCurrent) {
      warning = `⚠️ WARNING: "${name}" is currently open.\n\nDeleting it will redirect you to another project.\n\nThis cannot be undone. Are you sure?`;
    }
    if (!confirm(warning)) return;
    btn.disabled = true; btn.textContent = 'Deleting…';
    const res  = await fetch(`/api/area-riservata/projects?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    const json = await res.json();
    if (json.ok) {
      if (isCurrent) {
        window.location.href = '/area-riservata/admin';
      } else {
        btn.closest('.proj-card').remove();
      }
    } else {
      alert('Error: ' + json.error);
      btn.disabled = false;
      btn.textContent = 'Delete';
    }
  });

  document.addEventListener('click', async e => {
    const btn = e.target.closest('.btn-dup-project');
    if (!btn) return;
    const sourceId   = btn.dataset.projId;
    const sourceName = btn.dataset.projName;
    const name = prompt(`Duplicate "${sourceName}"\n\nNew project name:`, `${sourceName} (copy)`)?.trim();
    if (!name) return;
    btn.disabled = true; btn.textContent = 'Duplicating…';
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sourceId, name })
    });
    const json = await res.json();
    if (json.ok) {
      window.location.href = `/area-riservata/admin?p=${json.id}`;
    } else {
      alert('Error: ' + json.error);
      btn.disabled = false; btn.textContent = '⎘ Duplicate';
    }
  });

  document.getElementById('proj-drop-new').addEventListener('click', async () => {
    switcherDrop.classList.remove('is-open');
    const name = prompt('Project name:')?.trim();
    if (!name) return;
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else alert('Error: ' + json.error);
  });

  const tabs = document.querySelectorAll('.tab-btn');
  const panels = {
    projects:    document.getElementById('tab-projects'),
    project:     document.getElementById('tab-project'),
    contractors: document.getElementById('tab-contractors'),
    technicians: document.getElementById('tab-technicians'),
    works:       document.getElementById('tab-works'),
  };
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      Object.entries(panels).forEach(([k, el]) => { if (el) el.hidden = (k !== btn.dataset.tab); });
    });
  });

  // New Project button (in Projects tab) — delegates to the same handler
  document.getElementById('btn-new-project').addEventListener('click', () =>
    document.getElementById('proj-drop-new').click());

  // From template button
  document.getElementById('btn-from-template').addEventListener('click', async () => {
    const name = prompt('Project name (will be pre-filled with example data):')?.trim();
    if (!name) return;
    const btn = document.getElementById('btn-from-template');
    btn.disabled = true; btn.textContent = 'Creating…';
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, template: true })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else { alert('Error: ' + json.error); btn.disabled = false; btn.textContent = '↺ From template'; }
  });

  document.querySelectorAll('[data-info]').forEach(el => {
    const handler = () => {
      const field = el.dataset.info;
      if (el.type === 'checkbox')     state.info[field] = el.checked;
      else if (el.type === 'number')  state.info[field] = parseFloat(el.value) || 0;
      else                            state.info[field] = el.value;
    };
    el.addEventListener('input', handler);
    if (el.type === 'checkbox') el.addEventListener('change', handler);
  });

  // ── Init optional arrays ─────────────────────────────────────────────────
  if (!state.updates)     state.updates = [];
  if (!state.technicians) state.technicians = [];

  function syncUpdatesFromDOM() {
    const rows = document.querySelectorAll('#updates-admin-tbody tr[data-update-num]');
    state.updates = Array.from(rows).map(row => ({
      num:  parseInt(row.dataset.updateNum),
      date: row.querySelector('.upd-date-input').value,
      note: row.querySelector('.upd-note-input').value,
    }));
  }

  function buildUpdateRow(num, date, note) {
    const tr = document.createElement('tr');
    tr.dataset.updateNum = num;
    tr.innerHTML = [
      `<td><span class="upd-num-badge">#${num}</span></td>`,
      `<td><input type="date" class="upd-date-input" value="${date}" style="width:120px;padding:.3rem .4rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem" /></td>`,
      `<td><textarea class="upd-note-input" rows="2" style="width:100%;padding:.3rem .5rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem;resize:vertical;font-family:var(--sans)">${note}</textarea></td>`,
      `<td><button class="btn-icon btn-del-update" style="color:var(--red);border-color:#fca5a5" title="Delete">🗑</button></td>`,
    ].join('');
    return tr;
  }

  document.getElementById('btn-add-update').addEventListener('click', () => {
    const nextNum = (state.info.updateNum || 0) + 1;
    state.info.updateNum = nextNum;
    const numField = document.getElementById('update-num-field');
    if (numField) numField.value = nextNum;

    const today = new Date().toISOString().slice(0, 10);
    if (!state.updates) state.updates = [];
    state.updates.unshift({ num: nextNum, date: today, note: '' });

    const tbody = document.getElementById('updates-admin-tbody');
    const emptyMsg = document.getElementById('updates-empty-msg');
    if (emptyMsg) emptyMsg.remove();
    tbody.prepend(buildUpdateRow(nextNum, today, ''));
    tbody.querySelector('.upd-note-input')?.focus();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-update');
    if (!btn) return;
    const row = btn.closest('tr[data-update-num]');
    if (!row) return;
    if (!confirm('Delete this progress update?')) return;
    const num = parseInt(row.dataset.updateNum);
    state.updates = (state.updates || []).filter(u => u.num !== num);
    row.remove();
  });

  document.addEventListener('input', e => {
    if (e.target.closest('#updates-admin-tbody')) {
      syncUpdatesFromDOM();
      return;
    }
  });

  document.addEventListener('input', e => {
    const el = e.target;
    const { catId, itemId, field } = el.dataset;
    if (!catId || !itemId || !field) return;
    const item = findItem(catId, itemId);
    if (!item) return;
    const newVal = el.type === 'number' ? (parseFloat(el.value) ?? 0) || 0 : el.type === 'checkbox' ? el.checked : el.value;
    item[field] = newVal;
    const row = el.closest('tr');
    if (field === 'contractor') { recalcCtrBudgets(); return; }
    if (!row || !(field === 'qty' || field === 'price' || field === 'done' || field === 'variation')) return;

    const qty          = item.extra ? 0 : (field === 'qty' ? (parseFloat(newVal) || 0) : (parseFloat(item.qty) || 0));
    const price        = parseFloat(item.price) || 0;
    const variationQty = field === 'variation' ? (parseFloat(newVal) || 0) : (parseFloat(item.variation) || 0);
    const budget       = item.extra ? 0 : qty * price;
    const variationAmt = variationQty * price;
    const revised      = item.extra ? variationAmt : (qty + variationQty) * price;
    const rawDone      = (parseFloat(field === 'done' ? newVal : item.done) || 0) * price;
    const agreedQty    = item.extra ? variationQty : qty;
    const doneQty      = parseFloat(field === 'done' ? newVal : item.done) || 0;
    const overrun      = revised > 0 && doneQty > agreedQty;
    const forceComplete = !!item.complete && !overrun;
    const valDone      = forceComplete ? revised : rawDone;
    const percActual   = revised > 0 ? (rawDone / revised) * 100 : 0;
    const dispPerc     = forceComplete ? 100 : percActual;
    const barW         = Math.min(dispPerc, 100);
    const pColor       = overrun ? '#dc2626' : forceComplete ? '#22c55e' : percActual >= 100 ? '#22c55e' : percActual > 0 ? '#f59e0b' : '#cbd5e1';

    // Auto cells
    const bCell = row.querySelector('.auto-cell-budget');
    const rCell = row.querySelector('.auto-cell-revised');
    const dCell = row.querySelector('.auto-cell-done');
    if (bCell) { bCell.textContent = item.extra ? '–' : fmtAmt(budget); }
    if (rCell) {
      rCell.textContent = (item.extra && revised === 0) ? '–' : fmtAmt(revised);
      rCell.style.color = variationAmt < 0 ? '#16a34a' : variationAmt > 0 ? '#dc2626' : '';
    }
    if (dCell) dCell.textContent = fmtAmt(valDone);
    if (field === 'variation') {
      el.style.color = variationQty < 0 ? '#16a34a' : variationQty > 0 ? '#dc2626' : 'var(--g3)';
      el.style.fontWeight = variationQty !== 0 ? '600' : '';
    }

    // Done cell — overrun color + badge
    const doneTd  = row.querySelector('[data-field="done"]')?.closest('td');
    if (doneTd) {
      const inp = doneTd.querySelector('input');
      if (inp) inp.style.color = overrun ? 'var(--red)' : '';
      let badge = doneTd.querySelector('.overrun-badge');
      if (overrun && !badge) {
        const s = document.createElement('span'); s.className = 'overrun-badge'; s.textContent = '↑';
        doneTd.appendChild(s);
      } else if (!overrun && badge) { badge.remove(); }
    }

    // Auto-reset complete flag if done < agreedQty (stale flag)
    if (item.complete && doneQty < agreedQty && !overrun && revised > 0) {
      item.complete = false;
    }
    const forceCompleteActual = !!item.complete && !overrun && revised > 0;
    const dispPercFinal = forceCompleteActual ? 100 : percActual;
    const barWFinal = Math.min(dispPercFinal, 100);
    const pColorFinal = overrun ? '#dc2626' : forceCompleteActual ? '#22c55e' : percActual >= 100 ? '#22c55e' : percActual > 0 ? '#f59e0b' : '#cbd5e1';

    // Progress bar
    const percWrap = row.querySelector('.perc-wrap');
    const percNull = row.querySelector('.perc-null');
    if (revised > 0) {
      if (percWrap) { percWrap.style.display = ''; }
      if (percNull) { percNull.style.display = 'none'; }
    } else {
      if (percWrap) { percWrap.style.display = 'none'; }
      if (percNull) { percNull.style.display = ''; }
    }
    if (percWrap) {
      const fill = percWrap.querySelector('.perc-fill');
      const num  = percWrap.querySelector('.perc-num');
      if (fill) { fill.style.width = `${barWFinal}%`; fill.style.background = pColorFinal; }
      if (num)  { num.textContent = `${Math.round(dispPercFinal)}%`; num.style.color = pColorFinal; }
    }

    // Status badge
    const statusSpan = row.querySelector('.status-badge');
    if (statusSpan) {
      const notExecuted = revised <= 0 && budget > 0;
      const noRevised   = revised <= 0 && budget <= 0;
      if (overrun)                          { statusSpan.className = 'status-badge status-overrun';      statusSpan.textContent = 'Overrun'; }
      else if (notExecuted)                 { statusSpan.className = 'status-badge status-not-executed'; statusSpan.textContent = 'Not Executed'; }
      else if (noRevised)                           { statusSpan.className = ''; statusSpan.textContent = '–'; }
      else if (forceCompleteActual || percActual >= 100) { statusSpan.className = 'status-badge status-complete is-toggleable'; statusSpan.textContent = 'Complete'; statusSpan.dataset.catId = catId; statusSpan.dataset.itemId = itemId; }
      else if (percActual > 0)                      { statusSpan.className = 'status-badge status-progress is-toggleable'; statusSpan.textContent = 'In Progress'; statusSpan.dataset.catId = catId; statusSpan.dataset.itemId = itemId; }
      else                                          { statusSpan.className = 'status-badge status-pending is-toggleable';  statusSpan.textContent = 'Not Started'; statusSpan.dataset.catId = catId; statusSpan.dataset.itemId = itemId; }
    }

    // Recalculate subtotal row for this category
    recalcSubtotal(catId);
    recalcCtrBudgets();
  });

  // ── Recalculate category subtotal row ──────────────────────────────────
  function recalcSubtotal(catId) {
    const tbody = document.querySelector('table.works tbody');
    if (!tbody) return;
    const cat = state.categories.find(c => c.id === catId);
    if (!cat) return;

    // Compute totals directly from state (same logic as server-side enrich)
    let sumBudget = 0, sumRevised = 0, sumDone = 0;
    for (const item of cat.items) {
      const qty         = item.extra ? 0 : (parseFloat(item.qty) || 0);
      const price       = parseFloat(item.price) || 0;
      const variationQty= parseFloat(item.variation) || 0;
      const budget      = item.extra ? 0 : qty * price;
      const variationAmt= variationQty * price;
      const revised     = item.extra ? variationAmt : (qty + variationQty) * price;
      const rawDone     = (parseFloat(item.done) || 0) * price;
      const agreedQty   = item.extra ? variationQty : qty;
      const overrun     = revised > 0 && (parseFloat(item.done)||0) > agreedQty;
      const forceComplete = !!item.complete && !overrun;
      const valueDone   = forceComplete ? revised : rawDone;
      if (!item.extra) sumBudget += budget;
      sumRevised += revised;
      sumDone    += valueDone;
    }
    const variation = sumRevised - sumBudget;

    // Update subtotal row cells
    const subRow = tbody.querySelector(`tr.subtotal[data-cat-id="${catId}"]`);
    if (subRow) {
      const tds = subRow.querySelectorAll('td');
      // td[0]=label(colspan5), td[1]=budget, td[2]=variation(–), td[3]=revised, td[4]=done(empty), td[5]=valueDone
      if (tds[1]) tds[1].textContent = fmtAmt(sumBudget);
      if (tds[3]) tds[3].textContent = fmtAmt(sumRevised);
      if (tds[5]) tds[5].textContent = fmtAmt(sumDone);
    }

    // Update or insert variation row
    let varRow = tbody.querySelector(`tr.cat-var-row[data-cat-id="${catId}"]`);
    if (variation !== 0) {
      const label = variation < 0 ? 'Savings' : 'Additional cost';
      const color = variation < 0 ? '#16a34a' : 'var(--red)';
      const sign  = variation > 0 ? '+' : '';
      if (!varRow) {
        varRow = document.createElement('tr');
        varRow.className = 'cat-var-row';
        varRow.dataset.catId = catId;
        varRow.innerHTML = `<td colspan="7" style="text-align:right;padding-right:.4rem;font-size:.65rem;color:var(--slate);font-style:italic"></td><td class="cat-var-amt" style="text-align:right;font-family:monospace;font-weight:700;"></td><td colspan="6"></td>`;
        subRow?.insertAdjacentElement('afterend', varRow);
      }
      varRow.querySelector('td:first-child').textContent = label;
      const amtTd = varRow.querySelector('.cat-var-amt');
      if (amtTd) { amtTd.textContent = sign + fmtAmt(variation); amtTd.style.color = color; }
    } else if (varRow) {
      varRow.remove();
    }

    // Update category header summary
    const catRow = tbody.querySelector(`tr.cat-row[data-cat-id="${catId}"]`);
    if (catRow) {
      const span = catRow.querySelector('td > span[style*="color:var(--slate)"]') || catRow.querySelector('td span.cat-summary');
      if (span) {
        let html = `Budget: ${fmtAmt(sumBudget)}`;
        if (variation !== 0) {
          const col = variation < 0 ? '#16a34a' : '#dc2626';
          const sign = variation > 0 ? '+' : '';
          html += ` <span style="color:${col}">${sign}${fmtAmt(variation)}</span> → <strong>${fmtAmt(sumRevised)}</strong>`;
        }
        html += ` &nbsp;|&nbsp; Done: ${fmtAmt(sumDone)} &nbsp;|&nbsp; ${sumRevised > 0 ? (sumDone/sumRevised*100).toFixed(0) : 0}%`;
        span.innerHTML = html;
      }
    }

    // Recalculate grand total
    recalcGrandTotal();
  }

  function recalcGrandTotal() {
    let gtBudget = 0, gtRevised = 0, gtDone = 0;
    for (const cat of state.categories) {
      for (const item of cat.items) {
        const qty         = item.extra ? 0 : (parseFloat(item.qty) || 0);
        const price       = parseFloat(item.price) || 0;
        const variationQty= parseFloat(item.variation) || 0;
        const budget      = item.extra ? 0 : qty * price;
        const variationAmt= variationQty * price;
        const revised     = item.extra ? variationAmt : (qty + variationQty) * price;
        const rawDone     = (parseFloat(item.done) || 0) * price;
        const overrun     = !item.extra && (parseFloat(item.done)||0) > qty;
        const forceComplete = !!item.complete && !overrun && !item.extra;
        const valueDone   = forceComplete ? revised : rawDone;
        if (!item.extra) gtBudget += budget;
        gtRevised += revised;
        gtDone    += valueDone;
      }
    }
    const gtVariation = gtRevised - gtBudget;
    const gtRow = document.querySelector('table.works tbody tr.grand-total');
    if (gtRow) {
      const tds = gtRow.querySelectorAll('td');
      if (tds[1]) tds[1].textContent = fmtAmt(gtBudget);
      if (tds[3]) tds[3].textContent = fmtAmt(gtRevised);
      if (tds[5]) tds[5].textContent = fmtAmt(gtDone);
    }
  }

  // ── Recalculate contractor budgets ────────────────────────────────────
  function recalcCtrBudgets() {
    const budgets = {};
    for (const cat of state.categories) {
      for (const item of cat.items) {
        if (item.extra || !item.contractor) continue;
        const qty      = parseFloat(item.qty) || 0;
        const varQty   = parseFloat(item.variation) || 0;
        const price    = parseFloat(item.price) || 0;
        const revised  = (qty + varQty) * price;
        budgets[item.contractor] = (budgets[item.contractor] || 0) + revised;
      }
    }
    document.querySelectorAll('.ctr-card[data-ctr-id]').forEach(card => {
      const ctrId = card.dataset.ctrId;
      const budget = budgets[ctrId] || 0;
      card.dataset.budget = budget.toFixed(2);
      const val = card.querySelector('.ctr-budget-val');
      if (val) val.textContent = fmtAmt(budget);
      // Update SAL milestone amount inputs
      card.querySelectorAll('tr:not(.sal-total) .sal-pct-input, tr:not(.sal-total) .sal-amt-input').forEach(inp => {
        if (inp.classList.contains('sal-amt-input')) {
          const pctInput = inp.closest('tr')?.querySelector('.sal-pct-input');
          const pct = parseFloat(pctInput?.value) || 0;
          if (budget > 0) inp.value = (budget * pct / 100).toFixed(2);
        }
      });
      // Update SAL total row
      const totalRow = card.querySelector('tr.sal-total');
      if (totalRow) {
        const totalPct = Array.from(card.querySelectorAll('.sal-pct-input')).reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
        const totalAmt = budget > 0 ? budget * totalPct / 100 : Array.from(card.querySelectorAll('.sal-amt-input')).reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
        const tds = totalRow.querySelectorAll('td');
        if (tds[3]) tds[3].textContent = '€ ' + totalAmt.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (tds[4]) tds[4].textContent = totalPct.toFixed(1) + '%';
      }
    });
  }

  // ── Toggle complete flag ────────────────────────────────────────────────
  document.addEventListener('click', e => {
    const badge = e.target.closest('.status-badge.is-toggleable');
    if (!badge) return;
    const { catId, itemId } = badge.dataset;
    if (!catId || !itemId) return;
    const item = findItem(catId, itemId);
    if (!item || item.extra) return;
    item.complete = !item.complete;
    const row = badge.closest('tr');
    const overrun = !item.extra && (item.done || 0) > (item.qty || 0);
    const budget  = (item.qty || 0) * (item.price || 0);
    const valDone = (item.done || 0) * (item.price || 0);
    const perc    = budget > 0 ? valDone / budget * 100 : 0;
    const force   = item.complete && !overrun;
    const pColor  = overrun ? '#dc2626' : force ? '#22c55e' : perc >= 100 ? '#22c55e' : perc > 0 ? '#f59e0b' : '#cbd5e1';
    // Update badge
    if (force || perc >= 100) { badge.className = 'status-badge status-complete is-toggleable'; badge.textContent = 'Complete'; badge.title = 'Click to unmark completion'; }
    else if (perc > 0)        { badge.className = 'status-badge status-progress is-toggleable'; badge.textContent = 'In Progress'; badge.title = 'Click to mark as complete'; }
    else                      { badge.className = 'status-badge status-pending is-toggleable';  badge.textContent = 'Not Started'; badge.title = 'Click to mark as complete'; }
    // Update progress bar color
    if (row) {
      const fill = row.querySelector('.perc-fill');
      const num  = row.querySelector('.perc-num');
      if (fill) fill.style.background = pColor;
      if (num)  num.style.color = pColor;
    }
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-item');
    if (!btn) return;
    const { catId, itemId } = btn.dataset;
    const item = state.categories.find(c => c.id === catId)?.items.find(i => i.id === itemId);
    const label = item?.brief ? `"${item.brief}"` : `item ${itemId}`;
    if (!confirm(`Delete ${label}?\n\nThis cannot be undone.`)) return;
    const cat = state.categories.find(c => c.id === catId);
    if (cat) cat.items = cat.items.filter(i => i.id !== itemId);
    btn.closest('tr')?.remove();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-cat');
    if (!btn) return;
    const { catId } = btn.dataset;
    state.categories = state.categories.filter(c => c.id !== catId);
    document.querySelectorAll(`[data-cat-id="${catId}"]`).forEach(row => row.remove());
  });

  // ── SAL milestone helpers ─────────────────────────────────────────────────
  function buildSalRowHtml(m, budget) {
    const inp = 'padding:.22rem .35rem;border:1px solid var(--g2);border-radius:4px;font-family:var(--sans)';
    const triggerOpts = ['signing','start','percent','date','final'].map(v =>
      `<option value="${v}"${m.triggerType===v?' selected':''}>${v==='signing'?'On signing':v==='start'?'At start of works':v==='percent'?'At %':v==='date'?'On date':'Final'}</option>`
    ).join('');
    const amtVal = budget > 0 ? (budget * m.pct / 100).toFixed(2) : (m.fixedAmt != null ? parseFloat(m.fixedAmt).toFixed(2) : (0).toFixed(2));
    return [
      `<td><input class="sal-ref-input" type="text" value="${m.id}" style="width:52px;${inp};font-size:.72rem;font-family:monospace;font-weight:700;color:var(--navy)" /></td>`,
      `<td><input class="sal-label-input" type="text" value="${m.label}" style="width:100%;${inp};font-size:.75rem" /></td>`,
      `<td style="white-space:nowrap">`,
        `<select class="sal-trigger-type-input" style="${inp};font-size:.72rem;background:#fff">${triggerOpts}</select>`,
        `<input class="sal-trigger-pct-input" type="number" min="1" max="99" value="${m.triggerPct??''}" placeholder="%" style="width:38px;${inp};font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType!=='percent'?'display:none':''}" />`,
        `<input class="sal-trigger-date-input" type="date" value="${m.triggerDate??''}" style="${inp};font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType!=='date'?'display:none':''}" />`,
      `</td>`,
      `<td style="text-align:right;white-space:nowrap">`,
        `<span style="font-size:.68rem;color:var(--g3);margin-right:.2rem">€</span>`,
        `<input class="sal-amt-input" type="number" min="0" step="0.01" value="${amtVal}" style="width:88px;${inp};font-size:.75rem;font-family:monospace;text-align:right" />`,
      `</td>`,
      `<td style="text-align:right;white-space:nowrap">`,
        `<input class="sal-pct-input" type="number" min="0" max="100" step="0.01" value="${m.pct}" style="width:48px;${inp};font-size:.72rem;font-family:monospace;text-align:right;color:var(--g3)" />`,
        `<span style="font-size:.65rem;color:var(--g3);margin-left:.15rem">%</span>`,
      `</td>`,
      `<td style="text-align:center;white-space:nowrap">`,
        `<input class="sal-paid-check" type="checkbox"${m.paid?' checked':''} title="Mark as paid" style="width:14px;height:14px;cursor:pointer;accent-color:var(--green)" />`,
        `<input class="sal-paid-date-input" type="date" value="${m.paidDate??''}" style="${inp};font-size:.68rem;font-family:monospace;margin-left:.3rem;${m.paid?'':'display:none'}" />`,
      `</td>`,
      `<td><button class="btn-icon btn-del-milestone" style="padding:.15rem .35rem;font-size:.7rem;color:var(--red);border-color:#fca5a5">🗑</button></td>`,
    ].join('');
  }

  function recalcCard(card) {
    const budget = parseFloat(card.dataset.budget ?? '0');
    let totalPct = 0;
    card.querySelectorAll('tbody tr:not(.sal-total)').forEach(row => {
      const pct = parseFloat(row.querySelector('.sal-pct-input')?.value ?? '0') || 0;
      totalPct += pct;
    });
    const ok = Math.abs(totalPct - 100) < 0.01;
    const color = ok ? 'var(--green)' : 'var(--red)';
    const eurCell = card.querySelector('.sal-total-amt-eur');
    const pctCell = card.querySelector('.sal-total-amt');
    if (eurCell) { eurCell.textContent = fmtAmt(budget * totalPct / 100); eurCell.style.color = color; }
    if (pctCell)  { pctCell.textContent = totalPct.toFixed(2).replace(/\.00$/,'') + '% ' + (ok ? '✓' : '⚠'); pctCell.style.color = color; }
  }

  function syncSalFromCard(card) {
    const isTec  = card.classList.contains('tec-card');
    const ctrId  = isTec ? card.dataset.tecId : card.dataset.ctrId;
    const entity = isTec
      ? state.technicians.find(t => t.id === ctrId)
      : state.contractors.find(c => c.id === ctrId);
    if (!entity) return;
    const budget = parseFloat(card.dataset.budget ?? '0') || 0;
    entity.sal = Array.from(card.querySelectorAll('tbody tr:not(.sal-total)')).map(row => {
      const pct      = parseFloat(row.querySelector('.sal-pct-input')?.value) || 0;
      const amtRaw   = parseFloat(row.querySelector('.sal-amt-input')?.value) || 0;
      const fixedAmt = budget <= 0 && amtRaw > 0 ? amtRaw : null;
      return {
        id:          row.querySelector('.sal-ref-input')?.value.trim() ?? '',
        label:       row.querySelector('.sal-label-input')?.value.trim() ?? '',
        triggerType: row.querySelector('.sal-trigger-type-input')?.value ?? 'signing',
        triggerPct:  row.querySelector('.sal-trigger-type-input')?.value === 'percent'
                       ? (parseFloat(row.querySelector('.sal-trigger-pct-input')?.value) || null)
                       : null,
        triggerDate: row.querySelector('.sal-trigger-type-input')?.value === 'date'
                       ? (row.querySelector('.sal-trigger-date-input')?.value || null)
                       : null,
        pct,
        ...(fixedAmt != null ? { fixedAmt } : {}),
        paid:     row.querySelector('.sal-paid-check')?.checked ?? false,
        paidDate: row.querySelector('.sal-paid-check')?.checked
                    ? (row.querySelector('.sal-paid-date-input')?.value || null)
                    : null,
      };
    });
  }

  // Inline SAL editing
  document.addEventListener('change', e => {
    if (!e.target.classList.contains('sal-paid-check')) return;
    const row = e.target.closest('.sal-table tbody tr:not(.sal-total)');
    if (!row) return;
    const dateInp = row.querySelector('.sal-paid-date-input');
    if (dateInp) {
      dateInp.style.display = e.target.checked ? '' : 'none';
      if (e.target.checked && !dateInp.value) {
        dateInp.value = new Date().toISOString().slice(0, 10);
      }
    }
    syncSalFromCard(row.closest('.ctr-card') ?? row.closest('.tec-card'));
  });

  document.addEventListener('input', e => {
    const row = e.target.closest('.sal-table tbody tr:not(.sal-total)');
    if (!row) return;
    const card = row.closest('.ctr-card') ?? row.closest('.tec-card');
    if (!card) return;
    if (e.target.classList.contains('sal-trigger-type-input')) {
      const pctInput  = row.querySelector('.sal-trigger-pct-input');
      const dateInput = row.querySelector('.sal-trigger-date-input');
      if (pctInput)  pctInput.style.display  = e.target.value === 'percent' ? '' : 'none';
      if (dateInput) dateInput.style.display = e.target.value === 'date'    ? '' : 'none';
    }
    if (e.target.classList.contains('sal-amt-input')) {
      const budget = parseFloat(card.dataset.budget ?? '0') || 0;
      const amt    = parseFloat(e.target.value) || 0;
      const pctIn  = row.querySelector('.sal-pct-input');
      if (pctIn) pctIn.value = budget > 0 ? ((amt / budget) * 100).toFixed(2) : '0';
      recalcCard(card);
    }
    if (e.target.classList.contains('sal-pct-input')) {
      const budget = parseFloat(card.dataset.budget ?? '0') || 0;
      const pct    = parseFloat(e.target.value) || 0;
      const amtIn  = row.querySelector('.sal-amt-input');
      if (amtIn) amtIn.value = (budget * pct / 100).toFixed(2);
      recalcCard(card);
    }
    syncSalFromCard(card);
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-milestone');
    if (!btn) return;
    const row = btn.closest('tr');
    const card = btn.closest('.ctr-card') ?? btn.closest('.tec-card');
    row?.remove();
    if (card) { recalcCard(card); syncSalFromCard(card); }
  });

  const msModal          = document.getElementById('milestone-modal');
  const msCtrName        = document.getElementById('ms-ctr-name');
  const msRef            = document.getElementById('ms-ref');
  const msLabel          = document.getElementById('ms-label');
  const msTriggerType    = document.getElementById('ms-trigger-type');
  const msTriggerPct     = document.getElementById('ms-trigger-pct');
  const msPct            = document.getElementById('ms-pct');
  const msPctRow         = document.getElementById('ms-pct-row');
  const msDateRow        = document.getElementById('ms-date-row');
  const msTriggerDate    = document.getElementById('ms-trigger-date');
  const msModeBtn        = document.getElementById('ms-mode-pct');
  const msModeBtnEur     = document.getElementById('ms-mode-eur');
  const msPctAmountRow   = document.getElementById('ms-pct-amount-row');
  const msEurAmountRow   = document.getElementById('ms-eur-amount-row');
  const msEurInput       = document.getElementById('ms-eur');
  const msEurHint        = document.getElementById('ms-eur-hint');
  let msTargetCard       = null;
  let msAmountMode       = 'pct'; // 'pct' | 'eur'

  function setMsAmountMode(mode) {
    msAmountMode = mode;
    if (mode === 'pct') {
      msModeBtn.style.background    = 'var(--navy)'; msModeBtn.style.color    = '#fff';
      msModeBtnEur.style.background = '#fff';        msModeBtnEur.style.color = 'var(--g3)';
      msPctAmountRow.style.display  = 'flex';
      msEurAmountRow.style.display  = 'none';
    } else {
      msModeBtnEur.style.background = 'var(--navy)'; msModeBtnEur.style.color    = '#fff';
      msModeBtn.style.background    = '#fff';        msModeBtn.style.color    = 'var(--g3)';
      msPctAmountRow.style.display  = 'none';
      msEurAmountRow.style.display  = 'flex';
      updateEurHint();
    }
  }

  function updateEurHint() {
    if (!msTargetCard) return;
    const budget = parseFloat(msTargetCard.dataset.budget ?? '0');
    if (budget <= 0) { msEurHint.textContent = ''; return; }
    const alreadyPct = Array.from(msTargetCard.querySelectorAll('tbody tr:not(.sal-total) .sal-pct-input'))
      .reduce((s, inp) => s + (parseFloat(inp.value) || 0), 0);
    const alreadyEur = budget * alreadyPct / 100;
    const remaining  = budget - alreadyEur;
    msEurHint.textContent = `Budget: ${fmtAmt(budget)} — già allocato: ${fmtAmt(alreadyEur)} — residuo: ${fmtAmt(remaining)}`;
  }

  msModeBtn.addEventListener('click',    () => setMsAmountMode('pct'));
  msModeBtnEur.addEventListener('click', () => setMsAmountMode('eur'));
  msEurInput.addEventListener('input', updateEurHint);

  msTriggerType.addEventListener('change', () => {
    msPctRow.style.display  = msTriggerType.value === 'percent' ? '' : 'none';
    msDateRow.style.display = msTriggerType.value === 'date'    ? '' : 'none';
  });
  msPctRow.style.display = 'none';

  function openMsModal(card) {
    msTargetCard = card;
    msCtrName.textContent = card.querySelector('.ctr-name')?.textContent ?? '';
    msRef.value = ''; msLabel.value = ''; msPct.value = ''; msTriggerPct.value = ''; msEurInput.value = ''; msTriggerDate.value = '';
    msTriggerType.value = 'signing'; msPctRow.style.display = 'none'; msDateRow.style.display = 'none';
    setMsAmountMode('pct');
    msModal.classList.add('is-open'); msRef.focus();
  }
  function closeMsModal() { msModal.classList.remove('is-open'); msTargetCard = null; }

  document.getElementById('ms-close-btn').addEventListener('click', closeMsModal);
  document.getElementById('ms-cancel-btn').addEventListener('click', closeMsModal);
  msModal.addEventListener('click', e => { if (e.target === msModal) closeMsModal(); });

  document.getElementById('ms-save-btn').addEventListener('click', () => {
    if (!msTargetCard) return;
    const ref    = msRef.value.trim() || '—';
    const label  = msLabel.value.trim() || 'New Milestone';
    const ttype  = msTriggerType.value;
    const tpct   = parseFloat(msTriggerPct.value) || null;
    const tdate  = ttype === 'date' ? (msTriggerDate.value || null) : null;
    const budget = parseFloat(msTargetCard.dataset.budget ?? '0');
    let pct;
    let fixedAmt = null;
    if (msAmountMode === 'eur') {
      const eur = parseFloat(msEurInput.value) || 0;
      fixedAmt = eur;
      pct = budget > 0 ? (eur / budget) * 100 : 0;
    } else {
      pct = parseFloat(msPct.value) || 0;
    }
    const tbody   = msTargetCard.querySelector('tbody');
    const totalRow = tbody.querySelector('.sal-total');
    const tr = document.createElement('tr');
    tr.innerHTML = buildSalRowHtml({ id: ref, label, triggerType: ttype, triggerPct: tpct, triggerDate: tdate, pct, fixedAmt }, budget);
    tbody.insertBefore(tr, totalRow);
    recalcCard(msTargetCard);
    syncSalFromCard(msTargetCard);
    closeMsModal();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-milestone');
    if (!btn) return;
    const card = btn.closest('.ctr-card') ?? btn.closest('.tec-card');
    if (card) openMsModal(card);
  });

  const descModal     = document.getElementById('desc-modal');
  const modalIdEl     = document.getElementById('modal-item-id');
  const modalBriefInp = document.getElementById('modal-brief');
  const modalText     = document.getElementById('modal-fulldesc');
  let   descActiveCatId  = null;
  let   descActiveLinkEl = null;

  function openDescModal(catId, id, brief, fullDesc, linkEl) {
    descActiveCatId  = catId;
    descActiveLinkEl = linkEl ?? null;
    modalIdEl.textContent = id;
    modalBriefInp.value   = brief;
    modalText.value       = fullDesc;
    descModal.classList.add('is-open');
    modalBriefInp.focus();
  }
  function closeDescModal() { descModal.classList.remove('is-open'); descActiveCatId = null; descActiveLinkEl = null; }

  document.getElementById('modal-close-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-cancel-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-save-btn').addEventListener('click', () => {
    const itemId  = modalIdEl.textContent;
    const brief   = modalBriefInp.value.trim();
    const fullDesc = modalText.value;
    const item = findItem(descActiveCatId, itemId);
    if (item) { item.brief = brief; item.fullDesc = fullDesc; }
    if (descActiveLinkEl) {
      descActiveLinkEl.dataset.brief    = brief;
      descActiveLinkEl.dataset.fulldesc = fullDesc;
      descActiveLinkEl.innerHTML = brief
        ? brief
        : '<em class="brief-empty">+ add description</em>';
    }
    closeDescModal();
  });
  descModal.addEventListener('click', e => { if (e.target === descModal) closeDescModal(); });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (msModal.classList.contains('is-open'))   { closeMsModal();   return; }
    if (descModal.classList.contains('is-open')) { closeDescModal(); return; }
    if (ctrModal.classList.contains('is-open'))  { closeCtrModal();  return; }
  });

  // ── Contractor modal ──────────────────────────────────────────────────────
  const ctrModal     = document.getElementById('ctr-modal');
  const ctrModalTitle= document.getElementById('ctr-modal-title');
  const ctrIdInp     = document.getElementById('ctr-id-inp');
  const ctrNameInp   = document.getElementById('ctr-name-inp');
  const ctrTradeInp  = document.getElementById('ctr-trade-inp');
  const ctrContactInp= document.getElementById('ctr-contact-inp');
  let   ctrEditId    = null;

  function openCtrModal(ctr) {
    ctrEditId = ctr?.id ?? null;
    ctrModalTitle.textContent = ctr ? 'Edit Contractor' : 'Add Contractor';
    ctrIdInp.value      = ctr?.id      ?? '';
    ctrNameInp.value    = ctr?.name    ?? '';
    ctrTradeInp.value   = ctr?.trade   ?? '';
    ctrContactInp.value = ctr?.contact ?? '';
    ctrIdInp.disabled   = !!ctr;
    ctrModal.classList.add('is-open');
    ctrNameInp.focus();
  }
  function closeCtrModal() { ctrModal.classList.remove('is-open'); ctrEditId = null; }

  document.getElementById('ctr-modal-close').addEventListener('click', closeCtrModal);
  document.getElementById('ctr-cancel-btn').addEventListener('click', closeCtrModal);
  ctrModal.addEventListener('click', e => { if (e.target === ctrModal) closeCtrModal(); });

  document.getElementById('ctr-save-btn').addEventListener('click', () => {
    const id      = ctrIdInp.value.trim();
    const name    = ctrNameInp.value.trim();
    const trade   = ctrTradeInp.value.trim();
    const contact = ctrContactInp.value.trim();
    if (!id || !name) { alert('ID and Name are required.'); return; }

    if (ctrEditId) {
      const ctr = state.contractors.find(c => c.id === ctrEditId);
      if (ctr) { ctr.name = name; ctr.trade = trade; ctr.contact = contact; }
      const card = document.querySelector(`.ctr-card[data-ctr-id="${ctrEditId}"]`);
      if (card) {
        card.querySelector('.ctr-name').textContent    = name;
        card.querySelector('.ctr-trade').textContent   = trade;
        card.querySelector('.ctr-contact').textContent = contact;
      }
    } else {
      if (state.contractors.find(c => c.id === id)) { alert('Contractor ID already exists.'); return; }
      const newCtr = { id, name, trade, contact, sal: [] };
      state.contractors.push(newCtr);
      const grid = document.querySelector('.contractor-grid');
      const div = document.createElement('div');
      div.className = 'card ctr-card';
      div.dataset.budget = '0';
      div.dataset.ctrId  = id;
      div.innerHTML = `
        <div class="ctr-header">
          <div>
            <div class="ctr-name">${name}</div>
            <div class="ctr-trade">${trade}</div>
            <div class="ctr-contact">${contact}</div>
            <div class="ctr-budget">Budget: <strong class="ctr-budget-val">€ 0.00</strong> <span class="auto-tag">auto</span></div>
          </div>
          <div class="ctr-actions">
            <button class="btn-icon btn-edit-ctr" title="Edit">✎</button>
            <button class="btn-icon btn-del-ctr" title="Delete">🗑</button>
          </div>
        </div>
        <table class="sal-table"><thead><tr><th style="width:50px">Ref.</th><th>Milestone</th><th style="width:90px">Trigger</th><th class="right" style="width:115px">Amount (net) <span class="auto-tag">auto</span></th><th style="width:60px"></th></tr></thead>
        <tbody><tr class="sal-total"><td colspan="3" style="text-align:right;color:var(--slate);font-size:.68rem;letter-spacing:.04em">TOTAL</td><td class="sal-amt sal-total-amt" style="color:var(--red);font-weight:700">€ 0.00 ⚠ 0%</td><td></td></tr></tbody></table>
        <div class="sal-add-row"><button class="btn btn-add btn-add-milestone" style="font-size:.7rem;padding:.3rem .7rem">+ Add milestone</button></div>`;
      grid.appendChild(div);
    }
    closeCtrModal();
  });

  // Add contractor button
  document.querySelector('.contractor-grid')?.closest('#tab-contractors')
    ?.querySelector('.btn-add')
    ?.addEventListener('click', () => openCtrModal(null));

  // Edit contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-edit-ctr');
    if (!btn) return;
    const ctrId = btn.closest('.ctr-card')?.dataset.ctrId;
    const ctr   = state.contractors.find(c => c.id === ctrId);
    if (ctr) openCtrModal(ctr);
  });

  // Delete contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-ctr');
    if (!btn) return;
    const card  = btn.closest('.ctr-card');
    const ctrId = card?.dataset.ctrId;
    if (!ctrId || !confirm(`Delete contractor "${ctrId}"?`)) return;
    state.contractors = state.contractors.filter(c => c.id !== ctrId);
    card.remove();
  });

  // ── Technician modal ─────────────────────────────────────────────────────
  const tecModal      = document.getElementById('tec-modal');
  const tecModalTitle = document.getElementById('tec-modal-title');
  const tecIdInp      = document.getElementById('tec-id-inp');
  const tecNameInp    = document.getElementById('tec-name-inp');
  const tecRoleInp    = document.getElementById('tec-role-inp');
  const tecContactInp = document.getElementById('tec-contact-inp');
  const tecFeeInp     = document.getElementById('tec-fee-inp');
  let   tecEditId     = null;

  function openTecModal(tec) {
    tecEditId = tec?.id ?? null;
    tecModalTitle.textContent = tec ? 'Edit Technician' : 'Add Technician';
    tecIdInp.value      = tec?.id      ?? '';
    tecNameInp.value    = tec?.name    ?? '';
    tecRoleInp.value    = tec?.role    ?? '';
    tecContactInp.value = tec?.contact ?? '';
    tecFeeInp.value     = tec?.fee     ?? '';
    tecIdInp.disabled   = !!tec;
    tecModal.classList.add('is-open');
    tecNameInp.focus();
  }
  function closeTecModal() { tecModal.classList.remove('is-open'); tecEditId = null; }

  document.getElementById('tec-modal-close').addEventListener('click', closeTecModal);
  document.getElementById('tec-cancel-btn').addEventListener('click', closeTecModal);
  tecModal.addEventListener('click', e => { if (e.target === tecModal) closeTecModal(); });

  document.getElementById('tec-save-btn').addEventListener('click', () => {
    const id      = tecIdInp.value.trim();
    const name    = tecNameInp.value.trim();
    const role    = tecRoleInp.value.trim();
    const contact = tecContactInp.value.trim();
    const fee     = parseFloat(tecFeeInp.value) || 0;
    if (!id || !name) { alert('ID and Name are required.'); return; }

    if (tecEditId) {
      const tec = state.technicians.find(t => t.id === tecEditId);
      if (tec) { tec.name = name; tec.role = role; tec.contact = contact; tec.fee = fee; }
      const card = document.querySelector(`.tec-card[data-tec-id="${tecEditId}"]`);
      if (card) {
        card.dataset.budget = fee.toFixed(2);
        card.querySelector('.ctr-name').textContent    = name;
        card.querySelector('.ctr-trade').textContent   = role;
        card.querySelector('.ctr-contact').textContent = contact;
        card.querySelector('.ctr-budget-val').textContent = fmtAmt(fee);
        recalcCard(card);
      }
    } else {
      if (state.technicians.find(t => t.id === id)) { alert('Technician ID already exists.'); return; }
      const newTec = { id, name, role, contact, fee, sal: [] };
      state.technicians.push(newTec);
      const grid = document.getElementById('technician-grid');
      const div = document.createElement('div');
      div.className = 'card tec-card';
      div.dataset.budget = fee.toFixed(2);
      div.dataset.tecId  = id;
      div.innerHTML = `
        <div class="ctr-header">
          <div>
            <div class="ctr-name">${name}</div>
            <div class="ctr-trade">${role}</div>
            <div class="ctr-contact">${contact}</div>
            <div class="ctr-budget">Fee: <strong class="ctr-budget-val">${fmtAmt(fee)}</strong> <span style="font-size:.6rem;color:var(--g3)"> · manually entered · net ex. VAT</span></div>
          </div>
          <div class="ctr-actions">
            <button class="btn-icon btn-edit-tec" title="Edit">✎</button>
            <button class="btn-icon btn-del-tec" title="Delete">🗑</button>
          </div>
        </div>
        <div style="overflow-x:auto">
        <table class="sal-table"><thead><tr>
          <th style="width:62px">Ref.</th><th>Milestone</th>
          <th style="width:160px">Trigger <span style="font-size:.55rem;font-weight:400;color:var(--g3)">(overall works %)</span></th>
          <th class="right" style="width:120px">Amount (net €)</th>
          <th class="right" style="width:58px">%</th>
          <th style="width:130px;text-align:center">Paid ✓</th>
          <th style="width:36px"></th>
        </tr></thead>
        <tbody>
          <tr class="sal-total">
            <td colspan="3" style="text-align:right;color:var(--slate);font-size:.68rem;letter-spacing:.04em">TOTAL</td>
            <td class="sal-amt sal-total-amt-eur" style="text-align:right;font-family:monospace;font-weight:700;color:var(--red)">€ 0.00</td>
            <td class="sal-total-amt" style="text-align:right;font-weight:700;color:var(--red);font-size:.72rem">0% ⚠</td>
            <td></td><td></td>
          </tr>
        </tbody></table>
        </div>
        <div class="sal-add-row"><button class="btn btn-add btn-add-milestone" style="font-size:.7rem;padding:.3rem .7rem">+ Add milestone</button></div>`;
      grid.appendChild(div);
    }
    closeTecModal();
  });

  // Add technician button
  document.getElementById('btn-add-tec')?.addEventListener('click', () => openTecModal(null));

  // Edit technician
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-edit-tec');
    if (!btn) return;
    const tecId = btn.closest('.tec-card')?.dataset.tecId;
    const tec   = state.technicians.find(t => t.id === tecId);
    if (tec) openTecModal(tec);
  });

  // Delete technician
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-tec');
    if (!btn) return;
    const card  = btn.closest('.tec-card');
    const tecId = card?.dataset.tecId;
    if (!tecId || !confirm(`Delete technician "${tecId}"?`)) return;
    state.technicians = state.technicians.filter(t => t.id !== tecId);
    card.remove();
  });

  // Escape closes tec modal too
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && tecModal.classList.contains('is-open')) closeTecModal();
  }, { capture: true });

  // ── Brief description click ───────────────────────────────────────────────
  document.addEventListener('click', e => {
    const el = e.target.closest('.brief-link');
    if (!el) return;
    openDescModal(el.dataset.catId, el.dataset.id, el.dataset.brief ?? '', el.dataset.fulldesc ?? '', el);
  });

  // ── Add item / Add extra item ─────────────────────────────────────────────
  function buildItemRow(catId, item) {
    const opts = state.contractors.map(c =>
      `<option value="${c.id}"${item.contractor===c.id?' selected':''}>${c.name}</option>`).join('');
    const isX = item.extra;
    const price       = parseFloat(item.price) || 0;
    const variationQty= parseFloat(item.variation) || 0;
    const revised     = isX ? variationQty * price : ((parseFloat(item.qty)||0) + variationQty) * price;
    const rawDone     = (parseFloat(item.done)||0) * price;
    const agreedQty   = isX ? variationQty : (parseFloat(item.qty)||0);
    const doneQty     = parseFloat(item.done)||0;
    const overrunX    = revised > 0 && doneQty > agreedQty;
    const fcX         = !!item.complete && !overrunX;
    const percX       = revised > 0 ? rawDone / revised * 100 : null;
    const dispPercX   = fcX ? 100 : (percX ?? 0);
    const barWX       = Math.min(dispPercX, 100);
    const pColorX     = overrunX ? '#dc2626' : fcX ? '#22c55e' : dispPercX >= 100 ? '#22c55e' : dispPercX > 0 ? '#f59e0b' : '#cbd5e1';
    const percHtml    = revised > 0
      ? `<div class="perc-wrap"><div class="perc-mini"><div class="perc-fill" style="width:${barWX}%;background:${pColorX}"></div></div><span class="perc-num" style="color:${pColorX}">${Math.round(dispPercX)}%</span></div>`
      : '<span class="perc-null" style="color:var(--g3)">–</span>';
    const statusHtml  = overrunX
      ? `<span class="status-badge status-overrun">Overrun</span>`
      : revised <= 0 && (isX || (parseFloat(item.qty)||0) > 0)
        ? `<span class="status-badge status-pending is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}">Not Started</span>`
        : revised <= 0
          ? `<span style="color:var(--g3)">–</span>`
          : fcX || dispPercX >= 100
            ? `<span class="status-badge status-complete is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}" title="Click to unmark completion">Complete</span>`
            : dispPercX > 0
              ? `<span class="status-badge status-progress is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}" title="Click to mark as complete">In Progress</span>`
              : `<span class="status-badge status-pending is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}" title="Click to mark as complete">Not Started</span>`;
    const unitOpts    = ['m²','m³','lm','unit','lump','kg'].map(u=>`<option${item.unit===u?' selected':''}>${u}</option>`).join('');
    return [
      `<tr class="item${isX?' extra-row':''}" data-cat-id="${catId}" data-item-id="${item.id}">`,
      `<td class="item-id">${item.id}</td>`,
      `<td style="max-width:220px">${isX?'<span class="extra-badge">Extra</span>':''}<span class="brief-link" data-id="${item.id}" data-cat-id="${catId}" data-brief="" data-fulldesc="" title="Click to view / edit full description"><em class="brief-empty">+ add description</em></span></td>`,
      `<td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="unit" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.72rem;width:60px">${unitOpts}</select></td>`,
      `<td class="${isX?'auto-cell':'editable-cell'}">${isX?'<span style="color:var(--g3)">–</span>':`<input type="number" value="0" placeholder="0" data-cat-id="${catId}" data-item-id="${item.id}" data-field="qty" />`}</td>`,
      `<td class="editable-cell"><input type="number" value="0" step="0.01" data-cat-id="${catId}" data-item-id="${item.id}" data-field="price" /></td>`,
      `<td class="auto-cell auto-cell-budget">${isX?'<span style="color:var(--g3)">–</span>':'€ 0.00'}</td>`,
      `<td class="editable-cell"><input type="number" step="any" value="" placeholder="0" data-cat-id="${catId}" data-item-id="${item.id}" data-field="variation" style="text-align:right;width:80px;color:var(--g3)" /></td>`,
      `<td class="auto-cell auto-cell-revised">${isX?'<span style="color:var(--g3)">–</span>':'€ 0.00'}</td>`,
      `<td class="editable-cell"><input type="number" value="${item.done||0}" data-cat-id="${catId}" data-item-id="${item.id}" data-field="done" /></td>`,
      `<td class="auto-cell auto-cell-done">€ 0.00</td>`,
      `<td class="auto-bg" style="min-width:90px">${percHtml}</td>`,
      `<td class="auto-bg">${statusHtml}</td>`,
      `<td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="contractor" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.68rem;max-width:120px;width:100%"><option value="">— none —</option>${opts}</select></td>`,
      `<td style="white-space:nowrap"><button class="btn-icon btn-del-item" data-cat-id="${catId}" data-item-id="${item.id}" title="Delete" style="margin-left:.2rem">🗑</button></td>`,
      `</tr>`
    ].join('');
  }

  // ── Add item / Add extra item ─────────────────────────────────────────────
  function itemIdNum(id) { const m = id.match(/\.(\d+)$/); return m ? parseInt(m[1]) : 0; }

  function addItem(catId, isExtra) {
    const cat = state.categories.find(c => c.id === catId);
    if (!cat) return;
    const nums = cat.items.map(i => itemIdNum(i.id));
    const next = (nums.length ? Math.max(...nums) : 0) + 1;
    const id   = `${catId}.${String(next).padStart(2, '0')}`;
    const item = { id, brief: '', fullDesc: '', unit: 'm²', qty: 0, price: 0, done: 0, complete: false, contractor: '', extra: isExtra };
    cat.items.push(item);
    const allItemRows = [...document.querySelectorAll(`tr.item[data-cat-id="${catId}"]`)];
    const rowHtml = buildItemRow(catId, item);
    if (allItemRows.length > 0) allItemRows[allItemRows.length - 1].insertAdjacentHTML('afterend', rowHtml);
    else document.querySelector(`tr.cat-row[data-cat-id="${catId}"]`).insertAdjacentHTML('afterend', rowHtml);
  }

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-item');
    if (!btn) return;
    addItem(btn.dataset.catId, btn.dataset.extra === 'true');
  });

  // ── Add Category ──────────────────────────────────────────────────────────
  document.querySelector('#tab-works .section-head .btn-add')?.addEventListener('click', () => {
    const id = prompt('Category ID (e.g. I):')?.trim().toUpperCase();
    if (!id) return;
    if (state.categories.find(c => c.id === id)) { alert('Category ID already exists.'); return; }
    const label = prompt('Category label (e.g. Flooring):')?.trim();
    if (!label) return;
    state.categories.push({ id, label, items: [] });
    const grandTotal = document.querySelector('table.works tbody tr.grand-total');
    grandTotal.insertAdjacentHTML('beforebegin', `<tr class="cat-row" data-cat-id="${id}">
      <td colspan="14">
        <span class="cat-badge">${id}</span> ${label}
        <span style="margin-left:.75rem;font-size:.65rem;font-weight:400;color:var(--slate)">Budget: € 0.00 &nbsp;|&nbsp; Done: € 0.00 &nbsp;|&nbsp; 0%</span>
        <span style="float:right;display:flex;gap:.3rem;margin-top:-.1rem">
          <button class="btn btn-add btn-add-item" data-cat-id="${id}" style="font-size:.62rem;padding:.2rem .55rem">+ Add item</button>
          <button class="btn btn-extra btn-add-item" data-cat-id="${id}" data-extra="true" style="font-size:.62rem;padding:.2rem .55rem">+ Add extra item</button>
          <button class="btn-icon btn-del-cat" data-cat-id="${id}" title="Delete category" style="font-size:.72rem;padding:.2rem .45rem;color:var(--red);border-color:#fca5a5">🗑 Delete</button>
        </span>
      </td>
    </tr>
    <tr class="subtotal" data-cat-id="${id}">
      <td colspan="5" style="text-align:right;padding-right:.75rem;color:var(--slate);font-weight:400;font-size:.68rem">Category ${id} subtotal</td>
      <td style="text-align:right;font-family:monospace">€ 0.00</td>
      <td style="text-align:right;font-family:monospace;color:var(--g3)">–</td>
      <td style="text-align:right;font-family:monospace;font-weight:700">€ 0.00</td>
      <td></td>
      <td style="text-align:right;font-family:monospace;color:var(--navy)">€ 0.00</td>
      <td colspan="4"></td>
    </tr>`);
  });

</script>
</body>
</html>
