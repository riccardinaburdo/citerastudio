---
export const prerender = false;
import { getProject, listProjects } from '../../lib/store';
import type { ProjectData } from '../../lib/schema';

const projectId = Astro.url.searchParams.get('p') ?? 'default';
const [data, allProjects] = await Promise.all([getProject(projectId), listProjects()]);
const { info: project, contractors, categories } = data;

const enrich = (item: any) => {
  const budget = item.extra ? 0 : item.qty * item.price;
  const done   = item.done * item.price;
  const perc   = (!item.extra && budget > 0) ? (done / budget) * 100 : null;
  return { ...item, budget, valueDone: done, perc };
};
const enrichedCats = categories.map(c => ({ ...c, items: c.items.map(enrich) }));

const ctrBudgets = new Map<string, { budget: number; itemCount: number }>();
for (const cat of categories) {
  for (const item of cat.items) {
    if (!item.extra) {
      const cur = ctrBudgets.get(item.contractor) ?? { budget: 0, itemCount: 0 };
      ctrBudgets.set(item.contractor, { budget: cur.budget + item.qty * item.price, itemCount: cur.itemCount + 1 });
    }
  }
}

const triggerLabel = (m: any) =>
  m.triggerType === 'signing' ? 'On signing' :
  m.triggerType === 'final'   ? 'Final works' :
  m.triggerType === 'date'    ? `On ${m.triggerDate ?? '—'}` :
  `at ${m.triggerPct}%`;

const fmt = (n: number) => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const projectJson = JSON.stringify(data);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — {project.name} | CiteraStudio</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:#1a3a5c; --orange:#FB8503; --green:#22c55e; --red:#dc2626;
      --amber:#f59e0b; --slate:#64748b;
      --g1:#f8fafc; --g2:#e2e8f0; --g3:#94a3b8; --g4:#cbd5e1;
      --text:#1e293b; --sans:'Inter',sans-serif; --brand:'Quicksand',sans-serif;
      --r:8px;
    }
    body { font-family:var(--sans); color:var(--text); background:var(--g1); font-size:14px; }
    .topbar { position:sticky; top:0; z-index:100; background:var(--navy); color:#fff;
      display:flex; align-items:center; gap:1rem; padding:.6rem 1.5rem;
      box-shadow:0 2px 12px rgba(0,0,0,.25); }
    .topbar-brand { font-family:var(--brand); font-weight:700; font-size:1rem; color:var(--orange); text-decoration:none; flex-shrink:0; }
    .topbar-sep   { color:rgba(255,255,255,.25); }
    .topbar-title { font-size:.82rem; color:rgba(255,255,255,.75); flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .proj-switcher { position:relative; }
    .proj-switcher-btn { background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2); color:#fff;
      padding:.3rem .85rem; border-radius:5px; font-size:.78rem; font-weight:600; cursor:pointer;
      display:flex; align-items:center; gap:.4rem; white-space:nowrap; max-width:220px; overflow:hidden; text-overflow:ellipsis; }
    .proj-switcher-btn:hover { background:rgba(255,255,255,.18); }
    .proj-switcher-drop { display:none; position:absolute; top:calc(100% + .5rem); left:0; min-width:240px;
      background:#fff; border:1px solid var(--g2); border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.18);
      z-index:500; overflow:hidden; }
    .proj-switcher-drop.is-open { display:block; }
    .proj-drop-item { display:flex; align-items:center; justify-content:space-between; padding:.65rem 1rem;
      font-size:.82rem; color:var(--text); text-decoration:none; gap:.5rem;
      width:100%; background:none; border:none; cursor:pointer; text-align:left; }
    .proj-drop-item:hover { background:var(--g1); }
    .proj-drop-item.active { font-weight:700; color:var(--navy); background:#f0f6ff; }
    .proj-drop-item span { font-size:.7rem; color:var(--green); flex-shrink:0; }
    .proj-drop-new { width:100%; text-align:left; padding:.65rem 1rem; font-size:.82rem; color:var(--navy);
      font-weight:600; background:none; border:none; border-top:1px solid var(--g2); cursor:pointer; }
    .proj-drop-new:hover { background:#f0f6ff; }
    .save-status  { font-size:.75rem; color:rgba(255,255,255,.7); margin-right:.25rem; min-width:80px; text-align:right; }
    .btn-top { padding:.3rem .9rem; border:1px solid rgba(255,255,255,.3); background:transparent;
      color:#fff; border-radius:5px; font-size:.75rem; cursor:pointer; }
    .btn-top:hover { background:rgba(255,255,255,.1); }
    .btn-save-all { background:var(--orange); border:none; color:#fff; border-radius:5px;
      font-size:.75rem; font-weight:700; padding:.35rem 1rem; cursor:pointer; }
    .btn-save-all:hover { opacity:.9; }
    .btn-save-all:disabled { opacity:.5; cursor:default; }
    .tabs { background:#fff; border-bottom:2px solid var(--g2); padding:0 2rem; display:flex; gap:0; }
    .tab-btn { padding:.75rem 1.4rem; font-size:.8rem; font-weight:600; color:var(--g3);
      border:none; background:none; cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; transition:color .15s; }
    .tab-btn:hover { color:var(--slate); }
    .tab-btn.active { color:var(--navy); border-bottom-color:var(--orange); }
    .admin-main { max-width:1400px; margin:0 auto; padding:2rem; }
    .section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.2rem; }
    .section-title { font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; color:var(--g3); font-weight:600; }
    .card { background:#fff; border-radius:var(--r); border:1px solid var(--g2); box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .btn { display:inline-flex; align-items:center; gap:.35rem; padding:.4rem .9rem;
      border-radius:6px; font-size:.78rem; font-weight:500; cursor:pointer; border:none; transition:opacity .15s; }
    .btn:hover { opacity:.85; }
    .btn-primary   { background:var(--navy); color:#fff; }
    .btn-secondary { background:var(--g1); color:var(--slate); border:1px solid var(--g2); }
    .btn-add       { background:rgba(34,197,94,.1); color:#15803d; border:1px solid #bbf7d0; }
    .btn-danger    { background:rgba(220,38,38,.08); color:var(--red); border:1px solid #fca5a5; }
    .btn-extra     { background:rgba(245,158,11,.12); color:#92400e; border:1px solid #fcd34d; }
    .btn-icon      { padding:.3rem .5rem; font-size:.85rem; background:none; border:1px solid var(--g2);
      border-radius:5px; cursor:pointer; color:var(--g3); transition:background .15s; }
    .btn-icon:hover { background:var(--g1); color:var(--text); }
    .form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem 2rem; }
    .form-grid.cols3 { grid-template-columns:repeat(3,1fr); }
    .form-full { grid-column:1/-1; }
    .field { display:flex; flex-direction:column; gap:.3rem; }
    .field label { font-size:.68rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--g3); }
    .field input, .field select, .field textarea {
      padding:.5rem .75rem; border:1px solid var(--g2); border-radius:6px;
      font-size:.85rem; font-family:var(--sans); color:var(--text); background:#fff; transition:border-color .15s; }
    .field input:focus, .field select:focus { outline:none; border-color:var(--navy); }
    .field input[readonly] { background:var(--g1); color:var(--slate); cursor:default; }
    .auto-field { background:#f0f6ff !important; color:var(--navy) !important; font-family:monospace; font-size:.82rem; }
    .project-card { padding:1.5rem; }
    .contractor-grid { display:flex; flex-direction:column; gap:1.2rem; margin-bottom:1.2rem; }
    .ctr-card { padding:1.2rem 1.4rem; }
    .ctr-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; margin-bottom:1rem; }
    .ctr-name  { font-size:.9rem; font-weight:700; color:var(--navy); }
    .ctr-trade { font-size:.72rem; color:var(--slate); margin-top:.15rem; }
    .ctr-contact { font-size:.7rem; color:var(--g3); margin-top:.1rem; }
    .ctr-budget { font-size:.72rem; color:var(--slate); margin-top:.2rem; }
    .ctr-budget strong { color:var(--navy); }
    .ctr-actions { display:flex; gap:.4rem; flex-shrink:0; }
    .updates-admin-table { width:100%; border-collapse:collapse; font-size:.8rem; }
    .updates-admin-table th { font-size:.6rem; text-transform:uppercase; letter-spacing:.05em; color:var(--g3); font-weight:600; padding:.4rem .75rem; border-bottom:1px solid var(--g2); text-align:left; background:var(--g1); }
    .updates-admin-table td { padding:.5rem .75rem; border-bottom:1px solid var(--g2); vertical-align:top; }
    .updates-admin-table tr:last-child td { border-bottom:none; }
    .upd-num-badge { display:inline-block; background:var(--navy); color:#fff; font-size:.68rem; font-weight:700; padding:.2rem .5rem; border-radius:4px; font-family:monospace; }
    .sal-table { width:100%; min-width:540px; border-collapse:collapse; font-size:.75rem; margin-top:.3rem; }
    .sal-table th { font-size:.6rem; text-transform:uppercase; letter-spacing:.05em; color:var(--g3);
      font-weight:600; padding:.3rem .6rem; border-bottom:1px solid var(--g2); text-align:left; }
    .sal-table th.right { text-align:right; }
    .sal-table td { padding:.28rem .4rem; border-bottom:1px solid var(--g2); vertical-align:middle; }
    .sal-table tr:last-child td { border-bottom:none; }
    .sal-table input, .sal-table select { background:#f8fafc; border:1px solid #c7d9f0 !important; border-radius:4px; transition:border-color .15s; }
    .sal-table input:focus, .sal-table select:focus { outline:none; border-color:var(--navy) !important; background:#fff; }
    .sal-id   { font-size:.68rem; font-weight:700; font-family:monospace; color:var(--navy); }
    .sal-amt  { text-align:right; font-family:monospace; color:var(--slate); font-size:.7rem; }
    .sal-total{ background:var(--g1); }
    .sal-total td { font-weight:700; font-size:.72rem; padding:.4rem .6rem; }
    .sal-trigger { font-size:.7rem; color:var(--slate); }
    .sal-add-row { margin-top:.5rem; }
    .auto-tag { display:inline-block; font-size:.55rem; font-weight:700; text-transform:uppercase;
      letter-spacing:.05em; background:#f0f6ff; color:var(--navy); border:1px solid #c7d9f0;
      padding:.05rem .35rem; border-radius:3px; margin-left:.4rem; vertical-align:middle; }
    .works-wrap { overflow-x:auto; }
    table.works { width:100%; border-collapse:collapse; font-size:.75rem; }
    table.works thead th { background:var(--navy); color:rgba(255,255,255,.85); padding:.5rem .65rem;
      text-align:left; font-size:.62rem; text-transform:uppercase; letter-spacing:.05em; font-weight:600; white-space:nowrap; }
    table.works thead th.right { text-align:right; }
    tr.cat-row td { background:#f0f6ff; color:var(--navy); padding:.4rem .65rem;
      font-weight:700; font-size:.72rem; border-top:2px solid var(--g2); border-bottom:1px solid #c7d9f0; }
    .brief-link { font-size:.72rem; color:var(--slate); cursor:pointer; display:block;
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;
      text-decoration:underline dotted; text-underline-offset:2px; }
    .brief-link:hover { color:var(--navy); }
    .brief-empty { font-size:.68rem; color:var(--g4); font-style:italic; cursor:pointer; }
    .brief-empty:hover { color:var(--g3); }
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:1000;
      align-items:center; justify-content:center; padding:1rem; }
    .modal-overlay.is-open { display:flex; }
    .modal-box { background:#fff; border-radius:var(--r); box-shadow:0 20px 60px rgba(0,0,0,.25);
      width:100%; max-width:580px; display:flex; flex-direction:column; overflow:hidden; }
    .modal-header { display:flex; align-items:center; gap:.75rem; padding:1rem 1.2rem; background:var(--navy); color:#fff; }
    .modal-item-id { font-family:monospace; font-size:.75rem; font-weight:700;
      background:rgba(255,255,255,.15); padding:.2rem .55rem; border-radius:4px; flex-shrink:0; }
    .modal-item-brief { font-size:.82rem; font-weight:500; flex:1; opacity:.9; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .modal-close { margin-left:auto; background:none; border:none; color:rgba(255,255,255,.7);
      font-size:1.1rem; cursor:pointer; flex-shrink:0; line-height:1; }
    .modal-close:hover { color:#fff; }
    .modal-body { padding:1.2rem; }
    .modal-body label { display:block; font-size:.65rem; font-weight:700; text-transform:uppercase;
      letter-spacing:.07em; color:var(--g3); margin-bottom:.5rem; }
    .modal-body textarea { width:100%; border:1px solid var(--g2); border-radius:6px;
      padding:.65rem .75rem; font-size:.82rem; font-family:var(--sans); color:var(--text);
      resize:vertical; line-height:1.6; min-height:160px; }
    .modal-body textarea:focus { outline:none; border-color:var(--navy); }
    .modal-footer { display:flex; justify-content:flex-end; gap:.5rem;
      padding:.85rem 1.2rem; border-top:1px solid var(--g2); background:var(--g1); }
    .cat-badge { display:inline-flex; align-items:center; justify-content:center;
      width:20px; height:20px; border-radius:50%; background:var(--navy); color:#fff;
      font-size:.6rem; font-weight:700; margin-right:.4rem; }
    .ctr-pill { display:inline-block; font-size:.6rem; font-weight:700; padding:.1rem .5rem;
      border-radius:10px; background:rgba(251,133,3,.12); color:#c2410c; margin-left:.5rem; }
    table.works tbody tr.item td { padding:.4rem .65rem; border-bottom:1px solid var(--g2); vertical-align:middle; }
    table.works tbody tr.item:hover td { background:#f8fafc; }
    table.works tbody tr.item.extra-row td { background:#fffdf5; }
    .item-id  { font-size:.65rem; font-family:monospace; color:var(--g3); white-space:nowrap; }
    .auto-cell { background:#f0f6ff !important; font-family:monospace; font-size:.72rem; text-align:right;
      color:var(--navy); white-space:nowrap; position:relative; }
    .auto-cell::after { content:'auto'; position:absolute; bottom:2px; right:4px;
      font-size:.45rem; color:var(--g4); font-family:var(--sans); text-transform:uppercase; letter-spacing:.04em; }
    .auto-bg  { background:#f0f6ff !important; }
    .edit-col { background:#fff !important; }
    table.works tbody tr.item td.editable-cell { background:#fff !important; }
    .editable-cell input { width:100%; border:none; background:transparent; font-size:.75rem;
      font-family:var(--sans); color:var(--text); padding:0; text-align:right; }
    .editable-cell input:focus { outline:1px solid var(--navy); border-radius:3px; background:#fff; padding:0 3px; }
    input[type=number] { -moz-appearance:textfield; appearance:textfield; }
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
    .extra-badge { display:inline-block; font-size:.55rem; font-weight:800; text-transform:uppercase;
      padding:.1rem .35rem; border-radius:3px; background:var(--amber); color:#fff; margin-right:.3rem; }
    .overrun-badge { font-size:.62rem; font-weight:700; color:var(--red); }
    .perc-wrap { display:flex; align-items:center; gap:.35rem; }
    .perc-mini { flex:1; min-width:40px; height:5px; background:var(--g2); border-radius:3px; overflow:hidden; }
    .perc-fill { height:100%; border-radius:3px; }
    .perc-num  { font-size:.68rem; font-weight:600; width:32px; text-align:right; white-space:nowrap; }
    .status-badge { display:inline-block; font-size:.58rem; font-weight:700; text-transform:uppercase;
      letter-spacing:.04em; padding:.15rem .5rem; border-radius:20px; white-space:nowrap; }
    .status-complete { background:#dcfce7; color:#15803d; }
    .status-progress { background:#fff7ed; color:#c2410c; }
    .status-pending  { background:#f1f5f9; color:var(--g3); }
    .status-overrun  { background:#fee2e2; color:var(--red); border:1px solid #fca5a5; }
    .status-extra    { background:#fef3c7; color:#92400e; }
    .status-badge.is-toggleable { cursor:pointer; user-select:none; }
    .status-badge.is-toggleable:hover { opacity:.75; }
    tr.subtotal td { background:var(--g1); padding:.35rem .65rem; font-size:.7rem; font-weight:600;
      color:var(--navy); border-top:1px dashed #c7d9f0; border-bottom:2px solid var(--g2); }
    tr.grand-total td { background:var(--navy); color:#fff; padding:.5rem .65rem; font-weight:700; font-size:.78rem; }
    .legend { display:flex; gap:1.2rem; align-items:center; flex-wrap:wrap; font-size:.7rem; color:var(--slate); }
    .legend-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
    .legend-item { display:flex; align-items:center; gap:.4rem; }
    .auto-legend { display:inline-block; width:28px; height:12px; background:#f0f6ff;
      border:1px solid #c7d9f0; border-radius:3px; vertical-align:middle; }
    .projects-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.2rem; }
    .proj-card { padding:1.4rem; display:flex; flex-direction:column; gap:.75rem; }
    .proj-card--current { border-color:var(--navy); background:#f0f6ff; }
    .proj-name { font-size:.95rem; font-weight:700; color:var(--navy); }
    .proj-meta { font-size:.72rem; color:var(--slate); display:flex; flex-direction:column; gap:.15rem; }
    .proj-badge { display:inline-block; font-size:.55rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; background:var(--navy); color:#fff; padding:.15rem .5rem; border-radius:10px; }
    .proj-card-footer { margin-top:auto; padding-top:.75rem; border-top:1px solid var(--g2); display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
    .proj-active-label { font-size:.72rem; color:var(--navy); font-weight:600; }
    @media(max-width:900px) { .form-grid { grid-template-columns:1fr; } .contractor-grid { grid-template-columns:1fr; } .projects-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>

<div class="topbar">
  <a href="/" class="topbar-brand">citerastudio</a>
  <span class="topbar-sep">|</span>
  <span class="topbar-title">Admin</span>
  <div class="proj-switcher">
    <button class="proj-switcher-btn" id="proj-switcher-btn">{project.name} ▾</button>
    <div class="proj-switcher-drop" id="proj-switcher-drop">
      {(allProjects as any[]).map(p => (
        <button class={`proj-drop-item${p.id === projectId ? ' active' : ''}`} data-goto={`/area-riservata/admin?p=${p.id}`}>
          <span style="flex:1">{p.name}</span>
          {p.id === projectId && <span>✓ current</span>}
        </button>
      ))}
      <button class="proj-drop-new" id="proj-drop-new">+ New Project</button>
    </div>
  </div>
  <span id="save-status" class="save-status"></span>
  <button id="save-all-btn" class="btn-save-all" title="Save all changes to database">Save All</button>
  <a href={`/area-riservata/portal?p=${projectId}`} class="btn-top" style="margin-left:.5rem">Client Portal</a>
  <a href="/area-riservata/admin-mockup" class="btn-top" style="opacity:.5;font-size:.68rem">Mockup</a>
</div>

<div class="tabs">
  <button class="tab-btn" data-tab="projects">Projects</button>
  <button class="tab-btn active" data-tab="project">Project Info</button>
  <button class="tab-btn" data-tab="contractors">Contractors &amp; Payments</button>
  <button class="tab-btn" data-tab="works">Bill of Works</button>
</div>

<div class="admin-main">

  <div id="tab-projects" hidden>
    <div class="section-head">
      <span class="section-title">All Projects</span>
      <div style="display:flex;gap:.6rem">
        <button id="btn-from-template" class="btn btn-secondary">↺ From template</button>
        <button id="btn-new-project" class="btn btn-add">+ New Project</button>
      </div>
    </div>
    <div class="projects-grid">
      {allProjects.map((p: any) => (
        <div class={`card proj-card${p.id === projectId ? ' proj-card--current' : ''}`}>
          <div>
            <div class="proj-name">{p.name}</div>
            <div class="proj-meta" style="margin-top:.4rem">
              {p.clientName && <span>{p.clientName}</span>}
              {p.location   && <span>{p.location}</span>}
              {p.updated    && <span>Updated: {p.updated}</span>}
            </div>
          </div>
          <div class="proj-card-footer">
            {p.id === projectId
              ? <><span class="proj-badge">Current</span><span class="proj-active-label">Now editing</span></>
              : <>
                  <button class="btn btn-primary" data-goto={`/area-riservata/admin?p=${p.id}`} style="font-size:.78rem">Open project →</button>
                  <button class="btn btn-danger btn-del-project" data-proj-id={p.id} data-proj-name={p.name} style="font-size:.72rem;padding:.3rem .7rem">Delete</button>
                </>
            }
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="tab-project">
    <div class="section-head">
      <span class="section-title">Project Information</span>
      <button class="btn btn-primary save-trigger">Save Changes</button>
    </div>
    <div class="card project-card">
      <div class="form-grid">
        <div class="field form-full">
          <label>Project Title</label>
          <input type="text" value={project.name} data-info="name" />
        </div>
        <div class="field form-full">
          <label>Location</label>
          <input type="text" value={project.location} data-info="location" />
        </div>
        <div class="field">
          <label>Client Name</label>
          <input type="text" value={project.clientName} data-info="clientName" />
        </div>
        <div class="field">
          <label>Client Email</label>
          <input type="email" value={project.clientEmail} data-info="clientEmail" />
        </div>
        <div class="field">
          <label>Architect / D.L.</label>
          <input type="text" value={project.architect} data-info="architect" />
        </div>
        <div class="field">
          <label>Overall Contract Budget (net ex. VAT)</label>
          <input type="text" id="total-budget-display" readonly class="auto-field"
            value={fmt(enrichedCats.flatMap((c:any)=>c.items).filter((i:any)=>!i.extra).reduce((s:number,i:any)=>s+i.budget,0))} />
        </div>
        <div class="field">
          <label>Contract Start</label>
          <input type="date" value={project.start} data-info="start" />
        </div>
        <div class="field">
          <label>Contract End</label>
          <input type="date" value={project.end} data-info="end" />
        </div>
        <div class="field">
          <label>Last Updated</label>
          <input type="date" value={project.updated} data-info="updated" />
        </div>
        <div class="field">
          <label>Update Number</label>
          <input type="number" id="update-num-field" value={project.updateNum} data-info="updateNum" style="width:80px" />
        </div>
      </div>
    </div>

    <div class="section-head" style="margin-top:1.5rem">
      <span class="section-title">Progress Updates</span>
      <button class="btn btn-add" id="btn-add-update">+ Add Update</button>
    </div>
    <div class="card" style="padding:0; overflow:hidden">
      <table class="updates-admin-table" id="updates-admin-table">
        <thead>
          <tr>
            <th style="width:60px">#</th>
            <th style="width:130px">Date</th>
            <th>Note</th>
            <th style="width:48px"></th>
          </tr>
        </thead>
        <tbody id="updates-admin-tbody">
          {(data.updates ?? []).slice().sort((a, b) => b.num - a.num).map(u => (
            <tr data-update-num={u.num}>
              <td><span class="upd-num-badge">#{u.num}</span></td>
              <td><input type="date" class="upd-date-input" value={u.date} style="width:120px;padding:.3rem .4rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem" /></td>
              <td><textarea class="upd-note-input" rows={2} style="width:100%;padding:.3rem .5rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem;resize:vertical;font-family:var(--sans)">{u.note}</textarea></td>
              <td><button class="btn-icon btn-del-update" style="color:var(--red);border-color:#fca5a5" title="Delete">🗑</button></td>
            </tr>
          ))}
        </tbody>
      </table>
      {(data.updates ?? []).length === 0 && (
        <div id="updates-empty-msg" style="padding:1.2rem;text-align:center;font-size:.8rem;color:var(--g3)">No progress updates yet. Click "+ Add Update" to add the first one.</div>
      )}
    </div>
  </div>

  <div id="tab-contractors" hidden>
    <div class="section-head">
      <span class="section-title">Contractors &amp; Payment Schedules</span>
      <button class="btn btn-add">+ Add Contractor</button>
    </div>
    <div class="contractor-grid">
      {contractors.map(c => {
        const info   = ctrBudgets.get(c.id) ?? { budget: 0, itemCount: 0 };
        const budget = info.budget;
        const total  = c.sal.reduce((s, m) => s + m.pct, 0);
        return (
          <div class="card ctr-card" data-budget={budget.toFixed(2)} data-ctr-id={c.id}>
            <div class="ctr-header">
              <div>
                <div class="ctr-name">{c.name}</div>
                <div class="ctr-trade">{c.trade}</div>
                <div class="ctr-contact">{c.contact}</div>
                <div class="ctr-budget">
                  Budget: <strong class="ctr-budget-val">{fmt(budget)}</strong>
                  <span class="auto-tag">auto</span>
                  <span style="font-size:.6rem;color:var(--g3)">· {info.itemCount} items (net ex. VAT)</span>
                </div>
              </div>
              <div class="ctr-actions">
                <button class="btn-icon btn-edit-ctr" title="Edit">✎</button>
                <button class="btn-icon btn-del-ctr" title="Delete">🗑</button>
              </div>
            </div>
            <div style="overflow-x:auto">
            <table class="sal-table">
              <thead>
                <tr>
                  <th style="width:62px">Ref.</th>
                  <th>Milestone</th>
                  <th style="width:160px">Trigger</th>
                  <th class="right" style="width:120px">Amount (net €)</th>
                  <th class="right" style="width:58px">%</th>
                  <th style="width:36px"></th>
                </tr>
              </thead>
              <tbody>
                {c.sal.map(m => (
                  <tr>
                    <td><input class="sal-ref-input" type="text" value={m.id} style="width:52px;padding:.22rem .35rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:monospace;font-weight:700;color:var(--navy)" /></td>
                    <td><input class="sal-label-input" type="text" value={m.label} style="width:100%;padding:.22rem .4rem;border:1px solid var(--g2);border-radius:4px;font-size:.75rem;font-family:var(--sans)" /></td>
                    <td style="white-space:nowrap">
                      <select class="sal-trigger-type-input" style="padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:var(--sans);background:#fff">
                        <option value="signing" selected={m.triggerType === 'signing'}>On signing</option>
                        <option value="percent" selected={m.triggerType === 'percent'}>At %</option>
                        <option value="date"    selected={m.triggerType === 'date'}>On date</option>
                        <option value="final"   selected={m.triggerType === 'final'}>Final</option>
                      </select>
                      <input class="sal-trigger-pct-input" type="number" min="1" max="99" value={m.triggerPct ?? ''} placeholder="%" style={`width:38px;padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType !== 'percent' ? 'display:none' : ''}`} />
                      <input class="sal-trigger-date-input" type="date" value={m.triggerDate ?? ''} style={`padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType !== 'date' ? 'display:none' : ''}`} />
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                      <span style="font-size:.68rem;color:var(--g3);margin-right:.2rem">€</span>
                      <input class="sal-amt-input" type="number" min="0" step="0.01" value={(budget > 0 ? budget * m.pct / 100 : (m.fixedAmt ?? 0)).toFixed(2)} style="width:88px;padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.75rem;font-family:monospace;text-align:right" />
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                      <input class="sal-pct-input" type="number" min="0" max="100" step="0.01" value={m.pct} style="width:48px;padding:.22rem .3rem;border:1px solid var(--g2);border-radius:4px;font-size:.72rem;font-family:monospace;text-align:right;color:var(--g3)" />
                      <span style="font-size:.65rem;color:var(--g3);margin-left:.15rem">%</span>
                    </td>
                    <td>
                      <button class="btn-icon btn-del-milestone" title="Delete milestone" style="padding:.15rem .35rem;font-size:.7rem;color:var(--red);border-color:#fca5a5">🗑</button>
                    </td>
                  </tr>
                ))}
                <tr class="sal-total">
                  <td colspan="3" style="text-align:right;color:var(--slate);font-size:.68rem;letter-spacing:.04em">TOTAL</td>
                  <td class="sal-amt sal-total-amt-eur" style={`text-align:right;font-family:monospace;font-weight:700;color:${total === 100 ? 'var(--green)' : 'var(--red)'}`}>
                    {fmt(budget * total / 100)}
                  </td>
                  <td class="sal-total-amt" style={`text-align:right;font-weight:700;color:${total === 100 ? 'var(--green)' : 'var(--red)'};font-size:.72rem`}>
                    {total}% {total === 100 ? '✓' : '⚠'}
                  </td>
                  <td></td>
                </tr>
              </tbody>
            </table>
            </div>
            <div class="sal-add-row">
              <button class="btn btn-add btn-add-milestone" style="font-size:.7rem;padding:.3rem .7rem">+ Add milestone</button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div id="tab-works" hidden>
    <div class="section-head">
      <span class="section-title">Bill of Works</span>
      <div style="display:flex;gap:.75rem;align-items:center">
        <div class="legend">
          <span class="legend-item"><span class="auto-legend"></span> auto-calculated</span>
          <span class="legend-item"><span class="legend-dot" style="background:var(--amber)"></span> Extra works</span>
          <span class="legend-item"><span class="legend-dot" style="background:var(--red)"></span> Overrun</span>
        </div>
        <button class="btn btn-add">+ Add Category</button>
      </div>
    </div>
    <div class="card" style="overflow:hidden">
      <div class="works-wrap">
        <table class="works">
          <thead>
            <tr>
              <th style="width:60px">#</th>
              <th style="width:220px">Brief description<br/><span style="font-size:.5rem;opacity:.65;font-weight:400">click to expand full text</span></th>
              <th style="width:55px">Unit</th>
              <th class="right" style="width:90px">Contracted Qty</th>
              <th class="right" style="width:100px">Unit Price<br/><span style="font-size:.5rem;opacity:.65">net ex. VAT</span></th>
              <th class="right" style="width:105px">Budget<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th class="right" style="width:80px">Done Qty</th>
              <th class="right" style="width:105px">Value Done<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:105px">Progress<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:72px">Status<br/><span style="font-size:.5rem;opacity:.65">auto</span></th>
              <th style="width:130px">Contractor</th>
              <th style="width:62px"></th>
            </tr>
          </thead>
          <tbody>
            {enrichedCats.map(cat => {
              const catBudget = cat.items.filter((i:any) => !i.extra).reduce((s:number,i:any) => s+i.budget,0);
              const catDone   = cat.items.reduce((s:number,i:any) => s+i.valueDone,0);
              const catPerc   = catBudget > 0 ? catDone/catBudget*100 : 0;
              return (<>
                <tr class="cat-row" data-cat-id={cat.id}>
                  <td colspan="12">
                    <span class="cat-badge">{cat.id}</span>
                    {cat.label}
                    <span style="margin-left:.75rem;font-size:.65rem;font-weight:400;color:var(--slate)">
                      Budget: {fmt(catBudget)} &nbsp;|&nbsp; Done: {fmt(catDone)} &nbsp;|&nbsp; {catPerc.toFixed(0)}%
                    </span>
                    <span style="float:right;display:flex;gap:.3rem;margin-top:-.1rem">
                      <button class="btn btn-add btn-add-item" data-cat-id={cat.id} style="font-size:.62rem;padding:.2rem .55rem">+ Add item</button>
                      <button class="btn btn-extra btn-add-item" data-cat-id={cat.id} data-extra="true" style="font-size:.62rem;padding:.2rem .55rem">+ Add extra item</button>
                      <button class="btn-icon btn-del-cat" data-cat-id={cat.id} title="Delete category" style="font-size:.72rem;padding:.2rem .45rem;color:var(--red);border-color:#fca5a5">🗑 Delete</button>
                    </span>
                  </td>
                </tr>
                {cat.items.map((item:any) => {
                  const overrun       = !item.extra && item.done > item.qty;
                  const forceComplete = !!item.complete && !overrun && !item.extra;
                  const pColor  = overrun ? '#dc2626' : forceComplete ? '#22c55e' : item.extra ? '#f59e0b' : item.perc >= 100 ? '#22c55e' : item.perc > 0 ? '#f59e0b' : '#cbd5e1';
                  const barW    = item.perc !== null ? Math.min(item.perc,100) : 0;
                  return (
                    <tr class={`item${item.extra ? ' extra-row' : ''}`} data-cat-id={cat.id} data-item-id={item.id}>
                      <td class="item-id">{item.id}</td>
                      <td style="max-width:220px">
                        {item.extra && <span class="extra-badge">Extra</span>}
                        <span class="brief-link" data-id={item.id} data-cat-id={cat.id} data-brief={item.brief} data-fulldesc={item.fullDesc ?? ''} title="Click to view / edit full description">{item.brief || <em class="brief-empty">+ add description</em>}</span>
                      </td>
                      <td class="edit-col">
                        <select data-cat-id={cat.id} data-item-id={item.id} data-field="unit" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.72rem;width:60px">
                          {['m²','m³','lm','unit','lump','kg'].map((u:string) => <option selected={item.unit===u}>{u}</option>)}
                        </select>
                      </td>
                      <td class="editable-cell">
                        <input type="number" value={item.extra ? '' : item.qty} placeholder={item.extra ? '–' : ''} disabled={item.extra} style={item.extra ? 'color:var(--g3)' : ''} data-cat-id={cat.id} data-item-id={item.id} data-field="qty" />
                      </td>
                      <td class="editable-cell">
                        <input type="number" value={item.price} step="0.01" data-cat-id={cat.id} data-item-id={item.id} data-field="price" />
                      </td>
                      <td class="auto-cell auto-cell-budget">{item.extra ? '–' : fmt(item.budget)}</td>
                      <td class="editable-cell" style={overrun ? 'color:var(--red)' : ''}>
                        <input type="number" value={item.done} style={overrun ? 'color:var(--red);font-weight:700' : ''} data-cat-id={cat.id} data-item-id={item.id} data-field="done" />
                        {overrun && <span class="overrun-badge">↑</span>}
                      </td>
                      <td class="auto-cell auto-cell-done">{fmt(item.valueDone)}</td>
                      <td class="auto-bg" style="min-width:90px">
                        {item.extra ? '–' : item.perc !== null ? (
                          <div class="perc-wrap">
                            <div class="perc-mini"><div class="perc-fill" style={`width:${barW}%;background:${pColor}`}></div></div>
                            <span class="perc-num" style={`color:${pColor}`}>{item.perc.toFixed(0)}%</span>
                          </div>
                        ) : '–'}
                      </td>
                      <td class="auto-bg">
                        {overrun
                          ? <span class="status-badge status-overrun">Overrun</span>
                          : item.extra
                            ? (item.done > 0 ? <span class="status-badge status-complete">Complete</span> : <span class="status-badge status-pending">Not Started</span>)
                            : (forceComplete || item.perc >= 100)
                              ? <span class="status-badge status-complete is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to unmark completion">Complete</span>
                              : item.perc > 0
                                ? <span class="status-badge status-progress is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to mark as complete">In Progress</span>
                                : <span class="status-badge status-pending is-toggleable" data-cat-id={cat.id} data-item-id={item.id} title="Click to mark as complete">Not Started</span>
                        }
                      </td>
                      <td class="edit-col">
                        <select data-cat-id={cat.id} data-item-id={item.id} data-field="contractor" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.68rem;max-width:120px;width:100%">
                          <option value="">— none —</option>
                          {contractors.map(c => <option value={c.id} selected={item.contractor===c.id}>{c.name}</option>)}
                        </select>
                      </td>
                      <td style="white-space:nowrap">
                        <button class="btn-icon btn-del-item" data-cat-id={cat.id} data-item-id={item.id} title="Delete" style="margin-left:.2rem">🗑</button>
                      </td>
                    </tr>
                  );
                })}
                <tr class="subtotal">
                  <td colspan="5" style="text-align:right;padding-right:.75rem;color:var(--slate);font-weight:400;font-size:.68rem">Category {cat.id} subtotal</td>
                  <td style="text-align:right;font-family:monospace">{fmt(catBudget)}</td>
                  <td></td>
                  <td style="text-align:right;font-family:monospace;color:var(--navy)">{fmt(catDone)}</td>
                  <td colspan="4"></td>
                </tr>
              </>);
            })}
            <tr class="grand-total">
              <td colspan="5" style="text-align:right;padding-right:.75rem;letter-spacing:.04em;font-size:.72rem">TOTAL <span style="opacity:.55;font-weight:400">(net ex. VAT — contracted only)</span></td>
              <td style="text-align:right;font-family:monospace">{fmt(enrichedCats.flatMap((c:any)=>c.items).filter((i:any)=>!i.extra).reduce((s:number,i:any)=>s+i.budget,0))}</td>
              <td></td>
              <td style="text-align:right;font-family:monospace">{fmt(enrichedCats.flatMap((c:any)=>c.items).reduce((s:number,i:any)=>s+i.valueDone,0))}</td>
              <td colspan="4"></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- ADD / EDIT CONTRACTOR MODAL -->
<div id="ctr-modal" class="modal-overlay">
  <div class="modal-box" style="max-width:440px">
    <div class="modal-header">
      <span id="ctr-modal-title" style="font-size:.8rem;font-weight:700">Add Contractor</span>
      <button class="modal-close" id="ctr-modal-close">✕</button>
    </div>
    <div class="modal-body" style="display:flex;flex-direction:column;gap:.9rem">
      <div>
        <label>Contractor ID <span style="font-size:.6rem;font-weight:400;color:var(--g3)">(short code, e.g. C1)</span></label>
        <input id="ctr-id-inp" type="text" placeholder="C4"
          style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
      <div>
        <label>Company Name</label>
        <input id="ctr-name-inp" type="text" placeholder="Costruzioni Esempio S.r.l."
          style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
      <div>
        <label>Trade / Scope</label>
        <input id="ctr-trade-inp" type="text" placeholder="Structural & Civil Works"
          style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
      <div>
        <label>Contact</label>
        <input id="ctr-contact-inp" type="text" placeholder="ing. Mario Rossi — +39 080 555 0000"
          style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" id="ctr-cancel-btn">Cancel</button>
      <button class="btn btn-primary" id="ctr-save-btn">Save</button>
    </div>
  </div>
</div>

<div id="milestone-modal" class="modal-overlay">
  <div class="modal-box" style="max-width:420px">
    <div class="modal-header">
      <span style="font-size:.8rem;font-weight:700">Add Milestone</span>
      <span id="ms-ctr-name" style="font-size:.72rem;opacity:.75;flex:1;margin-left:.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
      <button class="modal-close" id="ms-close-btn">✕</button>
    </div>
    <div class="modal-body" style="display:flex;flex-direction:column;gap:.9rem">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
        <div>
          <label>Ref.</label>
          <input id="ms-ref" type="text" placeholder="e.g. SAL2" style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
        </div>
        <div>
          <label>Milestone name</label>
          <input id="ms-label" type="text" placeholder="e.g. Progress Payment 2" style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
        </div>
      </div>
      <div>
        <label>Trigger</label>
        <select id="ms-trigger-type" style="width:100%;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans);background:#fff">
          <option value="signing">On signing (contract signature)</option>
          <option value="percent">At % completion</option>
          <option value="date">On date</option>
          <option value="final">Final works / testing</option>
        </select>
      </div>
      <div id="ms-pct-row">
        <label>Completion % trigger</label>
        <input id="ms-trigger-pct" type="number" min="1" max="99" placeholder="e.g. 30" style="width:80px;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
      <div id="ms-date-row" style="display:none">
        <label>Due date</label>
        <input id="ms-trigger-date" type="date" style="width:180px;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
      </div>
      <div>
        <label>Payment amount</label>
        <div style="display:flex;gap:0;border:1px solid var(--g2);border-radius:6px;overflow:hidden;width:fit-content;margin-bottom:.55rem">
          <button type="button" id="ms-mode-pct" style="padding:.3rem .75rem;font-size:.75rem;font-weight:600;border:none;cursor:pointer;background:var(--navy);color:#fff">%</button>
          <button type="button" id="ms-mode-eur" style="padding:.3rem .75rem;font-size:.75rem;font-weight:600;border:none;cursor:pointer;background:#fff;color:var(--g3)">€ fisso</button>
        </div>
        <div id="ms-pct-amount-row" style="display:flex;align-items:center;gap:.4rem">
          <input id="ms-pct" type="number" min="0" max="100" placeholder="e.g. 20" style="width:80px;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:var(--sans)" />
          <span style="font-size:.8rem;color:var(--g3)">% del budget</span>
        </div>
        <div id="ms-eur-amount-row" style="display:none;flex-direction:column;gap:.3rem">
          <div style="display:flex;align-items:center;gap:.4rem">
            <span style="font-size:.82rem;color:var(--g3)">€</span>
            <input id="ms-eur" type="number" min="0" step="0.01" placeholder="e.g. 15000.00" style="width:140px;padding:.45rem .65rem;border:1px solid var(--g2);border-radius:6px;font-size:.82rem;font-family:monospace" />
          </div>
          <div id="ms-eur-hint" style="font-size:.7rem;color:var(--g3)"></div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" id="ms-cancel-btn">Cancel</button>
      <button class="btn btn-primary" id="ms-save-btn">Add Milestone</button>
    </div>
  </div>
</div>


<div id="desc-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-header">
      <span id="modal-item-id" class="modal-item-id"></span>
      <button class="modal-close" id="modal-close-btn">✕</button>
    </div>
    <div class="modal-body" style="display:flex;flex-direction:column;gap:.9rem">
      <div>
        <label>Brief description <span style="font-size:.6rem;font-weight:400;color:var(--g3)">(short text shown in the table)</span></label>
        <input type="text" id="modal-brief" placeholder="e.g. Reinforced concrete foundations"
          style="width:100%;padding:.5rem .75rem;border:1px solid var(--g2);border-radius:6px;font-size:.85rem;font-family:var(--sans)" />
      </div>
      <div>
        <label>Full technical description</label>
        <textarea id="modal-fulldesc" rows="7" placeholder="Enter the full technical description for this work item…"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" id="modal-cancel-btn">Cancel</button>
      <button class="btn btn-primary" id="modal-save-btn">Save</button>
    </div>
  </div>
</div>

<script define:vars={{ projectJson }}>
  let state = JSON.parse(projectJson);
  const fmtAmt = n => '€ ' + n.toLocaleString('en-GB', { minimumFractionDigits:2, maximumFractionDigits:2 });

  function findItem(catId, itemId) {
    const cat = state.categories.find(c => c.id === catId);
    return cat ? cat.items.find(i => i.id === itemId) : null;
  }

  const saveAllBtn = document.getElementById('save-all-btn');
  const saveStatus = document.getElementById('save-status');

  async function saveAll() {
    saveAllBtn.disabled = true;
    saveStatus.textContent = 'Saving…';
    saveStatus.style.color = 'rgba(255,255,255,.7)';
    try {
      const res = await fetch('/api/area-riservata/project', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(state)
      });
      const json = await res.json();
      if (!json.ok) throw new Error(json.error ?? 'Unknown error');
      saveStatus.textContent = 'Saved ✓';
      saveStatus.style.color = '#22c55e';
      setTimeout(() => { saveStatus.textContent = ''; }, 3000);
    } catch (err) {
      saveStatus.textContent = 'Error: ' + err.message;
      saveStatus.style.color = '#fca5a5';
    } finally {
      saveAllBtn.disabled = false;
    }
  }

  saveAllBtn.addEventListener('click', saveAll);
  document.querySelectorAll('.save-trigger').forEach(btn => btn.addEventListener('click', saveAll));

  // ── Project switcher dropdown ─────────────────────────────────────────────
  const switcherDrop = document.getElementById('proj-switcher-drop');
  document.getElementById('proj-switcher-btn').addEventListener('click', e => {
    e.stopPropagation();
    switcherDrop.classList.toggle('is-open');
  });
  document.addEventListener('click', e => {
    // Close switcher if clicking outside
    if (!switcherDrop.contains(e.target)) switcherDrop.classList.remove('is-open');
    // Navigate on any [data-goto] button
    const btn = e.target.closest('[data-goto]');
    if (btn) { window.location.href = btn.dataset.goto; }
  });

  // Delete project
  document.addEventListener('click', async e => {
    const btn = e.target.closest('.btn-del-project');
    if (!btn) return;
    const id   = btn.dataset.projId;
    const name = btn.dataset.projName;
    if (!confirm(`Delete project "${name}"?\n\nThis cannot be undone.`)) return;
    btn.disabled = true; btn.textContent = 'Deleting…';
    const res  = await fetch(`/api/area-riservata/projects?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    const json = await res.json();
    if (json.ok) { btn.closest('.proj-card').remove(); }
    else { alert('Error: ' + json.error); btn.disabled = false; btn.textContent = 'Delete'; }
  });

  document.getElementById('proj-drop-new').addEventListener('click', async () => {
    switcherDrop.classList.remove('is-open');
    const name = prompt('Project name:')?.trim();
    if (!name) return;
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else alert('Error: ' + json.error);
  });

  const tabs = document.querySelectorAll('.tab-btn');
  const panels = {
    projects:    document.getElementById('tab-projects'),
    project:     document.getElementById('tab-project'),
    contractors: document.getElementById('tab-contractors'),
    works:       document.getElementById('tab-works'),
  };
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      Object.entries(panels).forEach(([k, el]) => { if (el) el.hidden = (k !== btn.dataset.tab); });
    });
  });

  // New Project button (in Projects tab) — delegates to the same handler
  document.getElementById('btn-new-project').addEventListener('click', () =>
    document.getElementById('proj-drop-new').click());

  // From template button
  document.getElementById('btn-from-template').addEventListener('click', async () => {
    const name = prompt('Project name (will be pre-filled with example data):')?.trim();
    if (!name) return;
    const btn = document.getElementById('btn-from-template');
    btn.disabled = true; btn.textContent = 'Creating…';
    const res  = await fetch('/api/area-riservata/projects', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, template: true })
    });
    const json = await res.json();
    if (json.ok) window.location.href = `/area-riservata/admin?p=${json.id}`;
    else { alert('Error: ' + json.error); btn.disabled = false; btn.textContent = '↺ From template'; }
  });

  document.querySelectorAll('[data-info]').forEach(el => {
    el.addEventListener('input', () => {
      const field = el.dataset.info;
      state.info[field] = el.type === 'number' ? parseFloat(el.value) || 0 : el.value;
    });
  });

  // ── Progress Updates ─────────────────────────────────────────────────────
  if (!state.updates) state.updates = [];

  function syncUpdatesFromDOM() {
    const rows = document.querySelectorAll('#updates-admin-tbody tr[data-update-num]');
    state.updates = Array.from(rows).map(row => ({
      num:  parseInt(row.dataset.updateNum),
      date: row.querySelector('.upd-date-input').value,
      note: row.querySelector('.upd-note-input').value,
    }));
  }

  function buildUpdateRow(num, date, note) {
    const tr = document.createElement('tr');
    tr.dataset.updateNum = num;
    tr.innerHTML = [
      `<td><span class="upd-num-badge">#${num}</span></td>`,
      `<td><input type="date" class="upd-date-input" value="${date}" style="width:120px;padding:.3rem .4rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem" /></td>`,
      `<td><textarea class="upd-note-input" rows="2" style="width:100%;padding:.3rem .5rem;border:1px solid var(--g2);border-radius:5px;font-size:.78rem;resize:vertical;font-family:var(--sans)">${note}</textarea></td>`,
      `<td><button class="btn-icon btn-del-update" style="color:var(--red);border-color:#fca5a5" title="Delete">🗑</button></td>`,
    ].join('');
    return tr;
  }

  document.getElementById('btn-add-update').addEventListener('click', () => {
    const nextNum = (state.info.updateNum || 0) + 1;
    state.info.updateNum = nextNum;
    const numField = document.getElementById('update-num-field');
    if (numField) numField.value = nextNum;

    const today = new Date().toISOString().slice(0, 10);
    if (!state.updates) state.updates = [];
    state.updates.unshift({ num: nextNum, date: today, note: '' });

    const tbody = document.getElementById('updates-admin-tbody');
    const emptyMsg = document.getElementById('updates-empty-msg');
    if (emptyMsg) emptyMsg.remove();
    tbody.prepend(buildUpdateRow(nextNum, today, ''));
    tbody.querySelector('.upd-note-input')?.focus();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-update');
    if (!btn) return;
    const row = btn.closest('tr[data-update-num]');
    if (!row) return;
    if (!confirm('Delete this progress update?')) return;
    const num = parseInt(row.dataset.updateNum);
    state.updates = (state.updates || []).filter(u => u.num !== num);
    row.remove();
  });

  document.addEventListener('input', e => {
    if (e.target.closest('#updates-admin-tbody')) {
      syncUpdatesFromDOM();
      return;
    }
  });

  document.addEventListener('input', e => {
    const el = e.target;
    const { catId, itemId, field } = el.dataset;
    if (!catId || !itemId || !field) return;
    const item = findItem(catId, itemId);
    if (!item) return;
    const newVal = el.type === 'number' ? (parseFloat(el.value) || 0) : el.type === 'checkbox' ? el.checked : el.value;
    item[field] = newVal;
    const row = el.closest('tr');
    if (!row || !(field === 'qty' || field === 'price' || field === 'done')) return;

    const budget   = item.extra ? 0 : (item.qty || 0) * (item.price || 0);
    const valDone  = (item.done || 0) * (item.price || 0);
    const overrun       = !item.extra && (item.done || 0) > (item.qty || 0);
    const forceComplete = !!item.complete && !overrun && !item.extra;
    const percActual    = (!item.extra && budget > 0) ? (valDone / budget) * 100 : 0;
    const barW          = Math.min(percActual, 100);
    const pColor        = overrun ? '#dc2626' : forceComplete ? '#22c55e' : item.extra ? '#f59e0b' : percActual >= 100 ? '#22c55e' : percActual > 0 ? '#f59e0b' : '#cbd5e1';

    // Auto cells
    const bCell = row.querySelector('.auto-cell-budget');
    const dCell = row.querySelector('.auto-cell-done');
    if (bCell) bCell.textContent = item.extra ? '–' : fmtAmt(budget);
    if (dCell) dCell.textContent = fmtAmt(valDone);

    // Done cell — overrun color + badge
    const doneTd  = row.querySelector('[data-field="done"]')?.closest('td');
    if (doneTd) {
      const inp = doneTd.querySelector('input');
      if (inp) inp.style.color = overrun ? 'var(--red)' : '';
      let badge = doneTd.querySelector('.overrun-badge');
      if (overrun && !badge) {
        const s = document.createElement('span'); s.className = 'overrun-badge'; s.textContent = '↑';
        doneTd.appendChild(s);
      } else if (!overrun && badge) { badge.remove(); }
    }

    // Progress bar
    const percWrap = row.querySelector('.perc-wrap');
    if (percWrap) {
      const fill = percWrap.querySelector('.perc-fill');
      const num  = percWrap.querySelector('.perc-num');
      if (fill) { fill.style.width = `${barW}%`; fill.style.background = pColor; }
      if (num)  { num.textContent = `${Math.round(percActual)}%`; num.style.color = pColor; }
    }

    // Status badge
    const statusSpan = row.querySelector('.status-badge');
    if (statusSpan) {
      if (item.extra) {
        if ((item.done || 0) > 0) { statusSpan.className = 'status-badge status-complete'; statusSpan.textContent = 'Complete'; }
        else                      { statusSpan.className = 'status-badge status-pending';  statusSpan.textContent = 'Not Started'; }
      } else if (overrun)                    { statusSpan.className = 'status-badge status-overrun';  statusSpan.textContent = 'Overrun'; }
      else if (forceComplete || percActual >= 100) { statusSpan.className = 'status-badge status-complete is-toggleable'; statusSpan.textContent = 'Complete'; }
      else if (percActual > 0)               { statusSpan.className = 'status-badge status-progress is-toggleable'; statusSpan.textContent = 'In Progress'; }
      else                                   { statusSpan.className = 'status-badge status-pending is-toggleable';  statusSpan.textContent = 'Not Started'; }
    }
  });

  // ── Toggle complete flag ────────────────────────────────────────────────
  document.addEventListener('click', e => {
    const badge = e.target.closest('.status-badge.is-toggleable');
    if (!badge) return;
    const { catId, itemId } = badge.dataset;
    if (!catId || !itemId) return;
    const item = findItem(catId, itemId);
    if (!item || item.extra) return;
    item.complete = !item.complete;
    const row = badge.closest('tr');
    const overrun = !item.extra && (item.done || 0) > (item.qty || 0);
    const budget  = (item.qty || 0) * (item.price || 0);
    const valDone = (item.done || 0) * (item.price || 0);
    const perc    = budget > 0 ? valDone / budget * 100 : 0;
    const force   = item.complete && !overrun;
    const pColor  = overrun ? '#dc2626' : force ? '#22c55e' : perc >= 100 ? '#22c55e' : perc > 0 ? '#f59e0b' : '#cbd5e1';
    // Update badge
    if (force || perc >= 100) { badge.className = 'status-badge status-complete is-toggleable'; badge.textContent = 'Complete'; badge.title = 'Click to unmark completion'; }
    else if (perc > 0)        { badge.className = 'status-badge status-progress is-toggleable'; badge.textContent = 'In Progress'; badge.title = 'Click to mark as complete'; }
    else                      { badge.className = 'status-badge status-pending is-toggleable';  badge.textContent = 'Not Started'; badge.title = 'Click to mark as complete'; }
    // Update progress bar color
    if (row) {
      const fill = row.querySelector('.perc-fill');
      const num  = row.querySelector('.perc-num');
      if (fill) fill.style.background = pColor;
      if (num)  num.style.color = pColor;
    }
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-item');
    if (!btn) return;
    const { catId, itemId } = btn.dataset;
    const item = state.categories.find(c => c.id === catId)?.items.find(i => i.id === itemId);
    const label = item?.brief ? `"${item.brief}"` : `item ${itemId}`;
    if (!confirm(`Delete ${label}?\n\nThis cannot be undone.`)) return;
    const cat = state.categories.find(c => c.id === catId);
    if (cat) cat.items = cat.items.filter(i => i.id !== itemId);
    btn.closest('tr')?.remove();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-cat');
    if (!btn) return;
    const { catId } = btn.dataset;
    state.categories = state.categories.filter(c => c.id !== catId);
    document.querySelectorAll(`[data-cat-id="${catId}"]`).forEach(row => row.remove());
  });

  // ── SAL milestone helpers ─────────────────────────────────────────────────
  function buildSalRowHtml(m, budget) {
    const inp = 'padding:.22rem .35rem;border:1px solid var(--g2);border-radius:4px;font-family:var(--sans)';
    const triggerOpts = ['signing','percent','date','final'].map(v =>
      `<option value="${v}"${m.triggerType===v?' selected':''}>${v==='signing'?'On signing':v==='percent'?'At %':v==='date'?'On date':'Final'}</option>`
    ).join('');
    const amtVal = budget > 0 ? (budget * m.pct / 100).toFixed(2) : (m.fixedAmt != null ? parseFloat(m.fixedAmt).toFixed(2) : (0).toFixed(2));
    return [
      `<td><input class="sal-ref-input" type="text" value="${m.id}" style="width:52px;${inp};font-size:.72rem;font-family:monospace;font-weight:700;color:var(--navy)" /></td>`,
      `<td><input class="sal-label-input" type="text" value="${m.label}" style="width:100%;${inp};font-size:.75rem" /></td>`,
      `<td style="white-space:nowrap">`,
        `<select class="sal-trigger-type-input" style="${inp};font-size:.72rem;background:#fff">${triggerOpts}</select>`,
        `<input class="sal-trigger-pct-input" type="number" min="1" max="99" value="${m.triggerPct??''}" placeholder="%" style="width:38px;${inp};font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType!=='percent'?'display:none':''}" />`,
        `<input class="sal-trigger-date-input" type="date" value="${m.triggerDate??''}" style="${inp};font-size:.72rem;font-family:monospace;margin-left:.3rem;${m.triggerType!=='date'?'display:none':''}" />`,
      `</td>`,
      `<td style="text-align:right;white-space:nowrap">`,
        `<span style="font-size:.68rem;color:var(--g3);margin-right:.2rem">€</span>`,
        `<input class="sal-amt-input" type="number" min="0" step="0.01" value="${amtVal}" style="width:88px;${inp};font-size:.75rem;font-family:monospace;text-align:right" />`,
      `</td>`,
      `<td style="text-align:right;white-space:nowrap">`,
        `<input class="sal-pct-input" type="number" min="0" max="100" step="0.01" value="${m.pct}" style="width:48px;${inp};font-size:.72rem;font-family:monospace;text-align:right;color:var(--g3)" />`,
        `<span style="font-size:.65rem;color:var(--g3);margin-left:.15rem">%</span>`,
      `</td>`,
      `<td><button class="btn-icon btn-del-milestone" style="padding:.15rem .35rem;font-size:.7rem;color:var(--red);border-color:#fca5a5">🗑</button></td>`,
    ].join('');
  }

  function recalcCard(card) {
    const budget = parseFloat(card.dataset.budget ?? '0');
    let totalPct = 0;
    card.querySelectorAll('tbody tr:not(.sal-total)').forEach(row => {
      const pct = parseFloat(row.querySelector('.sal-pct-input')?.value ?? '0') || 0;
      totalPct += pct;
    });
    const ok = Math.abs(totalPct - 100) < 0.01;
    const color = ok ? 'var(--green)' : 'var(--red)';
    const eurCell = card.querySelector('.sal-total-amt-eur');
    const pctCell = card.querySelector('.sal-total-amt');
    if (eurCell) { eurCell.textContent = fmtAmt(budget * totalPct / 100); eurCell.style.color = color; }
    if (pctCell)  { pctCell.textContent = totalPct.toFixed(2).replace(/\.00$/,'') + '% ' + (ok ? '✓' : '⚠'); pctCell.style.color = color; }
  }

  function syncSalFromCard(card) {
    const ctrId  = card.dataset.ctrId;
    const ctr    = state.contractors.find(c => c.id === ctrId);
    if (!ctr) return;
    const budget = parseFloat(card.dataset.budget ?? '0') || 0;
    ctr.sal = Array.from(card.querySelectorAll('tbody tr:not(.sal-total)')).map(row => {
      const pct      = parseFloat(row.querySelector('.sal-pct-input')?.value) || 0;
      const amtRaw   = parseFloat(row.querySelector('.sal-amt-input')?.value) || 0;
      const fixedAmt = budget <= 0 && amtRaw > 0 ? amtRaw : null;
      return {
        id:          row.querySelector('.sal-ref-input')?.value.trim() ?? '',
        label:       row.querySelector('.sal-label-input')?.value.trim() ?? '',
        triggerType: row.querySelector('.sal-trigger-type-input')?.value ?? 'signing',
        triggerPct:  row.querySelector('.sal-trigger-type-input')?.value === 'percent'
                       ? (parseFloat(row.querySelector('.sal-trigger-pct-input')?.value) || null)
                       : null,
        triggerDate: row.querySelector('.sal-trigger-type-input')?.value === 'date'
                       ? (row.querySelector('.sal-trigger-date-input')?.value || null)
                       : null,
        pct,
        ...(fixedAmt != null ? { fixedAmt } : {}),
      };
    });
  }

  // Inline SAL editing
  document.addEventListener('input', e => {
    const row = e.target.closest('.sal-table tbody tr:not(.sal-total)');
    if (!row) return;
    const card = row.closest('.ctr-card');
    if (!card) return;
    if (e.target.classList.contains('sal-trigger-type-input')) {
      const pctInput  = row.querySelector('.sal-trigger-pct-input');
      const dateInput = row.querySelector('.sal-trigger-date-input');
      if (pctInput)  pctInput.style.display  = e.target.value === 'percent' ? '' : 'none';
      if (dateInput) dateInput.style.display = e.target.value === 'date'    ? '' : 'none';
    }
    if (e.target.classList.contains('sal-amt-input')) {
      const budget = parseFloat(card.dataset.budget ?? '0') || 0;
      const amt    = parseFloat(e.target.value) || 0;
      const pctIn  = row.querySelector('.sal-pct-input');
      if (pctIn) pctIn.value = budget > 0 ? ((amt / budget) * 100).toFixed(2) : '0';
      recalcCard(card);
    }
    if (e.target.classList.contains('sal-pct-input')) {
      const budget = parseFloat(card.dataset.budget ?? '0') || 0;
      const pct    = parseFloat(e.target.value) || 0;
      const amtIn  = row.querySelector('.sal-amt-input');
      if (amtIn) amtIn.value = (budget * pct / 100).toFixed(2);
      recalcCard(card);
    }
    syncSalFromCard(card);
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-milestone');
    if (!btn) return;
    const row = btn.closest('tr');
    const card = btn.closest('.ctr-card');
    row?.remove();
    if (card) { recalcCard(card); syncSalFromCard(card); }
  });

  const msModal          = document.getElementById('milestone-modal');
  const msCtrName        = document.getElementById('ms-ctr-name');
  const msRef            = document.getElementById('ms-ref');
  const msLabel          = document.getElementById('ms-label');
  const msTriggerType    = document.getElementById('ms-trigger-type');
  const msTriggerPct     = document.getElementById('ms-trigger-pct');
  const msPct            = document.getElementById('ms-pct');
  const msPctRow         = document.getElementById('ms-pct-row');
  const msDateRow        = document.getElementById('ms-date-row');
  const msTriggerDate    = document.getElementById('ms-trigger-date');
  const msModeBtn        = document.getElementById('ms-mode-pct');
  const msModeBtnEur     = document.getElementById('ms-mode-eur');
  const msPctAmountRow   = document.getElementById('ms-pct-amount-row');
  const msEurAmountRow   = document.getElementById('ms-eur-amount-row');
  const msEurInput       = document.getElementById('ms-eur');
  const msEurHint        = document.getElementById('ms-eur-hint');
  let msTargetCard       = null;
  let msAmountMode       = 'pct'; // 'pct' | 'eur'

  function setMsAmountMode(mode) {
    msAmountMode = mode;
    if (mode === 'pct') {
      msModeBtn.style.background    = 'var(--navy)'; msModeBtn.style.color    = '#fff';
      msModeBtnEur.style.background = '#fff';        msModeBtnEur.style.color = 'var(--g3)';
      msPctAmountRow.style.display  = 'flex';
      msEurAmountRow.style.display  = 'none';
    } else {
      msModeBtnEur.style.background = 'var(--navy)'; msModeBtnEur.style.color    = '#fff';
      msModeBtn.style.background    = '#fff';        msModeBtn.style.color    = 'var(--g3)';
      msPctAmountRow.style.display  = 'none';
      msEurAmountRow.style.display  = 'flex';
      updateEurHint();
    }
  }

  function updateEurHint() {
    if (!msTargetCard) return;
    const budget = parseFloat(msTargetCard.dataset.budget ?? '0');
    if (budget <= 0) { msEurHint.textContent = ''; return; }
    const alreadyPct = Array.from(msTargetCard.querySelectorAll('tbody tr:not(.sal-total) .sal-pct-input'))
      .reduce((s, inp) => s + (parseFloat(inp.value) || 0), 0);
    const alreadyEur = budget * alreadyPct / 100;
    const remaining  = budget - alreadyEur;
    msEurHint.textContent = `Budget: ${fmtAmt(budget)} — già allocato: ${fmtAmt(alreadyEur)} — residuo: ${fmtAmt(remaining)}`;
  }

  msModeBtn.addEventListener('click',    () => setMsAmountMode('pct'));
  msModeBtnEur.addEventListener('click', () => setMsAmountMode('eur'));
  msEurInput.addEventListener('input', updateEurHint);

  msTriggerType.addEventListener('change', () => {
    msPctRow.style.display  = msTriggerType.value === 'percent' ? '' : 'none';
    msDateRow.style.display = msTriggerType.value === 'date'    ? '' : 'none';
  });
  msPctRow.style.display = 'none';

  function openMsModal(card) {
    msTargetCard = card;
    msCtrName.textContent = card.querySelector('.ctr-name')?.textContent ?? '';
    msRef.value = ''; msLabel.value = ''; msPct.value = ''; msTriggerPct.value = ''; msEurInput.value = ''; msTriggerDate.value = '';
    msTriggerType.value = 'signing'; msPctRow.style.display = 'none'; msDateRow.style.display = 'none';
    setMsAmountMode('pct');
    msModal.classList.add('is-open'); msRef.focus();
  }
  function closeMsModal() { msModal.classList.remove('is-open'); msTargetCard = null; }

  document.getElementById('ms-close-btn').addEventListener('click', closeMsModal);
  document.getElementById('ms-cancel-btn').addEventListener('click', closeMsModal);
  msModal.addEventListener('click', e => { if (e.target === msModal) closeMsModal(); });

  document.getElementById('ms-save-btn').addEventListener('click', () => {
    if (!msTargetCard) return;
    const ref    = msRef.value.trim() || '—';
    const label  = msLabel.value.trim() || 'New Milestone';
    const ttype  = msTriggerType.value;
    const tpct   = parseFloat(msTriggerPct.value) || null;
    const tdate  = ttype === 'date' ? (msTriggerDate.value || null) : null;
    const budget = parseFloat(msTargetCard.dataset.budget ?? '0');
    let pct;
    let fixedAmt = null;
    if (msAmountMode === 'eur') {
      const eur = parseFloat(msEurInput.value) || 0;
      fixedAmt = eur;
      pct = budget > 0 ? (eur / budget) * 100 : 0;
    } else {
      pct = parseFloat(msPct.value) || 0;
    }
    const tbody   = msTargetCard.querySelector('tbody');
    const totalRow = tbody.querySelector('.sal-total');
    const tr = document.createElement('tr');
    tr.innerHTML = buildSalRowHtml({ id: ref, label, triggerType: ttype, triggerPct: tpct, triggerDate: tdate, pct, fixedAmt }, budget);
    tbody.insertBefore(tr, totalRow);
    recalcCard(msTargetCard);
    syncSalFromCard(msTargetCard);
    closeMsModal();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-milestone');
    if (!btn) return;
    const card = btn.closest('.ctr-card');
    if (card) openMsModal(card);
  });

  const descModal     = document.getElementById('desc-modal');
  const modalIdEl     = document.getElementById('modal-item-id');
  const modalBriefInp = document.getElementById('modal-brief');
  const modalText     = document.getElementById('modal-fulldesc');
  let   descActiveCatId  = null;
  let   descActiveLinkEl = null;

  function openDescModal(catId, id, brief, fullDesc, linkEl) {
    descActiveCatId  = catId;
    descActiveLinkEl = linkEl ?? null;
    modalIdEl.textContent = id;
    modalBriefInp.value   = brief;
    modalText.value       = fullDesc;
    descModal.classList.add('is-open');
    modalBriefInp.focus();
  }
  function closeDescModal() { descModal.classList.remove('is-open'); descActiveCatId = null; descActiveLinkEl = null; }

  document.getElementById('modal-close-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-cancel-btn').addEventListener('click', closeDescModal);
  document.getElementById('modal-save-btn').addEventListener('click', () => {
    const itemId  = modalIdEl.textContent;
    const brief   = modalBriefInp.value.trim();
    const fullDesc = modalText.value;
    const item = findItem(descActiveCatId, itemId);
    if (item) { item.brief = brief; item.fullDesc = fullDesc; }
    if (descActiveLinkEl) {
      descActiveLinkEl.dataset.brief    = brief;
      descActiveLinkEl.dataset.fulldesc = fullDesc;
      descActiveLinkEl.innerHTML = brief
        ? brief
        : '<em class="brief-empty">+ add description</em>';
    }
    closeDescModal();
  });
  descModal.addEventListener('click', e => { if (e.target === descModal) closeDescModal(); });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (msModal.classList.contains('is-open'))   { closeMsModal();   return; }
    if (descModal.classList.contains('is-open')) { closeDescModal(); return; }
    if (ctrModal.classList.contains('is-open'))  { closeCtrModal();  return; }
  });

  // ── Contractor modal ──────────────────────────────────────────────────────
  const ctrModal     = document.getElementById('ctr-modal');
  const ctrModalTitle= document.getElementById('ctr-modal-title');
  const ctrIdInp     = document.getElementById('ctr-id-inp');
  const ctrNameInp   = document.getElementById('ctr-name-inp');
  const ctrTradeInp  = document.getElementById('ctr-trade-inp');
  const ctrContactInp= document.getElementById('ctr-contact-inp');
  let   ctrEditId    = null;

  function openCtrModal(ctr) {
    ctrEditId = ctr?.id ?? null;
    ctrModalTitle.textContent = ctr ? 'Edit Contractor' : 'Add Contractor';
    ctrIdInp.value      = ctr?.id      ?? '';
    ctrNameInp.value    = ctr?.name    ?? '';
    ctrTradeInp.value   = ctr?.trade   ?? '';
    ctrContactInp.value = ctr?.contact ?? '';
    ctrIdInp.disabled   = !!ctr;
    ctrModal.classList.add('is-open');
    ctrNameInp.focus();
  }
  function closeCtrModal() { ctrModal.classList.remove('is-open'); ctrEditId = null; }

  document.getElementById('ctr-modal-close').addEventListener('click', closeCtrModal);
  document.getElementById('ctr-cancel-btn').addEventListener('click', closeCtrModal);
  ctrModal.addEventListener('click', e => { if (e.target === ctrModal) closeCtrModal(); });

  document.getElementById('ctr-save-btn').addEventListener('click', () => {
    const id      = ctrIdInp.value.trim();
    const name    = ctrNameInp.value.trim();
    const trade   = ctrTradeInp.value.trim();
    const contact = ctrContactInp.value.trim();
    if (!id || !name) { alert('ID and Name are required.'); return; }

    if (ctrEditId) {
      const ctr = state.contractors.find(c => c.id === ctrEditId);
      if (ctr) { ctr.name = name; ctr.trade = trade; ctr.contact = contact; }
      const card = document.querySelector(`.ctr-card[data-ctr-id="${ctrEditId}"]`);
      if (card) {
        card.querySelector('.ctr-name').textContent    = name;
        card.querySelector('.ctr-trade').textContent   = trade;
        card.querySelector('.ctr-contact').textContent = contact;
      }
    } else {
      if (state.contractors.find(c => c.id === id)) { alert('Contractor ID already exists.'); return; }
      const newCtr = { id, name, trade, contact, sal: [] };
      state.contractors.push(newCtr);
      const grid = document.querySelector('.contractor-grid');
      const div = document.createElement('div');
      div.className = 'card ctr-card';
      div.dataset.budget = '0';
      div.dataset.ctrId  = id;
      div.innerHTML = `
        <div class="ctr-header">
          <div>
            <div class="ctr-name">${name}</div>
            <div class="ctr-trade">${trade}</div>
            <div class="ctr-contact">${contact}</div>
            <div class="ctr-budget">Budget: <strong class="ctr-budget-val">€ 0.00</strong> <span class="auto-tag">auto</span></div>
          </div>
          <div class="ctr-actions">
            <button class="btn-icon btn-edit-ctr" title="Edit">✎</button>
            <button class="btn-icon btn-del-ctr" title="Delete">🗑</button>
          </div>
        </div>
        <table class="sal-table"><thead><tr><th style="width:50px">Ref.</th><th>Milestone</th><th style="width:90px">Trigger</th><th class="right" style="width:115px">Amount (net) <span class="auto-tag">auto</span></th><th style="width:60px"></th></tr></thead>
        <tbody><tr class="sal-total"><td colspan="3" style="text-align:right;color:var(--slate);font-size:.68rem;letter-spacing:.04em">TOTAL</td><td class="sal-amt sal-total-amt" style="color:var(--red);font-weight:700">€ 0.00 ⚠ 0%</td><td></td></tr></tbody></table>
        <div class="sal-add-row"><button class="btn btn-add btn-add-milestone" style="font-size:.7rem;padding:.3rem .7rem">+ Add milestone</button></div>`;
      grid.appendChild(div);
    }
    closeCtrModal();
  });

  // Add contractor button
  document.querySelector('.contractor-grid')?.closest('#tab-contractors')
    ?.querySelector('.btn-add')
    ?.addEventListener('click', () => openCtrModal(null));

  // Edit contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-edit-ctr');
    if (!btn) return;
    const ctrId = btn.closest('.ctr-card')?.dataset.ctrId;
    const ctr   = state.contractors.find(c => c.id === ctrId);
    if (ctr) openCtrModal(ctr);
  });

  // Delete contractor
  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-del-ctr');
    if (!btn) return;
    const card  = btn.closest('.ctr-card');
    const ctrId = card?.dataset.ctrId;
    if (!ctrId || !confirm(`Delete contractor "${ctrId}"?`)) return;
    state.contractors = state.contractors.filter(c => c.id !== ctrId);
    card.remove();
  });

  // ── Brief description click ───────────────────────────────────────────────
  document.addEventListener('click', e => {
    const el = e.target.closest('.brief-link');
    if (!el) return;
    openDescModal(el.dataset.catId, el.dataset.id, el.dataset.brief ?? '', el.dataset.fulldesc ?? '', el);
  });

  // ── Add item / Add extra item ─────────────────────────────────────────────
  function buildItemRow(catId, item) {
    const opts = state.contractors.map(c =>
      `<option value="${c.id}"${item.contractor===c.id?' selected':''}>${c.name}</option>`).join('');
    const isX = item.extra;
    const qtyDisabled = isX ? ' disabled' : '';
    const qtyStyle    = isX ? ' style="color:var(--g3)"' : '';
    const qtyPh       = isX ? '–' : '';
    const percHtml    = isX ? '–' : '<div class="perc-wrap"><div class="perc-mini"><div class="perc-fill" style="width:0%;background:#cbd5e1"></div></div><span class="perc-num" style="color:#cbd5e1">0%</span></div>';
    const statusHtml  = isX
      ? (item.done > 0 ? '<span class="status-badge status-complete">Complete</span>' : '<span class="status-badge status-pending">Not Started</span>')
      : item.complete
        ? `<span class="status-badge status-complete is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}" title="Click to unmark completion">Complete</span>`
        : `<span class="status-badge status-pending is-toggleable" data-cat-id="${catId}" data-item-id="${item.id}" title="Click to mark as complete">Not Started</span>`;
    const unitOpts    = ['m²','m³','lm','unit','lump','kg'].map(u=>`<option${item.unit===u?' selected':''}>${u}</option>`).join('');
    return [
      `<tr class="item${isX?' extra-row':''}" data-cat-id="${catId}" data-item-id="${item.id}">`,
      `<td class="item-id">${item.id}</td>`,
      `<td style="max-width:220px">${isX?'<span class="extra-badge">Extra</span>':''}<span class="brief-link" data-id="${item.id}" data-cat-id="${catId}" data-brief="" data-fulldesc="" title="Click to view / edit full description"><em class="brief-empty">+ add description</em></span></td>`,
      `<td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="unit" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.72rem;width:60px">${unitOpts}</select></td>`,
      `<td class="editable-cell"><input type="number" value="${isX?'':0}" placeholder="${qtyPh}"${qtyDisabled}${qtyStyle} data-cat-id="${catId}" data-item-id="${item.id}" data-field="qty" /></td>`,
      `<td class="editable-cell"><input type="number" value="0" step="0.01" data-cat-id="${catId}" data-item-id="${item.id}" data-field="price" /></td>`,
      `<td class="auto-cell auto-cell-budget">${isX?'–':'€ 0.00'}</td>`,
      `<td class="editable-cell"><input type="number" value="${item.done||0}" data-cat-id="${catId}" data-item-id="${item.id}" data-field="done" /></td>`,
      `<td class="auto-cell auto-cell-done">€ 0.00</td>`,
      `<td class="auto-bg" style="min-width:90px">${percHtml}</td>`,
      `<td class="auto-bg">${statusHtml}</td>`,
      `<td class="edit-col"><select data-cat-id="${catId}" data-item-id="${item.id}" data-field="contractor" style="border:1px solid var(--g2);border-radius:4px;padding:.2rem .3rem;font-size:.68rem;max-width:120px;width:100%"><option value="">— none —</option>${opts}</select></td>`,
      `<td style="white-space:nowrap"><button class="btn-icon btn-del-item" data-cat-id="${catId}" data-item-id="${item.id}" title="Delete" style="margin-left:.2rem">🗑</button></td>`,
      `</tr>`
    ].join('');
  }

  // ── Add item / Add extra item ─────────────────────────────────────────────
  function itemIdNum(id) { const m = id.match(/\.(\d+)$/); return m ? parseInt(m[1]) : 0; }

  function addItem(catId, isExtra) {
    const cat = state.categories.find(c => c.id === catId);
    if (!cat) return;
    const nums = cat.items.map(i => itemIdNum(i.id));
    const next = (nums.length ? Math.max(...nums) : 0) + 1;
    const id   = `${catId}.${String(next).padStart(2, '0')}`;
    const item = { id, brief: '', fullDesc: '', unit: 'm²', qty: 0, price: 0, done: 0, complete: false, contractor: '', extra: isExtra };
    cat.items.push(item);
    const allItemRows = [...document.querySelectorAll(`tr.item[data-cat-id="${catId}"]`)];
    const rowHtml = buildItemRow(catId, item);
    if (allItemRows.length > 0) allItemRows[allItemRows.length - 1].insertAdjacentHTML('afterend', rowHtml);
    else document.querySelector(`tr.cat-row[data-cat-id="${catId}"]`).insertAdjacentHTML('afterend', rowHtml);
  }

  document.addEventListener('click', e => {
    const btn = e.target.closest('.btn-add-item');
    if (!btn) return;
    addItem(btn.dataset.catId, btn.dataset.extra === 'true');
  });

  // ── Add Category ──────────────────────────────────────────────────────────
  document.querySelector('#tab-works .section-head .btn-add')?.addEventListener('click', () => {
    const id = prompt('Category ID (e.g. I):')?.trim().toUpperCase();
    if (!id) return;
    if (state.categories.find(c => c.id === id)) { alert('Category ID already exists.'); return; }
    const label = prompt('Category label (e.g. Flooring):')?.trim();
    if (!label) return;
    state.categories.push({ id, label, items: [] });
    const grandTotal = document.querySelector('table.works tbody tr.grand-total');
    grandTotal.insertAdjacentHTML('beforebegin', `<tr class="cat-row" data-cat-id="${id}">
      <td colspan="12">
        <span class="cat-badge">${id}</span> ${label}
        <span style="margin-left:.75rem;font-size:.65rem;font-weight:400;color:var(--slate)">Budget: € 0.00 &nbsp;|&nbsp; Done: € 0.00 &nbsp;|&nbsp; 0%</span>
        <span style="float:right;display:flex;gap:.3rem;margin-top:-.1rem">
          <button class="btn btn-add btn-add-item" data-cat-id="${id}" style="font-size:.62rem;padding:.2rem .55rem">+ Add item</button>
          <button class="btn btn-extra btn-add-item" data-cat-id="${id}" data-extra="true" style="font-size:.62rem;padding:.2rem .55rem">+ Add extra item</button>
          <button class="btn-icon btn-del-cat" data-cat-id="${id}" title="Delete category" style="font-size:.72rem;padding:.2rem .45rem;color:var(--red);border-color:#fca5a5">🗑 Delete</button>
        </span>
      </td>
    </tr>
    <tr class="subtotal">
      <td colspan="5" style="text-align:right;padding-right:.75rem;color:var(--slate);font-weight:400;font-size:.68rem">Category ${id} subtotal</td>
      <td style="text-align:right;font-family:monospace">€ 0.00</td><td></td>
      <td style="text-align:right;font-family:monospace;color:var(--navy)">€ 0.00</td>
      <td colspan="4"></td>
    </tr>`);
  });

</script>
</body>
</html>
